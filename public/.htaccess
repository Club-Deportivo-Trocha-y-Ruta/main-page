# ============================================================
# Cache, Security & Headers — Hostinger (Apache)
# ============================================================
# Configuración equivalente a netlify.toml para Apache.
# Cubre: caché por tipo de archivo, headers de seguridad,
# CSP, HSTS, protección de archivos sensibles, y GZIP.
# ============================================================

# ── Bloquear archivos sensibles ─────────────────────────────
# Impide acceso directo a archivos de configuración, estado
# de deploy, y directorios de control de versiones.

# config.yml del CMS (expone estructura del repo y colecciones)
<Files "config.yml">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Estado de sincronización FTP (expone hashes de archivos)
<Files ".ftp-deploy-sync-state.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Archivos ocultos y de control de versiones (.git, .env, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Desactivar listado de directorios
Options -Indexes

# ── Headers de seguridad ────────────────────────────────────
<IfModule mod_headers.c>

  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HSTS — forzar HTTPS (1 día inicial; subir a 1 año tras verificar)
  Header always set Strict-Transport-Security "max-age=86400; includeSubDomains"

  # Content-Security-Policy
  # - 'unsafe-inline' en script-src: requerido por Astro is:inline scripts
  # - 'unsafe-inline' en style-src: requerido por Tailwind/Astro
  # - unpkg.com: requerido por Sveltia CMS en /admin/
  # - frame-src: Google Maps, YouTube embeds, Strava widget
  Header always set Content-Security-Policy "\
    default-src 'self'; \
    script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.youtube.com https://unpkg.com; \
    style-src 'self' 'unsafe-inline' https://unpkg.com; \
    img-src 'self' https://res.cloudinary.com data:; \
    font-src 'self'; \
    connect-src 'self' https://api.web3forms.com https://static.cloudflareinsights.com https://cloudflareinsights.com; \
    frame-src 'self' https://www.google.com https://www.youtube.com https://www.strava.com; \
    frame-ancestors 'self'; \
    base-uri 'self'; \
    form-action 'self' https://api.web3forms.com; \
    upgrade-insecure-requests"

  # ── Caché por tipo de archivo ─────────────────────────────

  # HTML: nunca cachear (cambios visibles inmediatamente tras deploy)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # JS/CSS: caché largo (Astro genera hashes en el nombre)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fuentes: caché largo (no cambian entre deploys)
  <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes: caché corto con revalidación (sin hash en nombre)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # PDFs y documentos
  <FilesMatch "\.(pdf|doc|docx)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # XML/JSON/manifest: sin caché
  <FilesMatch "\.(xml|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

</IfModule>

# ── Compresión GZIP ───────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── ETags ─────────────────────────────────────────────────
# Desactivar ETags basados en inode para evitar inconsistencias
# entre servidores. La validación se hace por Last-Modified.
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None
