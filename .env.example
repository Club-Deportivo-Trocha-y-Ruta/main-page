PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key
PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Subida de medios a Hostinger (scripts/media-push.sh, `npm run media:push`).
# Son las mismas credenciales FTPS del deploy. Sin comillas salvo que la clave lleve
# espacios; no se interpretan escapes. Nunca se imprimen ni se suben a git (.env está ignorado).
# FTP_SERVER=ftp.tu-dominio.com
# FTP_USERNAME=usuario_ftp
# FTP_PASSWORD=clave_ftp

# Vista previa de /copa-valle-yumbo-2026 con los datos de prueba de
# src/data/valida-yumbo-2026/preview/ (fotos servidas por `npm run valida:preview`).
# Solo local: CI y los deploys nunca la definen, así que el build siempre publica los JSON reales.
# VALIDA_PREVIEW=true
