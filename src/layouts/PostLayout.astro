---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import Badge from '@components/common/Badge.astro';
import ShareButtons from '@components/common/ShareButtons.astro';
import { SITE } from '../lib/constants';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  author?: string;
  image?: string;
  category?: string;
}

const { title, description, date, author, image, category } = Astro.props;

const formattedDate = date
  ? date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const breadcrumbs = [
  { label: 'Noticias', href: '/noticias' },
  { label: title },
];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || SITE.url).href;
const imageUrl = image ? new URL(image, Astro.site || SITE.url).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: description,
  image: imageUrl ? [imageUrl] : undefined,
  datePublished: date ? date.toISOString() : undefined,
  dateModified: date ? date.toISOString() : undefined,
  author: [{
    '@type': 'Organization',
    name: author || SITE.name,
    url: SITE.url
  }],
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/android-chrome-512x512.png', Astro.site || SITE.url).href
    }
  }
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={image}
  jsonLd={jsonLd}
  ogType="article"
  articlePublishedTime={date ? date.toISOString() : undefined}
  articleAuthor={author}
  articleSection={category}
>
  <article class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <Breadcrumb items={breadcrumbs} />

    {image && (
      <div class="mb-8 overflow-hidden rounded-xl">
        <img
          src={image}
          alt={title}
          class="w-full h-64 md:h-96 object-cover"
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    )}

    <header class="mb-8 max-w-3xl mx-auto">
      {category && (
        <div class="mb-3">
          <Badge variant="primary" size="md">{category}</Badge>
        </div>
      )}
      <h1 transition:animate="slide" class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-text-primary leading-tight">
        {title}
      </h1>
      {(formattedDate || author) && (
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-text-secondary">
          {formattedDate && <time datetime={date!.toISOString()}>{formattedDate}</time>}
          {formattedDate && author && <span aria-hidden="true">&middot;</span>}
          {author && <span>{author}</span>}
        </div>
      )}
    </header>

    <div class="prose prose-lg mx-auto max-w-3xl">
      <slot />
    </div>

    <div class="mx-auto max-w-3xl mt-8 pt-6 border-t border-gray-200">
      <ShareButtons title={title} description={description} />
    </div>
  </article>
</BaseLayout>
