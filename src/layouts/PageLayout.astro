---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, ogImage, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    {breadcrumbs && <Breadcrumb items={breadcrumbs} />}
    <div class="mb-8 md:mb-10 text-center">
      <h1 transition:animate="slide" class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-text-primary">
        {title}
      </h1>
      {description && (
        <p class="mt-4 text-lg text-text-secondary max-w-2xl mx-auto">
          {description}
        </p>
      )}
    </div>
    <slot />
  </section>
</BaseLayout>
