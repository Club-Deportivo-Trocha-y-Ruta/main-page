---
import { ClientRouter } from 'astro:transitions';
import SEOHead from '@components/common/SEOHead.astro';
import AnnouncementBar from '@components/common/AnnouncementBar.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import NavigationProgress from '@components/common/NavigationProgress.astro';
import ConversionBar from '@components/common/ConversionBar.astro';
import Analytics from '@components/common/Analytics.astro';
import ConsentBanner from '@components/common/ConsentBanner.astro';
import { getHeroPoster } from '@lib/hero-poster';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  /**
   * Marca la página como `noindex, nofollow`. Lo usa `/equipo`, que existe y se
   * construye pero todavía no es pública: se acompaña de su exclusión del
   * sitemap en `astro.config.mjs`.
   */
  noindex?: boolean;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  articleTags?: string[];
}

const {
  title,
  description,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  jsonLd,
  ogType,
  noindex,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
  articleTags,
} = Astro.props;

// El poster del hero solo existe en la home: preloadearlo en las 27 páginas
// competía con el LCP real del resto del sitio.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const heroPoster = isHome ? await getHeroPoster() : null;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Tema claro/oscuro — va lo primero posible en <head>, antes de cualquier
      CSS o imagen, para evitar el flash de tema equivocado (FOUC): si
      esperara a `DOMContentLoaded` o a un script al final del <body>, la
      página pintaría primero en el tema por defecto (light) y saltaría al
      tema correcto un instante después.

      `astro:after-swap` es obligatorio, no una mejora: con `ClientRouter`
      (View Transitions), `swapRootAttributes()` de Astro copia los atributos
      del `<html>` de la página ENTRANTE sobre el de la página actual en cada
      navegación —incluido `data-theme`, que la entrante nunca trae porque
      este mismo script todavía no corrió ahí— y lo borra
      (node_modules/astro/dist/transitions/swap-functions.js). Sin este
      listener, cada navegación interna dejaría el sitio en el tema por
      defecto del navegador aunque hubiera una preferencia guardada.

      El toggle no lleva script propio: se detecta por delegación de clic en
      `document`, igual que `Analytics.astro` con sus `data-analytics-*`. Así
      el botón funciona también dentro del portal donde `MobileMenu` monta el
      drawer, y ningún componente nuevo necesita montar su propio elemento
      de script.

      ES5 a propósito (var/function, sin arrow functions ni template
      literals) y con try/catch alrededor de `localStorage`: mismo criterio
      que `ConsentBanner.astro`, que puede fallar en navegación privada o con
      almacenamiento bloqueado. Sin `define:vars`: Astro 7 reescribe los
      scripts que lo usan y les quita atributos como `src`/`async` (ver la
      nota de `Analytics.astro` en CLAUDE.md); este script no los necesita,
      pero se mantiene la misma convención en todo el sitio.
    -->
    <script is:inline>
      (function () {
        var KEY = 'trocha-theme';
        var mq = window.matchMedia('(prefers-color-scheme: dark)');

        function stored() {
          try {
            var value = localStorage.getItem(KEY);
            return value === 'light' || value === 'dark' ? value : null;
          } catch (_e) {
            return null;
          }
        }

        function system() {
          return mq.matches ? 'dark' : 'light';
        }

        function resolve() {
          return stored() || system();
        }

        function forget() {
          try {
            localStorage.removeItem(KEY);
          } catch (_e) {
            // Sin almacenamiento no hay nada que olvidar.
          }
        }

        // `forced` solo lo usa `set()`; los listeners de eventos llaman a
        // `apply` con un `Event`, que se ignora.
        function apply(forced) {
          // Regla de convergencia (theme-ux-spec.md, decisión A): la clave solo
          // existe mientras sea un override real. Si lo guardado coincide con
          // lo que ya pide el sistema, se borra y el sitio vuelve a seguir al
          // dispositivo sin un tercer estado "Sistema" en el botón.
          if (stored() && stored() === system()) forget();
          var theme = forced === 'light' || forced === 'dark' ? forced : resolve();
          document.documentElement.setAttribute('data-theme', theme);

          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute('content', theme === 'dark' ? '#1c1e20' : '#20b7c9');
          }

          var toggles = document.querySelectorAll('[data-theme-toggle]');
          for (var i = 0; i < toggles.length; i++) {
            toggles[i].setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
          }
        }

        function set(value) {
          if (value === null || value === system()) {
            // `null` (tests/otros scripts) y "lo mismo que el sistema" son el
            // mismo caso: no hay override que guardar.
            forget();
          } else {
            try {
              localStorage.setItem(KEY, value);
            } catch (_e) {
              // localStorage bloqueado (navegación privada, política del
              // dispositivo): el tema sigue funcionando para esta carga, solo
              // no persiste entre visitas.
            }
          }
          // Sin almacenamiento, `resolve()` volvería al sistema y el clic no
          // haría nada visible: se pinta el valor pedido de forma explícita.
          apply(value);
        }

        // Pinta el tema antes del primer paint.
        apply();

        // El sistema cambia de tema mientras la pestaña está abierta (p. ej.
        // el dispositivo pasa a modo noche). `apply()` ya decide: sin override
        // sigue al sistema; con override que lo contradiga, lo conserva; con
        // override que ahora coincide, lo olvida.
        mq.addEventListener('change', function () {
          apply();
        });

        // El primer `apply()` corre en <head>, cuando el <button> de la
        // cabecera todavía no existe: `aria-pressed` se sincroniza en cuanto
        // hay DOM, sin esperar a `load` (que es cuando Astro dispara
        // `astro:page-load` y puede llegar tarde en 4G con imágenes a medias).
        document.addEventListener('DOMContentLoaded', apply);
        // Ver nota de arriba: obligatorio con ClientRouter.
        document.addEventListener('astro:after-swap', apply);
        // Sincroniza `aria-pressed` de toggles montados después del primer
        // paint (p. ej. el que vive dentro del drawer de MobileMenu).
        document.addEventListener('astro:page-load', apply);

        document.addEventListener('click', function (e) {
          var toggle = e.target && e.target.closest && e.target.closest('[data-theme-toggle]');
          if (!toggle) return;
          set(resolve() === 'dark' ? 'light' : 'dark');
        });

        window.__trochaTheme = { get: resolve, set: set };
      })();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Font preloading — se mantienen los dos porque ambas familias pintan
         texto por encima del pliegue en todas las páginas: Inter en la
         navegación del header y el cuerpo, Plus Jakarta Sans en el `h1`, que
         es el candidato a LCP en todo el sitio salvo la home (donde lo es el
         póster del hero). Tras el subsetting los dos juntos pesan ~160 KB,
         menos de la mitad de lo que pesaba Inter sola sin subsetear. -->
    <link
      rel="preload"
      href="/fonts/InterVariable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/PlusJakartaSans-Variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Hero poster preload (LCP candidate on homepage).
         `imagesizes` tiene que ser idéntico al `sizes` del <img> en
         Hero.astro: el poster ya no es un fondo a pantalla completa, vive en
         una columna de ~5/12 desde lg. -->
    {
      heroPoster && (
        <link
          rel="preload"
          as="image"
          href={heroPoster.src}
          imagesrcset={heroPoster.srcSet.attribute || undefined}
          imagesizes="(min-width: 1024px) 30rem, 100vw"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }
    <!-- Preconnect / DNS prefetch -->
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="dns-prefetch" href="https://api.web3forms.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <!-- Theme color -->
    <meta name="theme-color" content="#20b7c9" />
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      jsonLd={jsonLd}
      ogType={ogType}
      noindex={noindex}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
      articleAuthor={articleAuthor}
      articleSection={articleSection}
      articleTags={articleTags}
    />
    <ClientRouter />
  </head>
  <body class="bg-surface text-text-primary flex min-h-screen flex-col font-sans antialiased">
    <NavigationProgress />
    <a
      href="#main-content"
      class="focus:bg-primary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:p-4 focus:text-white focus:shadow-lg"
    >
      Saltar al contenido principal
    </a>
    <AnnouncementBar />
    <Header transition:persist />
    <!--
      `data-pagefind-body` acota el índice del buscador al contenido de la
      página: en cuanto existe una sola marca, Pagefind indexa únicamente lo
      marcado, así que cabecera, cinta de anuncio y pie —idénticos en las 146
      páginas— dejan de aparecer en cada resultado.
    -->
    <!--
      Una página `noindex` tampoco entra al buscador del sitio: sería la vía por
      la que una página oculta —hoy `/equipo`— reaparecería en la cabecera.
      Mismo recurso que ya usa `LinktreeLayout` para `/enlaces`.
    -->
    <!--
      El nombre de la transición del cuerpo va escrito, no autogenerado. Con
      solo `transition:animate`, Astro nombra el grupo con el número de orden en
      que se renderiza (`astro-{hash}-{n}`), y ese número cuenta *todos* los
      elementos con directiva `transition:*` de la página, así que basta una
      directiva de más para que `main` se llame distinto en esa ruta. Dos
      nombres distintos no emparejan: el fundido deja de ser una sola transición
      y pasa a ser dos grupos sueltos. `/politica-de-tratamiento-de-datos`, que
      monta un `<h1>` con `transition:animate`, ya sacaba otro número. Con el
      nombre escrito el emparejamiento no depende del orden; por eso las
      tarjetas de los listados pueden declarar su `view-transition-name` como
      propiedad CSS en línea, sin directiva, sin afectar a nadie al mover el
      contador.
    -->
    <main
      id="main-content"
      class="flex-1"
      transition:animate="fade"
      transition:name="page-main"
      data-pagefind-body={noindex ? undefined : true}
      data-pagefind-ignore={noindex ? 'all' : undefined}
    >
      <slot />
    </main>
    <Footer />
    <ConversionBar />
    <!-- Scroll-reveal observer (compatible with View Transitions) -->
    <!-- Header height tracker: sets --header-h so sticky sub-navs (e.g. TrochaVerdeNav)
         can use top-[var(--header-h)] regardless of whether AnnouncementBar is visible. -->
    <script is:inline>
      function syncHeaderHeight() {
        var h = document.querySelector('header');
        if (!h) return;
        // The header is `sticky top-0`; the AnnouncementBar above it is `relative`
        // and scrolls away. Once the page is scrolled, the header pins at the top of
        // the viewport occupying only its own height, so sticky sub-navs must offset
        // by that height — not by header.bottom (which, at scroll 0, also includes
        // the still-visible AnnouncementBar and would leave a gap below the header).
        var height = h.getBoundingClientRect().height;
        document.documentElement.style.setProperty('--header-h', height + 'px');
      }
      syncHeaderHeight();
      window.addEventListener('resize', syncHeaderHeight, { passive: true });
      document.addEventListener('astro:page-load', syncHeaderHeight);

      // Re-sync when AnnouncementBar is dismissed (bar.remove() fires no event,
      // so we piggyback on the close button click via event delegation).
      document.addEventListener(
        'click',
        function (e) {
          if (e.target && e.target.closest('#close-announcement')) {
            // rAF ensures the element is removed before we measure
            requestAnimationFrame(syncHeaderHeight);
          }
        },
        { capture: true },
      );

      function initReveal() {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('revealed');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1 },
          );
          document.querySelectorAll('.reveal:not(.revealed)').forEach(function (el) {
            observer.observe(el);
          });
        } else {
          document.querySelectorAll('.reveal').forEach(function (el) {
            el.classList.add('revealed');
          });
        }
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
    <Analytics />
    <ConsentBanner />
  </body>
</html>
