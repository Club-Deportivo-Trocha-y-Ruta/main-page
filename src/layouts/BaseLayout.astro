---
import { ClientRouter } from 'astro:transitions';
import SEOHead from '@components/common/SEOHead.astro';
import AnnouncementBar from '@components/common/AnnouncementBar.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import NavigationProgress from '@components/common/NavigationProgress.astro';
import WhatsAppButton from '@components/common/WhatsAppButton.astro';
import Analytics from '@components/common/Analytics.astro';
import ConsentBanner from '@components/common/ConsentBanner.astro';
import { getHeroPoster } from '@lib/hero-poster';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  articleTags?: string[];
}

const { title, description, ogImage, ogImageWidth, ogImageHeight, jsonLd, ogType, articlePublishedTime, articleModifiedTime, articleAuthor, articleSection, articleTags } = Astro.props;

// El poster del hero solo existe en la home: preloadearlo en las 27 páginas
// competía con el LCP real del resto del sitio.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const heroPoster = isHome ? await getHeroPoster() : null;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Font preloading -->
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PlusJakartaSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Hero poster preload (LCP candidate on homepage) -->
    {heroPoster && (
      <link
        rel="preload"
        as="image"
        href={heroPoster.src}
        imagesrcset={heroPoster.srcSet.attribute || undefined}
        imagesizes="100vw"
        type="image/webp"
        fetchpriority="high"
      />
    )}
    <!-- Preconnect / DNS prefetch -->
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="dns-prefetch" href="https://api.web3forms.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <!-- Theme color -->
    <meta name="theme-color" content="#20b7c9" />
    <SEOHead title={title} description={description} ogImage={ogImage} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} jsonLd={jsonLd} ogType={ogType} articlePublishedTime={articlePublishedTime} articleModifiedTime={articleModifiedTime} articleAuthor={articleAuthor} articleSection={articleSection} articleTags={articleTags} />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-surface text-text-primary font-sans antialiased">
    <NavigationProgress />
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:p-4 focus:bg-primary focus:text-white focus:shadow-lg"
    >
      Saltar al contenido principal
    </a>
    <AnnouncementBar />
    <Header transition:persist />
    <main id="main-content" class="flex-1" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <!-- Scroll-reveal observer (compatible with View Transitions) -->
    <!-- Header height tracker: sets --header-h so sticky sub-navs (e.g. TrochaVerdeNav)
         can use top-[var(--header-h)] regardless of whether AnnouncementBar is visible. -->
    <script is:inline>
      function syncHeaderHeight() {
        var h = document.querySelector('header');
        if (!h) return;
        // The header is `sticky top-0`; the AnnouncementBar above it is `relative`
        // and scrolls away. Once the page is scrolled, the header pins at the top of
        // the viewport occupying only its own height, so sticky sub-navs must offset
        // by that height — not by header.bottom (which, at scroll 0, also includes
        // the still-visible AnnouncementBar and would leave a gap below the header).
        var height = h.getBoundingClientRect().height;
        document.documentElement.style.setProperty('--header-h', height + 'px');
      }
      syncHeaderHeight();
      window.addEventListener('resize', syncHeaderHeight, { passive: true });
      document.addEventListener('astro:page-load', syncHeaderHeight);

      // Re-sync when AnnouncementBar is dismissed (bar.remove() fires no event,
      // so we piggyback on the close button click via event delegation).
      document.addEventListener('click', function(e) {
        if (e.target && e.target.closest('#close-announcement')) {
          // rAF ensures the element is removed before we measure
          requestAnimationFrame(syncHeaderHeight);
        }
      }, { capture: true });

      function initReveal() {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1 });
          document.querySelectorAll('.reveal:not(.revealed)').forEach(function(el) { observer.observe(el); });
        } else {
          document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('revealed'); });
        }
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
    <Analytics />
    <ConsentBanner />
  </body>
</html>
