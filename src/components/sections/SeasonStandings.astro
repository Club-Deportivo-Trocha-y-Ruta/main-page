---
/**
 * Tablero de la temporada: la general del club, contada como barras.
 *
 * El club ya contaba esto dentro de una crónica, con las clases
 * `.standings-board` de `global.css` y los puntos escritos a mano en el
 * markdown. Esta sección habla el mismo idioma visual —barra acumulada, tramo
 * claro de la última válida, línea punteada del podio, zona rayada de lo que
 * queda en juego— pero todo sale de `summarizeStandings()` (`@lib/results`).
 *
 * Reglas que sostiene:
 * - **Sin resultados no se pinta nada.** No hay tablero "próximamente".
 * - **La pista es decorativa** (`aria-hidden`): cada dato está en texto —el
 *   total, lo que sumó y el movimiento— para quien no ve las barras.
 * - **El movimiento nunca es solo color**: flecha + verbo, como `MOVEMENT_LABELS`.
 * - Cero JavaScript: las barras son ancho calculado en CSS desde las custom
 *   properties de cada fila.
 *
 * Los estilos van en el `<style>` de este componente y no reutilizan las clases
 * `.standings-board` de `global.css`: aquellas están acotadas a `.prose` (el
 * cuerpo de una crónica) y tocarlas cambiaría lo ya publicado.
 */
import { Icon } from 'astro-icon/components';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import { slugify, formatDate } from '@lib/utils';
import {
  summarizeStandings,
  movementLabel,
  MOVEMENT_LABELS,
  type ResultEntry,
  type SeasonEventInput,
} from '@lib/results';
import type { SectionTone } from '@lib/editorial';

interface Props {
  /** Colección `results` completa. */
  results: ResultEntry[];
  /** Colección `events`: dice cuántas válidas tiene el año y cuántas faltan. */
  events?: SeasonEventInput[];
  tone?: SectionTone;
  class?: string;
}

const { results, events = [], tone = 'tinted', class: className } = Astro.props;

const summary = summarizeStandings(results, { events });
const standings = summary?.standings;

// El titular nombra la serie cuando los eventos permiten derivarla; si no, la
// sección habla de "la temporada" en vez de afirmar una copa que no consta.
const title = summary?.series ? `Así va la ${summary.series}` : 'Así va la temporada';
const highlight = summary?.series ?? 'la temporada';

// La bajada explica las tres marcas de la pista con las cifras reales. La
// última frase solo existe mientras queden válidas por correr.
const lead = summary
  ? [
      `Cada barra es lo que lleva sumado el corredor en la temporada y el tramo claro, lo que sumó en ${summary.latest?.name ?? 'la última válida'}.`,
      'La línea punteada marca los puntos del tercero de su categoría: la zona de podio queda a la izquierda de esa línea.',
      summary.remaining > 0
        ? `La zona rayada son los ${summary.standings.reach} puntos que siguen en juego en ${summary.remaining === 1 ? 'la válida que falta' : `las ${summary.remaining} válidas que faltan`}.`
        : 'Ya no queda zona rayada: la temporada está corrida.',
    ].join(' ')
  : '';
---

{summary && standings && (
  <SectionShell
    tone={tone}
    width="wide"
    labelledby="tablero-titulo"
    class={className}
  >
    <SectionIntro
      id="tablero-titulo"
      eyebrow={`Temporada ${summary.year}`}
      eyebrowIcon="ph:ranking-bold"
      title={title}
      highlight={highlight}
      lead={lead}
      tone={tone}
      class="max-w-3xl"
    />

    <div class="mt-10 space-y-12">
      {standings.categories.map((group) => {
        const headingId = `tablero-${slugify(group.category)}`;
        return (
          <section aria-labelledby={headingId}>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 id={headingId} class="font-display text-lg font-bold text-text-primary">
                {group.category}
              </h3>
              <p class="text-sm text-text-secondary">
                {group.riders.length}{' '}
                {group.riders.length === 1 ? 'corredor' : 'corredores'}
                {group.podiumPoints !== null && (
                  <> · podio en {group.podiumPoints} puntos</>
                )}
              </p>
            </div>

            <ol
              class="board"
              style={`--board-max:${standings.boardMax}; --reach:${standings.reach}`}
            >
              {group.riders.map((rider) => (
                <li
                  class:list={['board__row', rider.inPodium && 'board__row--podium']}
                  style={[
                    `--pts:${rider.total}`,
                    `--pts-prev:${rider.previousTotal}`,
                    group.podiumPoints !== null ? `--podio:${group.podiumPoints}` : '',
                  ]
                    .filter(Boolean)
                    .join('; ')}
                >
                  <span class="board__label">
                    <span class="board__name">{rider.riderName}</span>
                    <span class="board__meta">
                      {rider.category} · {rider.position}.º
                    </span>
                    <span
                      class:list={['board__move', `board__move--${rider.movement.direction}`]}
                    >
                      <span aria-hidden="true">
                        {MOVEMENT_LABELS[rider.movement.direction].glyph}
                      </span>{' '}
                      {movementLabel(rider.movement)}
                    </span>
                  </span>

                  <span class="board__track" aria-hidden="true">
                    {standings.reach > 0 && <span class="board__reach"></span>}
                    <span class="board__bar">
                      {/* Sin puntos nuevos la barra es sólida: el tramo claro
                          solo aparece cuando hubo algo que sumar. */}
                      {rider.lastGain > 0 && <span class="board__gain"></span>}
                    </span>
                    {group.podiumPoints !== null && <span class="board__podium"></span>}
                  </span>

                  <span class="board__total">
                    <span class="board__total-value">
                      {rider.total}<span class="sr-only"> puntos</span>
                    </span>
                    {rider.lastGain > 0 && (
                      <span class="board__total-gain">+{rider.lastGain} en esta</span>
                    )}
                  </span>
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </div>

    <p class="board__legend">
      <span><span class="board__key"></span> acumulado</span>
      <span><span class="board__key board__key--gain"></span> sumó en esta válida</span>
      <span><span class="board__key board__key--podium"></span> en zona de podio</span>
      {standings.reach > 0 && (
        <span><span class="board__key board__key--reach"></span> en juego</span>
      )}
      <span><span class="board__key board__key--line"></span> línea de podio</span>
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2">
      <a
        href="/calendario"
        class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-deep px-5 py-2.5 font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white"
      >
        <Icon name="ph:calendar-dots-bold" class="size-4" aria-hidden="true" />
        Ver el calendario de la temporada
      </a>
      {summary.latest && (
        <p class="text-sm text-text-secondary">
          Actualizado con {summary.latest.name}, {formatDate(summary.latest.date)}.
        </p>
      )}
    </div>
  </SectionShell>
)}

<style>
  /* Tablero: la tabla de puntos contada como barras. Cada fila declara sus
     números en custom properties y el CSS calcula el ancho — ninguna plantilla
     escribe porcentajes.
       --pts        puntos acumulados del corredor
       --pts-prev   puntos que traía antes de la última válida
       --podio      puntos del 3.º de su categoría (la línea a alcanzar)
       --board-max  escala del tablero (en .board)
       --reach      puntos todavía en juego (en .board)
     La pista es decorativa: todo el dato va en texto dentro de __label. */
  .board {
    list-style: none;
    margin-block: 1rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .board__row {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.375rem 1rem;
    grid-template-columns: 1fr auto;
  }
  .board__label {
    grid-column: 1 / -1;
  }
  @media (min-width: 640px) {
    .board__row {
      grid-template-columns: minmax(9rem, 15rem) 1fr auto;
      align-items: center;
    }
    .board__label {
      grid-column: auto;
    }
  }
  .board__label {
    display: block;
    line-height: 1.3;
  }
  .board__name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
  }
  .board__meta {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }
  .board__row--podium .board__meta {
    color: var(--color-accent-deep);
    font-weight: 600;
  }

  /* Pista: zona alcanzable (puntos actuales + los que quedan en juego), barra
     de puntos acumulados y marca del podio de la categoría. */
  .board__track {
    position: relative;
    display: block;
    height: 1.75rem;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--color-surface-muted) 35%, var(--color-surface));
  }
  .board__reach {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(min(var(--pts) + var(--reach), var(--board-max)) / var(--board-max) * 100%);
    border-radius: 0.375rem;
    background: repeating-linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 16%, var(--color-surface)) 0 6px,
      color-mix(in srgb, var(--color-primary) 7%, var(--color-surface)) 6px 12px
    );
  }
  .board__bar {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(var(--pts) / var(--board-max) * 100%);
    min-width: 0.5rem;
    border-radius: 0.375rem;
    background: var(--color-primary-deep);
    overflow: hidden;
  }
  .board__row--podium .board__bar {
    background: var(--color-accent-deep);
  }
  /* Lo que sumó en ESTA válida: tramo final de la barra en tono claro, con un
     filo blanco que marca dónde estaba antes. Con --pts-prev igual a --pts el
     tramo mide cero y la barra se ve sólida, como en la primera válida. */
  .board__gain {
    position: absolute;
    inset-block: 0;
    right: 0;
    left: calc(var(--pts-prev, var(--pts)) / max(var(--pts), 1) * 100%);
    background: var(--color-primary);
    border-left: 2px solid var(--color-surface);
  }
  .board__row--podium .board__gain {
    background: var(--color-accent-dark);
  }
  /* Marca del podio: línea vertical sobre la pista. */
  .board__podium {
    position: absolute;
    inset-block: -0.1875rem;
    left: calc(var(--podio) / var(--board-max) * 100%);
    width: 0;
    border-left: 2px dashed var(--color-text-primary);
  }
  /* Total: fuera de la barra, para que ningún número quede sobre el tramo
     claro y pierda contraste. */
  .board__total {
    display: block;
    min-width: 3.25rem;
    text-align: right;
    line-height: 1.15;
  }
  .board__total-value {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
    color: var(--color-primary-deep);
  }
  .board__row--podium .board__total-value {
    color: var(--color-accent-deep);
  }
  .board__total-gain {
    display: block;
    margin-top: 0.0625rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  /* Movimiento: cómo se movió respecto de la válida anterior. Nunca solo por
     color — la flecha da la forma y el texto dice el verbo, así funciona en
     escala de grises y con lector de pantalla. */
  .board__move {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    margin-top: 0.25rem;
    padding: 0.0625rem 0.4375rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    /* Estado neutro por defecto: "mantiene". */
    background: color-mix(in srgb, var(--color-surface-muted) 32%, var(--color-surface));
    color: var(--color-text-secondary);
  }
  .board__move--up {
    background: color-mix(in srgb, var(--color-accent) 16%, var(--color-surface));
    color: var(--color-accent-deep);
  }
  /* Rojo y azul de estado: viven aquí y no en @theme porque solo los usa este
     tablero. Contraste sobre blanco: 6,2:1 y 6,3:1 — cumplen WCAG AA. */
  .board__move--down {
    background: color-mix(in srgb, #b42318 10%, var(--color-surface));
    color: #b42318;
  }
  .board__move--new {
    background: color-mix(in srgb, #1d4ed8 10%, var(--color-surface));
    color: #1d4ed8;
  }

  .board__legend {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }
  .board__legend > * {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .board__key {
    display: inline-block;
    width: 1.25rem;
    height: 0.75rem;
    border-radius: 0.1875rem;
    background: var(--color-primary-deep);
  }
  .board__key--podium {
    background: var(--color-accent-deep);
  }
  .board__key--gain {
    background: var(--color-primary);
    border-left: 2px solid var(--color-surface);
    box-shadow: inset 2px 0 0 var(--color-primary-deep);
  }
  .board__key--reach {
    background: repeating-linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 16%, var(--color-surface)) 0 4px,
      color-mix(in srgb, var(--color-primary) 7%, var(--color-surface)) 4px 8px
    );
    border: 1px solid var(--color-surface-muted);
  }
  .board__key--line {
    width: 0;
    height: 0.9375rem;
    border-left: 2px dashed var(--color-text-primary);
    border-radius: 0;
  }
</style>
