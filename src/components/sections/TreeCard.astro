---
/**
 * Tarjeta de un árbol dentro de la rejilla de su especie.
 *
 * Un solo enlace por tarjeta (la etiqueta, con `after:absolute after:inset-0`
 * para que toda la tarjeta sea clicable) — no el doble enlace imagen+"Ver
 * ficha" de la rejilla anterior. Mismo patrón que `NewsCard.astro`.
 */
import { Icon } from 'astro-icon/components';
import { formatDate } from '@lib/utils';
import { statusLabels, statusColors } from '@lib/tree-utils';

interface Props {
  /** id del árbol: arma la URL `/trocha-verde/arboles/{id}`. */
  id: string;
  /** Nombre a mostrar, ya resuelto (p. ej. "Mango 3" o "Ceiba"). */
  label: string;
  image: string;
  imageAlt: string;
  plantedDate: Date;
  status: string;
  donor?: string;
  class?: string;
}

const { id, label, image, imageAlt, plantedDate, status, donor, class: className } = Astro.props;

// "Sembrado" es el estado por defecto de 75 de los 77 árboles: rotularlo en
// cada tarjeta sería ruido que el contexto ya explica. Solo se marca la
// excepción real (hoy, "Creciendo" en 2 árboles).
const showStatus = status !== 'sembrado';
const statusStyle = statusColors[status] ?? statusColors.sembrado;
const statusLabel = statusLabels[status] ?? status;
---

<article
  class:list={[
    'group relative overflow-hidden rounded-2xl bg-surface shadow-sm ring-1 ring-black/5',
    'transition duration-300 hover:-translate-y-1 hover:shadow-lg',
    className,
  ]}
>
  <div class="relative aspect-square overflow-hidden bg-surface-muted">
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
      class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {showStatus && (
      <span
        class:list={[
          'absolute left-3 top-3 inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold',
          statusStyle.bg,
          statusStyle.text,
        ]}
      >
        {statusLabel}
      </span>
    )}
  </div>

  <div class="p-4">
    <h3 class="font-display text-base font-bold leading-snug text-text-primary">
      <a href={`/trocha-verde/arboles/${id}`} class="after:absolute after:inset-0 group-hover:text-primary-deep">
        {label}
      </a>
    </h3>

    <time datetime={plantedDate.toISOString().split('T')[0]} class="mt-1.5 block text-xs text-text-secondary">
      Sembrado el {formatDate(plantedDate)}
    </time>

    {donor && (
      <p class="mt-1 flex items-center gap-1 truncate text-xs text-text-secondary" title={donor}>
        <Icon name="ph:heart-bold" class="size-3 shrink-0 text-accent-deep" aria-hidden="true" />
        <span class="truncate">{donor}</span>
      </p>
    )}
  </div>
</article>
