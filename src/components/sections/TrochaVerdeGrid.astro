---
import { formatDate } from '@lib/utils';

interface TreeItem {
  id: string;
  species: string;
  scientificName?: string;
  category: string;
  status: string;
  plantedDate: Date;
  donor?: string;
  image: string;
  imageAlt: string;
  protector: string;
  protectorColor?: string;
  notes?: string;
}

interface Props {
  trees: TreeItem[];
}

const { trees } = Astro.props;

const categoryLabels: Record<string, string> = {
  frutal: 'Frutal',
  ornamental: 'Ornamental',
  nativo: 'Nativo',
  maderable: 'Maderable',
};

const categoryColors: Record<string, { bg: string; text: string }> = {
  frutal: { bg: 'bg-amber-100', text: 'text-amber-700' },
  ornamental: { bg: 'bg-purple-100', text: 'text-purple-900' },
  nativo: { bg: 'bg-emerald-100', text: 'text-emerald-700' },
  maderable: { bg: 'bg-orange-100', text: 'text-orange-700' },
};

const statusLabels: Record<string, string> = {
  sembrado: 'Sembrado',
  creciendo: 'Creciendo',
  floreciendo: 'Floreciendo',
};

const statusColors: Record<string, { bg: string; text: string }> = {
  sembrado: { bg: 'bg-sky-100', text: 'text-sky-700' },
  creciendo: { bg: 'bg-emerald-100', text: 'text-emerald-700' },
  floreciendo: { bg: 'bg-pink-100', text: 'text-pink-700' },
};
---

<div id="trocha-verde-grid-wrapper">
  <!-- Filtros -->
  <noscript>
    <style>
      #trocha-verde-filters { display: none; }
    </style>
  </noscript>

  <div id="trocha-verde-filters" class="mb-6 flex flex-wrap items-center gap-3">
    <!-- Filtro por categoría -->
    <div class="flex items-center gap-2">
      <label for="filter-category" class="text-sm font-medium text-text-secondary">
        Tipo:
      </label>
      <select
        id="filter-category"
        data-filter="category"
        class="rounded-lg border border-surface-muted bg-white px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600"
      >
        <option value="">Todas</option>
        <option value="frutal">Frutal</option>
        <option value="ornamental">Ornamental</option>
        <option value="nativo">Nativo</option>
        <option value="maderable">Maderable</option>
      </select>
    </div>

    <!-- Filtro por estado -->
    <div class="flex items-center gap-2">
      <label for="filter-status" class="text-sm font-medium text-text-secondary">
        Estado:
      </label>
      <select
        id="filter-status"
        data-filter="status"
        class="rounded-lg border border-surface-muted bg-white px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600"
      >
        <option value="">Todos</option>
        <option value="sembrado">Sembrado</option>
        <option value="creciendo">Creciendo</option>
        <option value="floreciendo">Floreciendo</option>
      </select>
    </div>

    <!-- Contador de resultados -->
    <p
      class="ml-auto text-sm text-text-secondary"
      data-results-count
      aria-live="polite"
      aria-atomic="true"
    >
      {trees.length} {trees.length === 1 ? 'árbol' : 'árboles'}
    </p>
  </div>

  <!-- Grid de tarjetas -->
  <div
    id="trees-grid"
    class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
    role="list"
    aria-label="Inventario de árboles sembrados"
  >
    {trees.map((tree) => {
      const catColors = categoryColors[tree.category] ?? categoryColors.nativo;
      const stColors = statusColors[tree.status] ?? statusColors.sembrado;
      const catLabel = categoryLabels[tree.category] ?? tree.category;
      const stLabel = statusLabels[tree.status] ?? tree.status;
      const treeNumber = tree.id.match(/-(\d+)$/)?.[1];
      const displayName = treeNumber ? `${tree.species} #${treeNumber}` : tree.species;

      return (
        <article
          class="overflow-hidden rounded-xl border border-emerald-100 bg-white transition-shadow hover:shadow-md"
          data-category={tree.category}
          data-status={tree.status}
          data-species={tree.species.toLowerCase()}
          role="listitem"
        >
          <a
            href={`/trocha-verde/arboles/${tree.id}`}
            class="block focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
            aria-label={`Ver ficha de ${displayName}`}
          >
            <div class="aspect-[4/3] overflow-hidden bg-surface-muted">
              <img
                src={tree.image}
                alt={tree.imageAlt}
                class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                loading="lazy"
                width="400"
                height="300"
              />
            </div>
          </a>

          <div class="p-4">
            <!-- Badges: estado + categoría -->
            <div class="mb-2 flex flex-wrap items-center gap-2" aria-label="Etiquetas">
              <span
                class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${stColors.bg} ${stColors.text}`}
              >
                {stLabel}
              </span>
              <span
                class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${catColors.bg} ${catColors.text}`}
              >
                {catLabel}
              </span>
            </div>

            <!-- Nombre de especie (con número si hay múltiples del mismo tipo) -->
            <h3 class="font-display text-lg font-bold text-text-primary leading-snug">
              {displayName}
            </h3>
            {tree.scientificName && (
              <p class="text-sm italic text-text-secondary">{tree.scientificName}</p>
            )}

            <!-- Donante -->
            {tree.donor && (
              <p class="mt-2 text-sm text-text-secondary">
                <span class="font-medium text-text-primary">Donado por:</span> {tree.donor}
              </p>
            )}

            <!-- Fecha de siembra -->
            <p class="mt-2 text-xs text-text-secondary">
              <time datetime={tree.plantedDate.toISOString().split('T')[0]}>
                Sembrado el {formatDate(tree.plantedDate)}
              </time>
            </p>

            <!-- Enlace a ficha individual -->
            <a
              href={`/trocha-verde/arboles/${tree.id}`}
              class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-emerald-600 hover:text-emerald-700 focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
              aria-label={`Ver ficha completa de ${displayName}`}
            >
              Ver ficha
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Mensaje sin resultados (oculto por defecto) -->
  <p
    class="hidden py-12 text-center text-text-secondary"
    data-no-results
    role="status"
    aria-live="polite"
  >
    No hay árboles que coincidan con los filtros seleccionados.
  </p>
</div>

<script>
  function initTreeFilters() {
    const selects = document.querySelectorAll<HTMLSelectElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('#trees-grid article');
    const noResults = document.querySelector<HTMLElement>('[data-no-results]');
    const resultsCount = document.querySelector<HTMLElement>('[data-results-count]');

    if (!selects.length || !cards.length) return;

    function applyFilters(): void {
      const filters: Record<string, string> = {};
      selects.forEach((sel) => {
        const key = sel.dataset.filter;
        if (key) filters[key] = sel.value;
      });

      let visible = 0;
      cards.forEach((card) => {
        const matches = Object.entries(filters).every(([key, val]) => {
          if (!val) return true;
          return card.dataset[key] === val;
        });
        card.style.display = matches ? '' : 'none';
        if (matches) visible++;
      });

      if (noResults) noResults.classList.toggle('hidden', visible > 0);
      if (resultsCount) {
        resultsCount.textContent = `${visible} ${visible === 1 ? 'árbol' : 'árboles'}`;
      }
    }

    selects.forEach((sel) => sel.addEventListener('change', applyFilters));
  }

  // Inicializar en carga normal y tras View Transitions
  initTreeFilters();
  document.addEventListener('astro:page-load', initTreeFilters);
</script>
