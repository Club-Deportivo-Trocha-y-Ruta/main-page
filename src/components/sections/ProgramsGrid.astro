---
/**
 * Sección de programas en la portada.
 *
 * Cuenta los tres programas como lo que son —tramos de una misma ruta— en vez
 * de tres tarjetas equivalentes: primero el perfil de edades, después cada
 * etapa con su promesa y sus datos duros. Todo el texto sale del contenido.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import ProgramPathway from '@components/sections/ProgramPathway.astro';
import { getRefreshImage } from '@lib/refresh-images';
import { buildPathway, countWeeklySessions, getLevelStyle, toPathwayInput } from '@lib/programs';

type Program = CollectionEntry<'programs'>;

const programs = (await getCollection('programs'))
  .filter((p: Program) => !p.data.draft)
  .sort((a: Program, b: Program) => a.data.order - b.data.order);

const pathwayInput = programs.map(toPathwayInput);

// La numeración de las tarjetas sale de la ruta, no del campo `order`: así el
// "02" de una tarjeta siempre es el mismo "02" que se ve en el perfil.
const stepById = new Map(buildPathway(pathwayInput).stages.map((stage) => [stage.id, stage.step]));

const cards = programs.map((program: Program) => ({
  program,
  level: getLevelStyle(program.data.targetLevel),
  step: stepById.get(program.id) ?? 0,
  photo: getRefreshImage(program.data.image),
  sessions: countWeeklySessions(program.data.schedule),
}));
---

<!-- `scrollDriven`: el perfil de `ProgramPathway` se traza al hacer scroll y
     `overflow-hidden` le anclaría la línea de tiempo a esta sección -->
<SectionShell tone="muted" pattern="topo" width="wide" labelledby="programas-heading" scrollDriven>
  <SectionIntro
    id="programas-heading"
    eyebrow="Programas"
    eyebrowIcon="ph:path-bold"
    title="Del primer equilibrio al primer podio"
    highlight="primer podio"
    lead="Tres etapas de una misma ruta. Cada programa recoge al niño donde está —sea que apenas suelte las rueditas o que ya sueñe con la Copa Valle— y lo acompaña hasta el siguiente tramo."
    align="center"
    class="mx-auto max-w-3xl"
  />

  <ProgramPathway programs={pathwayInput} class="mt-10" />

  <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
    {cards.map(({ program, level, step, photo, sessions }, index) => (
      <article
        class="reveal group relative flex flex-col overflow-hidden rounded-2xl bg-surface shadow-sm ring-1 ring-black/5 transition duration-300 hover:-translate-y-1 hover:shadow-lg"
        style={`--stagger:${index * 90}ms`}
      >
        <div class="relative aspect-[16/10] overflow-hidden bg-surface-muted">
          {photo ? (
            <Image
              src={photo}
              alt={`Niños del programa ${program.data.title} del Club Trocha y Ruta`}
              layout="none"
              widths={[400, 600, 800]}
              sizes="(min-width: 768px) 33vw, 100vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          ) : (
            <span class="flex h-full items-center justify-center">
              <Icon name={program.data.icon} class="size-16 text-primary/40" aria-hidden="true" />
            </span>
          )}

          <!-- Numeral de etapa: ancla visual con el perfil de arriba -->
          <span
            class="absolute inset-x-0 top-0 bg-gradient-to-b from-black/55 to-transparent p-3 font-display text-3xl font-extrabold leading-none text-white/90"
            aria-hidden="true"
          >
            {String(step).padStart(2, '0')}
          </span>

          <span
            class:list={[
              'absolute bottom-3 left-3 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider',
              level.solid,
              level.ink,
            ]}
          >
            {level.label}
          </span>
        </div>

        <div class="flex flex-1 flex-col p-5">
          <h3 class="font-display text-lg font-bold text-text-primary sm:text-xl">
            <a
              href={`/programas/${program.id}`}
              class="after:absolute after:inset-0 hover:text-primary-deep"
            >
              {program.data.title}
            </a>
          </h3>
          <p class:list={['mt-1 text-sm font-semibold', level.text]}>{program.data.ageRange}</p>

          <p class="mt-3 flex-1 text-sm leading-relaxed text-text-secondary">
            {program.data.summary ?? program.data.subtitle}
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-black/5 pt-3 text-xs text-text-secondary">
            {sessions !== null && (
              <span class="inline-flex items-center gap-1.5">
                <Icon name="ph:calendar-dots-bold" class="size-4 shrink-0 text-primary-deep" aria-hidden="true" />
                {sessions} {sessions === 1 ? 'sesión' : 'sesiones'} por semana
              </span>
            )}
            {program.data.duration && (
              <span class="inline-flex items-center gap-1.5">
                <Icon name="ph:clock-bold" class="size-4 shrink-0 text-primary-deep" aria-hidden="true" />
                {program.data.duration}
              </span>
            )}
          </div>

          <span
            class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-deep transition-all duration-200 group-hover:gap-2"
            aria-hidden="true"
          >
            Ver programa
            <Icon name="ph:arrow-right-bold" class="size-4" />
          </span>
        </div>
      </article>
    ))}
  </div>

  <p class="mt-10 text-center">
    <a
      href="/programas"
      class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-deep px-5 py-2.5 font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white"
    >
      Compara los tres programas
      <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" />
    </a>
  </p>
</SectionShell>
