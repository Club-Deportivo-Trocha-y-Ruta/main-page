---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Card from '@components/common/Card.astro';
import SectionTitle from '@components/common/SectionTitle.astro';

type Program = CollectionEntry<'programs'>;

const programs = (await getCollection('programs'))
  .filter((p: Program) => !p.data.draft)
  .sort((a: Program, b: Program) => a.data.order - b.data.order);

const programStyles: Record<string, { barColor: string; iconBg: string; iconColor: string }> = {
  'escuela-de-iniciacion': {
    barColor: 'bg-primary',
    iconBg: 'bg-primary/15',
    iconColor: 'text-primary',
  },
  'formacion-juvenil': {
    barColor: 'bg-accent',
    iconBg: 'bg-accent/15',
    iconColor: 'text-accent-dark',
  },
  'alto-rendimiento': {
    barColor: 'bg-primary-light',
    iconBg: 'bg-primary-light/15',
    iconColor: 'text-primary-dark',
  },
  'recreacion': {
    barColor: 'bg-accent-light',
    iconBg: 'bg-accent-light/15',
    iconColor: 'text-accent-dark',
  },
};

const excerpts: Record<string, string> = {
  'escuela-de-iniciacion': 'Primeros pasos en el ciclomontañismo. Desarrollo de habilidades motrices básicas y amor por la bicicleta en un ambiente seguro y divertido.',
  'formacion-juvenil': 'Perfeccionamiento técnico y preparación para competencias departamentales. Entrenamiento estructurado con enfoque en disciplina deportiva.',
  'alto-rendimiento': 'Programa competitivo con planificación periodizada, preparación física avanzada y participación en competencias departamentales y nacionales en su respectiva categoría.',
  'recreacion': 'Ciclismo familiar sin presión competitiva. Salidas grupales por los senderos del Valle del Cauca abiertas a padres, madres e hijos de todas las edades.',
};

/* Iconos Phosphor por programa */
const programIcons: Record<string, string> = {
  'escuela-de-iniciacion': 'ph:bicycle-bold',
  'formacion-juvenil': 'ph:mountains-bold',
  'alto-rendimiento': 'ph:trophy-bold',
  'recreacion': 'ph:person-simple-bike-bold',
};
---

<section class="py-20 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4">
    <SectionTitle
      title="De la Escuela de Iniciación al Alto Rendimiento"
      subtitle="Cuatro programas para todas las edades: clases de iniciación desde los 4 años, formación juvenil, alto rendimiento competitivo y recreación familiar"
    />

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {programs.map((program: Program) => {
        const style = programStyles[program.id] ?? programStyles['escuela-de-iniciacion'];
        const iconPath = programIcons[program.id] ?? programIcons['escuela-de-iniciacion'];
        return (
          <Card href={`/programas/${program.id}`} class="group overflow-hidden">
            {/* Color accent bar */}
            <div class={`h-1.5 ${style.barColor}`}></div>
            <div class="p-6 pt-5">
              {/* Icon circle */}
              <div class={`mb-4 flex h-14 w-14 items-center justify-center rounded-xl ${style.iconBg} ${style.iconColor} transition-transform duration-300 group-hover:scale-110`}>
                <Icon name={iconPath} class="h-7 w-7" aria-hidden="true" />
              </div>
              <h3 class="font-display text-xl font-bold text-text-primary">
                {program.data.title}
              </h3>
              <p class="mt-1 text-sm font-medium text-primary">{program.data.ageRange}</p>
              <p class="mt-3 text-text-secondary leading-relaxed">
                {excerpts[program.id] ?? ''}
              </p>
              <span class="mt-4 inline-flex items-center gap-1 font-semibold text-primary transition-all duration-200 group-hover:gap-2">
                Ver programa
                <Icon name="ph:caret-right-bold" class="h-4 w-4" aria-hidden="true" />
              </span>
            </div>
          </Card>
        );
      })}
    </div>
  </div>
</section>
