---
import { Image } from 'astro:assets';
import SectionTitle from '@components/common/SectionTitle.astro';

import carretilla from '@assets/images/trocha-verde/carretilla-reciclada.jpg';
import mangoVerde from '@assets/images/trocha-verde/mango-llanta-verde.jpg';
import mangoMorada from '@assets/images/trocha-verde/mango-llanta-morada.jpg';
import guayacan from '@assets/images/trocha-verde/guayacan-lila.jpg';

const photos = [
  {
    src: mangoVerde,
    alt: 'Árbol de mango sembrado dentro de una llanta de bicicleta pintada de verde y amarillo en la pista Carlos Castro',
    caption: 'Mango',
  },
  {
    src: mangoMorada,
    alt: 'Árbol de mango joven protegido con una llanta de bicicleta pintada de morado en la pista de MTB',
    caption: 'Mango',
  },
  {
    src: guayacan,
    alt: 'Guayacán lila sembrado con llanta reciclada y letrero artesanal en ladrillo',
    caption: 'Guayacán Lila',
  },
];
---

<section class="py-20 bg-gradient-to-b from-emerald-50/60 to-transparent">
  <div class="mx-auto max-w-6xl px-4">
    <!-- Header -->
    <div class="text-center mb-8 md:mb-10">
      <span class="inline-block text-sm font-semibold tracking-wider uppercase text-emerald-700 mb-3">
        Trocha Verde
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-text-primary">
        Donde cada pedalada deja raíces
      </h2>
      <div class="mt-3 h-1 w-16 rounded-full bg-accent mx-auto"></div>
      <p class="mt-4 text-lg text-text-secondary max-w-2xl mx-auto">
        Reforestamos y embellecemos la pista Carlos Castro con árboles frutales y objetos reciclados.
      </p>
    </div>

    <!-- Layout principal: imagen destacada + contenido -->
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <!-- Imagen destacada: carretilla reciclada -->
      <div class="relative group">
        <Image
          src={carretilla}
          alt="Carretilla reciclada y pintada como jardín decorativo en la pista de ciclomontañismo Carlos Castro, Yumbo"
          class="rounded-2xl w-full aspect-[4/5] object-cover shadow-lg transition-transform duration-300 group-hover:scale-[1.02]"
          widths={[400, 600, 800]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="lazy"
        />
        <div class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur-sm rounded-xl px-4 py-3">
          <p class="text-sm font-semibold text-text-primary">Carretilla reciclada</p>
          <p class="text-xs text-text-secondary">Objetos en desuso se transforman en jardines en la pista</p>
        </div>
      </div>

      <!-- Texto + mini galería -->
      <div>
        <div class="space-y-4 text-text-secondary text-base leading-relaxed">
          <p>
            En <strong class="text-text-primary">Trocha y Ruta</strong> no solo formamos ciclistas
            — cuidamos el terreno donde pedalean. Nuestro presidente Helmut Ortiz lidera la siembra
            de árboles frutales y nativos en la pista Carlos Castro, un espacio público del municipio
            de Yumbo que es nuestro hogar deportivo.
          </p>
          <p>
            Llantas de bicicleta se convierten en protectores de árboles, carretillas viejas en
            jardines, y ladrillos en letreros artesanales. Cada objeto reciclado cuenta una historia
            de transformación, así como cada niño que pasa por el club.
          </p>
        </div>

        <!-- Contadores -->
        <div class="flex gap-6 mt-8">
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold font-display text-text-primary">3+</p>
              <p class="text-sm text-text-secondary">Árboles sembrados</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold font-display text-text-primary">5+</p>
              <p class="text-sm text-text-secondary">Objetos reciclados</p>
            </div>
          </div>
        </div>

        <!-- Mini galería: 3 fotos de árboles -->
        <div class="grid grid-cols-3 gap-3 mt-8">
          {photos.map((photo) => (
            <div class="group relative overflow-hidden rounded-xl">
              <Image
                src={photo.src}
                alt={photo.alt}
                class="w-full aspect-[3/4] object-cover transition-transform duration-300 group-hover:scale-105"
                widths={[200, 300]}
                sizes="(max-width: 1024px) 30vw, 15vw"
                loading="lazy"
              />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-2">
                <p class="text-xs font-medium text-white">{photo.caption}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
