---
import { Image } from 'astro:assets';
import carretilla from '@assets/images/trocha-verde/carretilla-reciclada.jpg';
---

<section class="py-16 bg-gradient-to-b from-emerald-50/60 to-transparent">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid md:grid-cols-2 gap-8 lg:gap-12 items-center">
      <!-- Imagen destacada -->
      <div class="relative group">
        <Image
          src={carretilla}
          alt="Carretilla reciclada y pintada como jardín decorativo en la pista de ciclomontañismo Carlos Castro, Yumbo"
          class="rounded-2xl w-full aspect-[4/3] object-cover shadow-lg transition-transform duration-300 group-hover:scale-[1.02]"
          widths={[400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 50vw"
          loading="lazy"
        />
      </div>

      <!-- Texto compacto -->
      <div>
        <span class="inline-block text-sm font-semibold tracking-wider uppercase text-emerald-700 mb-2">
          Trocha Verde
        </span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-text-primary">
          Donde cada pedalada deja raíces
        </h2>
        <div class="mt-3 h-1 w-16 rounded-full bg-accent"></div>
        <p class="mt-4 text-text-secondary text-base leading-relaxed">
          En <strong class="text-text-primary">Trocha y Ruta</strong> no solo formamos ciclistas
          — cuidamos el terreno donde pedalean. Llantas de bicicleta se convierten en protectores
          de árboles, carretillas viejas en jardines, y ladrillos en letreros artesanales.
          Cada objeto reciclado cuenta una historia de transformación.
        </p>

        <!-- Contadores -->
        <div class="flex gap-6 mt-6">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <div>
              <p class="text-xl font-bold font-display text-text-primary">3+</p>
              <p class="text-xs text-text-secondary">Árboles sembrados</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <div>
              <p class="text-xl font-bold font-display text-text-primary">5+</p>
              <p class="text-xs text-text-secondary">Objetos reciclados</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
