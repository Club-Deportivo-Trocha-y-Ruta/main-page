---
/**
 * Franja de confianza en la portada: quiénes ya acompañan al club, en una
 * tira que se desplaza sola. El detalle completo —niveles, antigüedad y
 * dónde aparece cada marca— vive en `/patrocinadores`, a donde enlaza el CTA.
 *
 * Sin props: la portada la usa como `<SponsorsBar />` y `src/pages/index.astro`
 * no se puede tocar, así que el componente sigue resolviendo su propio
 * contenido en vez de recibirlo por props.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Button from '@components/common/Button.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import { isPublishableSponsor } from '@lib/sponsors';

type Sponsor = CollectionEntry<'sponsors'>;

const sponsors = (await getCollection('sponsors'))
  .filter((s: Sponsor) => isPublishableSponsor(s))
  .sort((a: Sponsor, b: Sponsor) => a.data.order - b.data.order);
---

<SectionShell tone="plain" width="wide" spacing="compact" labelledby="sponsors-bar-heading">
  <SectionIntro
    id="sponsors-bar-heading"
    eyebrow="Patrocinadores"
    eyebrowIcon="ph:handshake-bold"
    title="Empresas que ya confían en el club"
    align="center"
    class="mx-auto max-w-2xl"
  />

  {
    sponsors.length > 0 && (
      <div class="relative mt-10 overflow-hidden">
        <div class="animate-scroll flex items-center gap-12">
          {[...sponsors, ...sponsors].map((s) => (
            <a
              href={s.data.url || '#'}
              target={s.data.url ? '_blank' : undefined}
              rel={s.data.url ? 'noopener noreferrer' : undefined}
              data-analytics-event={s.data.url ? 'sponsor_click' : undefined}
              data-analytics-sponsor-id={s.data.url ? s.id : undefined}
              class="shrink-0"
            >
              <img
                src={s.data.logo}
                alt={s.data.name}
                class:list={[
                  'w-auto opacity-60 grayscale transition-all duration-300 hover:opacity-100 hover:grayscale-0',
                  s.data.level === 'principal' ? 'h-16' : 'h-12',
                ]}
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>
      </div>
    )
  }

  <p class="mt-10 text-center">
    <Button href="/patrocinadores" variant="outline">Quiero ser patrocinador</Button>
  </p>
</SectionShell>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .animate-scroll {
    animation: scroll 30s linear infinite;
    width: max-content;
  }
  .animate-scroll:hover {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-scroll {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
    }
  }
</style>
