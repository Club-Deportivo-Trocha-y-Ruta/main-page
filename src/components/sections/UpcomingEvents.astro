---
/**
 * Próximas fechas en la portada.
 *
 * Versión corta del calendario: en qué punto va la temporada y las siguientes
 * fechas. El estado se deriva de la fecha, no del frontmatter.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import EventCard from '@components/common/EventCard.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import SeasonTrack from '@components/sections/SeasonTrack.astro';
import { buildSeason, resolveEventStatus } from '@lib/calendar';

type Event = CollectionEntry<'events'>;

const events = (await getCollection('events')).filter((e: Event) => !e.data.draft);

const upcoming = events
  .map((event: Event) => ({ event, status: resolveEventStatus(event.data) }))
  .filter(({ status }) => status === 'upcoming' || status === 'ongoing')
  .sort((a, b) => a.event.data.date.getTime() - b.event.data.date.getTime())
  .slice(0, 3);

const season = buildSeason(events);
---

<SectionShell tone="plain" width="default" labelledby="eventos-heading">
  <SectionIntro
    id="eventos-heading"
    eyebrow="Calendario"
    eyebrowIcon="ph:calendar-dots-bold"
    title="En qué punto va la temporada"
    highlight="la temporada"
    lead="El club compite la Copa Valle completa. Estas son las fechas que siguen."
    align="center"
    class="mx-auto max-w-2xl"
  />

  {season.stops.length > 0 && (
    <SeasonTrack season={season} hrefBase="/calendario#evento-" class="mt-10" />
  )}

  {upcoming.length > 0 ? (
    <ul class="mt-10 flex flex-col gap-3">
      {upcoming.map(({ event, status }, index) => (
        <li class="reveal" style={`--stagger:${index * 80}ms`}>
          <EventCard
            title={event.data.title}
            date={event.data.date}
            endDate={event.data.endDate}
            location={event.data.location}
            city={event.data.city}
            category={event.data.category}
            level={event.data.level}
            status={status}
            href="/calendario"
          />
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-10 text-center text-text-secondary">
      No hay fechas programadas por el momento.
    </p>
  )}

  <p class="mt-10 text-center">
    <a
      href="/calendario"
      class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-deep px-5 py-2.5 font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white"
    >
      Ver el calendario completo
      <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" />
    </a>
  </p>
</SectionShell>
