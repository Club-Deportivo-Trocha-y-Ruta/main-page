---
import { Icon } from 'astro-icon/components';
import { getTreeStats } from '@lib/trocha-verde';

const stats = await getTreeStats();

const metrics = [
  { value: stats.totalTrees, label: 'Árboles sembrados', icon: 'ph:tree-bold' },
  { value: stats.totalSpecies, label: 'Especies distintas', icon: 'ph:leaf-bold' },
  // La cifra de CO₂ que iba aquí se calculaba con constantes por categoría, no
  // con datos del club: `co2EstimateKg` está vacío en los 77 árboles. Se
  // elimina hasta que exista una medición propia.
  { value: stats.totalRecycled, label: 'Llantas recicladas', icon: 'ph:recycle-bold' },
];
---

<div class="mt-8 flex flex-wrap justify-center gap-8 sm:gap-12" data-stats-wrapper>
  {metrics.map((m) => (
    <div class="text-center" data-count-wrapper>
      <div class="flex items-center justify-center gap-2">
        <Icon name={m.icon} class="h-6 w-6 text-emerald-300" aria-hidden="true" />
        <p
          class="font-display text-4xl font-bold text-white"
          data-count-target={m.value.toString()}
          aria-label={`${m.value} ${m.label}`}
        >
          {m.value}
        </p>
      </div>
      <p class="mt-1 text-sm text-emerald-200">{m.label}</p>
    </div>
  ))}
</div>

<script>
  function animateCount(el: Element, target: number, duration = 1500) {
    const start = performance.now();
    const update = (now: number) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      // easeOutQuart
      const eased = 1 - Math.pow(1 - progress, 4);
      el.textContent = Math.round(eased * target).toString();
      if (progress < 1) requestAnimationFrame(update);
    };
    requestAnimationFrame(update);
  }

  function initCountUp() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wrapper = document.querySelector('[data-stats-wrapper]');
    if (!wrapper) return;

    if (prefersReducedMotion) {
      // Mostrar valores finales sin animación
      wrapper.querySelectorAll('[data-count-target]').forEach((el) => {
        const target = parseInt(el.getAttribute('data-count-target') ?? '0', 10);
        el.textContent = target.toString();
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.querySelectorAll('[data-count-target]').forEach((el) => {
              const target = parseInt(el.getAttribute('data-count-target') ?? '0', 10);
              animateCount(el, target);
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    observer.observe(wrapper);
  }

  // Inicializar en carga inicial y en cada navegación con View Transitions
  initCountUp();
  document.addEventListener('astro:page-load', initCountUp);
</script>
