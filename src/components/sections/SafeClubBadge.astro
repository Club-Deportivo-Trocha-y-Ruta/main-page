---
/**
 * Sello de club seguro.
 *
 * Es la última señal de confianza antes del CTA final, y la que más pesa para
 * quien está decidiendo dejar a su hijo en manos del club. Antes decía solo
 * "Club comprometido con la protección integral": una declaración de
 * intenciones sin nada detrás.
 *
 * Ahora enseña los tres compromisos concretos que la política de protección
 * infantil sostiene —incluida la línea 141 del ICBF, que es información útil
 * de verdad y no estaba en ninguna parte de la portada—. Los datos salen de
 * `CHILD_SAFETY` (@lib/constants), fuente única.
 */
import { Icon } from 'astro-icon/components';
import SectionShell from '@components/editorial/SectionShell.astro';
import { CHILD_SAFETY } from '@lib/constants';

const commitments = [
  {
    icon: 'ph:shield-check-bold',
    title: 'Política escrita y pública',
    description: 'Las reglas de protección del club están publicadas, no sobreentendidas.',
  },
  {
    icon: 'ph:users-three-bold',
    title: 'Entrenamientos abiertos',
    description: 'Los papás pueden acompañar cualquier sesión, sin avisar.',
  },
  {
    icon: 'ph:phone-call-bold',
    title: `Línea ICBF ${CHILD_SAFETY.icbfLine}`,
    description: 'Canal nacional de protección a la niñez, gratuito y confidencial.',
  },
];
---

<SectionShell tone="muted" width="wide" spacing="compact" labelledby="club-seguro-titulo">
  <div class="rounded-2xl border border-primary/20 bg-surface p-6 shadow-sm sm:p-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-6">
      <span
        class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-primary/10 text-primary-deep"
        aria-hidden="true"
      >
        <Icon name="ph:shield-check-bold" class="size-8" />
      </span>

      <div class="flex-1">
        <h2 id="club-seguro-titulo" class="font-display text-xl font-bold text-text-primary sm:text-2xl">
          Un club seguro para tu hijo
        </h2>
        <p class="mt-2 max-w-2xl text-text-secondary">
          La protección de niños, niñas y adolescentes no es un eslogan del club: es una política
          escrita, con canales concretos para reportar cualquier cosa.
        </p>

        <dl class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-3">
          {commitments.map((item) => (
            <div class="border-l-2 border-primary/20 pl-3">
              <dt class="flex items-center gap-1.5 font-display text-sm font-bold text-text-primary">
                <Icon
                  name={item.icon}
                  class="size-4 shrink-0 text-primary-deep"
                  aria-hidden="true"
                />
                {item.title}
              </dt>
              <dd class="mt-1 text-xs leading-snug text-text-secondary">{item.description}</dd>
            </div>
          ))}
        </dl>

        <a
          href={CHILD_SAFETY.policyUrl}
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-deep hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Leer la política de protección infantil
          <Icon name="ph:arrow-right-bold" class="size-4 shrink-0" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</SectionShell>
