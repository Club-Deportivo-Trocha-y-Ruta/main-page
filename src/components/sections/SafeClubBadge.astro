---
import { CHILD_SAFETY } from '@lib/constants';
---

<section class="bg-surface-muted py-10 px-4">
  <div class="mx-auto max-w-4xl">
    <a
      href={CHILD_SAFETY.policyUrl}
      class="group flex flex-col items-center gap-4 rounded-2xl border border-primary/20 bg-white p-6 shadow-sm transition hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:flex-row sm:items-center sm:gap-6"
      aria-label="Ver política de protección infantil del Club Deportivo Trocha y Ruta"
    >
      <!-- Icono escudo SVG -->
      <div
        class="flex-shrink-0 rounded-full bg-primary/10 p-4 text-primary transition group-hover:bg-primary/20"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="40"
          height="40"
          viewBox="0 0 256 256"
          fill="currentColor"
        >
          <path
            d="M208,40H48A16,16,0,0,0,32,56v58.77c0,89.61,75.82,119.34,91,124.39a15.53,15.53,0,0,0,10,0c15.2-5.05,91-34.78,91-124.39V56A16,16,0,0,0,208,40Zm0,74.79c0,78.42-66.35,104.62-80,109.18-13.53-4.51-80-30.69-80-109.18V56H208ZM82.34,141.66a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32l-56,56a8,8,0,0,1-11.32,0Z"
          />
        </svg>
      </div>

      <!-- Texto -->
      <div class="flex-1 text-center sm:text-left">
        <p class="font-display text-lg font-bold text-primary sm:text-xl">
          Club Seguro
        </p>
        <p class="mt-1 text-sm text-gray-600 sm:text-base">
          Club comprometido con la protección integral de niños, niñas y adolescentes
        </p>
      </div>

      <!-- Flecha indicadora -->
      <div
        class="flex-shrink-0 text-primary transition group-hover:translate-x-1"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 256 256"
          fill="currentColor"
        >
          <path
            d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"
          />
        </svg>
      </div>
    </a>
  </div>
</section>
