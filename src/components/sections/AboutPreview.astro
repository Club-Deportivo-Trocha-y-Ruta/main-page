---
import { Image } from 'astro:assets';
import Button from '@components/common/Button.astro';
import SectionTitle from '@components/common/SectionTitle.astro';
import { SITE } from '@lib/constants';
import pistaXco from '@assets/images/pista-xco-carlos-castro.jpg';

interface Props {}
---

<section class="py-20">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <Image
        src={pistaXco}
        alt="Pista XCO Carlos Castro en Yumbo, sede de entrenamiento del Club Trocha y Ruta"
        class="rounded-2xl aspect-video object-cover w-full"
        widths={[400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        loading="lazy"
      />
      <div>
        <SectionTitle align="left" title="Quiénes Somos" />
        <p class="text-text-secondary text-lg leading-relaxed">
          Somos escuela de iniciación y club deportivo. Desde {SITE.founded},
          en Yumbo (Valle del Cauca), enseñamos ciclomontañismo a niños desde
          4 años con clases lúdicas, entrenadores certificados y un camino
          claro hacia la competición para quienes lo deseen.
        </p>
        <div class="mt-8">
          <Button href="/quienes-somos">
            Conoce nuestra historia
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
