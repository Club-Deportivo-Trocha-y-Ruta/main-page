---
import Button from '@components/common/Button.astro';

interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
}

const {
  title = 'Formando campeones en la vida y en la pista',
  subtitle = 'Club Deportivo Trocha y Ruta · Yumbo, Valle del Cauca',
  backgroundImage,
} = Astro.props;

const YOUTUBE_VIDEO_ID = 'rz0QLMHpMVM';
const VIDEO_START = 5;
const VIDEO_END = 25;
---

<section class="relative min-h-[60vh] md:min-h-[80vh] flex items-center justify-center bg-surface-dark overflow-hidden">
  <!-- Poster image: visible on mobile, fallback on desktop if YouTube fails -->
  <img
    src="/images/hero-poster.jpg"
    alt=""
    class="hero-poster absolute inset-0 h-full w-full object-cover"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    aria-hidden="true"
  />

  <!-- YouTube video background: only on desktop -->
  <div class="hero-video-wrapper absolute inset-0 pointer-events-none hidden md:block" aria-hidden="true">
    <div id="hero-yt-player"></div>
  </div>

  {backgroundImage && (
    <img
      src={backgroundImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-black/20 z-[1]"></div>
  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center text-white">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold leading-tight">
      {title}
    </h1>
    <p class="mt-4 text-lg md:text-xl text-white/90">
      {subtitle}
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button variant="accent" size="lg" href="/inscripciones">
        Clase de prueba gratis
      </Button>
      <Button
        variant="outline"
        size="lg"
        href="/quienes-somos"
        class="border-white text-white hover:bg-white hover:text-surface-dark"
      >
        Conoce más
      </Button>
    </div>
  </div>
</section>

<style>
  .hero-video-wrapper {
    overflow: hidden;
  }

  .hero-video-wrapper :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120vw;
    height: 120vh;
    min-width: 120%;
    min-height: 120%;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }

  /* Hide video when user prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-video-wrapper {
      display: none !important;
    }
  }
</style>

<script define:vars={{ YOUTUBE_VIDEO_ID, VIDEO_START, VIDEO_END }}>
  const DESKTOP_BREAKPOINT = 768;
  let player;
  let loopInterval;

  function isDesktop() {
    return window.innerWidth >= DESKTOP_BREAKPOINT;
  }

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initYouTubePlayer() {
    // Skip on mobile or if user prefers reduced motion
    if (!isDesktop() || prefersReducedMotion()) return;

    const container = document.getElementById('hero-yt-player');
    if (!container) return;

    player = new YT.Player('hero-yt-player', {
      videoId: YOUTUBE_VIDEO_ID,
      playerVars: {
        autoplay: 1,
        mute: 1,
        controls: 0,
        showinfo: 0,
        rel: 0,
        modestbranding: 1,
        playsinline: 1,
        start: VIDEO_START,
        end: VIDEO_END,
        disablekb: 1,
        fs: 0,
        iv_load_policy: 3,
      },
      events: {
        onReady: onPlayerReady,
        onStateChange: onPlayerStateChange,
      },
    });
  }

  function onPlayerReady(event) {
    event.target.mute();
    event.target.playVideo();
    startLoopCheck();
  }

  function onPlayerStateChange(event) {
    if (event.data === YT.PlayerState.ENDED) {
      player.seekTo(VIDEO_START, true);
      player.playVideo();
    }
  }

  function startLoopCheck() {
    if (loopInterval) clearInterval(loopInterval);
    loopInterval = setInterval(() => {
      if (player && player.getCurrentTime) {
        const currentTime = player.getCurrentTime();
        if (currentTime >= VIDEO_END || currentTime < VIDEO_START) {
          player.seekTo(VIDEO_START, true);
        }
      }
    }, 500);
  }

  // Cleanup on View Transitions navigation
  document.addEventListener('astro:before-swap', () => {
    if (loopInterval) clearInterval(loopInterval);
    if (player && player.destroy) player.destroy();
  }, { once: true });

  // Re-initialize on View Transitions back-navigation
  document.addEventListener('astro:after-swap', () => {
    if (isDesktop() && !prefersReducedMotion()) {
      if (window.YT && window.YT.Player) {
        initYouTubePlayer();
      }
    }
  });

  // Load YouTube IFrame API only on desktop
  if (isDesktop() && !prefersReducedMotion()) {
    if (!window.YT) {
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
      window.onYouTubeIframeAPIReady = initYouTubePlayer;
    } else {
      initYouTubePlayer();
    }
  }
</script>
