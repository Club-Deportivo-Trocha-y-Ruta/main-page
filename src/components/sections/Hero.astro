---
/**
 * Hero de la portada.
 *
 * Mantiene su marco propio —vídeo a pantalla completa sobre fondo oscuro— a
 * propósito: no es una sección del sistema editorial y `SectionShell` no le
 * sirve. Lo que sí sigue del sistema es la regla de fondo: nada escrito a mano
 * que el contenido pueda decir.
 *
 * Por eso el antetítulo saca el año de `SITE.founded` en vez de repetir "2010"
 * en el texto, y debajo de los botones va **el pulso del club**: la próxima
 * fecha real de la temporada, o un aviso distinto si la carrera es hoy. Así la
 * portada deja de ser un cartel fijo. Si ya corrió toda la temporada, ese
 * bloque simplemente no se pinta.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Button from '@components/common/Button.astro';
import { getHeroPoster } from '@lib/hero-poster';
import { heroPulse } from '@lib/home';
import { SITE } from '@lib/constants';

interface Props {
  title?: string;
  /** Fragmento exacto del título que va resaltado con el trazo de marca. */
  highlight?: string;
  subtitle?: string;
  backgroundImage?: string;
}

const {
  title = 'Formando campeones en la vida y en la pista',
  highlight = 'en la vida',
  // Sin edad mínima en el texto: el contenido se contradice (la colección
  // `programs` arranca en 3 y las FAQ y `constants.ts` dicen 4), y la portada
  // no es el lugar para zanjarlo. Ver el reporte de la migración.
  subtitle = 'Ciclomontañismo para niños y jóvenes, con pista propia en Yumbo, Valle del Cauca.',
  backgroundImage,
} = Astro.props;

const YOUTUBE_VIDEO_ID = 'rz0QLMHpMVM';
const VIDEO_START = 5;
const VIDEO_END = 25;

const poster = await getHeroPoster();

type Event = CollectionEntry<'events'>;
const events = (await getCollection('events')).filter((event: Event) => !event.data.draft);
const pulse = heroPulse(events);

// El resaltado se aplica sobre el texto tal cual viene: si el fragmento no
// aparece en el título, se pinta el título completo sin marcar.
const cut = highlight ? title.indexOf(highlight) : -1;
const beforeMark = cut >= 0 ? title.slice(0, cut) : title;
const afterMark = cut >= 0 && highlight ? title.slice(cut + highlight.length) : '';
---

<section
  aria-labelledby="hero-titulo"
  class="relative min-h-[60vh] md:min-h-[80vh] flex items-center justify-center bg-surface-dark overflow-hidden"
>
  <!-- Poster image: visible on mobile, fallback on desktop if YouTube fails.
       Queda siempre debajo del video; el iframe solo se revela cuando reproduce. -->
  <img
    src={poster.src}
    srcset={poster.srcSet.attribute || undefined}
    sizes="100vw"
    alt=""
    width="1280"
    height="720"
    class="hero-poster absolute inset-0 h-full w-full object-cover"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    aria-hidden="true"
  />

  <!-- YouTube video background: only on desktop -->
  <div class="hero-video-wrapper absolute inset-0 pointer-events-none hidden md:block" aria-hidden="true">
    <div id="hero-yt-player"></div>
  </div>

  {backgroundImage && (
    <img
      src={backgroundImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/30 to-primary-dark/15 z-[1]"></div>
  <div class="relative z-10 mx-auto max-w-5xl px-4 text-center text-white">
    <!-- Badge de marca -->
    <div class="inline-flex items-center gap-2 mb-5 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-white/90 border border-white/20">
      <span class="w-1.5 h-1.5 rounded-full bg-accent inline-block"></span>
      Yumbo · Valle del Cauca · Desde {SITE.founded}
    </div>
    <h1
      id="hero-titulo"
      class="text-5xl md:text-6xl lg:text-7xl font-display font-bold leading-[0.95] tracking-tight drop-shadow-[0_2px_8px_rgba(0,0,0,0.6)] uppercase"
    >
      {beforeMark}{cut >= 0 && <span class="editorial-mark editorial-mark--on-dark">{highlight}</span>}{afterMark}
    </h1>
    <p class="mt-5 text-base md:text-xl text-white/85 drop-shadow-[0_1px_3px_rgba(0,0,0,0.4)] max-w-2xl mx-auto">
      {subtitle}
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <Button variant="accent" size="lg" href="/inscripciones">
        Clase de prueba gratis
        <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
      </Button>
      <Button
        variant="outline"
        size="lg"
        href="/quienes-somos"
        class="border-white text-white hover:bg-white hover:text-surface-dark bg-white/10 backdrop-blur-sm"
      >
        Conoce más
      </Button>
    </div>

    {/*
      El pulso del club: lo que está pasando ahora mismo en la temporada. Si ya
      corrió la última fecha, no se pinta nada.
    */}
    {pulse && (
      <a
        href="/calendario"
        class="mt-8 inline-flex max-w-full items-center gap-3 rounded-full border border-white/20 bg-white/10 py-2 pl-3 pr-4 text-left backdrop-blur-sm transition-colors duration-200 hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        <span
          class:list={[
            'flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider',
            pulse.today ? 'bg-accent text-surface-dark' : 'bg-white/15 text-accent-light',
          ]}
        >
          {pulse.today && <Icon name="ph:lightning-bold" class="size-3.5" aria-hidden="true" />}
          {pulse.today ? 'Corremos hoy' : 'Próxima fecha'}
        </span>
        <span class="min-w-0 text-sm text-white/90">
          <span class="font-semibold">{pulse.when}</span>
          {pulse.where && <span class="text-white/70"> · {pulse.where}</span>}
        </span>
        <Icon
          name="ph:arrow-right-bold"
          class="size-4 shrink-0 text-white/70"
          aria-hidden="true"
        />
      </a>
    )}
  </div>

  <!--
    Flecha de scroll. Solo cuando no hay pulso: con la tarjeta de la próxima
    fecha abajo, la flecha se le encima y compiten por la misma mirada.
  -->
  {!pulse && (
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 motion-safe:animate-bounce" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-white/70" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
  )}
</section>

<style>
  .hero-video-wrapper {
    overflow: hidden;
    /* Oculto hasta que el reproductor emite PLAYING: el iframe pinta negro
       antes del primer frame y tapaba el poster durante 2-5 s. */
    opacity: 0;
    transition: opacity 500ms ease-in;
  }

  .hero-video-wrapper.video-ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-wrapper {
      transition: none;
    }
  }

  .hero-video-wrapper :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120vw;
    height: 120vh;
    min-width: 120%;
    min-height: 120%;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }

  /* Hide video when user prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-video-wrapper {
      display: none !important;
    }
  }
</style>

<script define:vars={{ YOUTUBE_VIDEO_ID, VIDEO_START, VIDEO_END }}>
  const DESKTOP_BREAKPOINT = 768;
  // Si el video no llega a reproducir en este lapso, el hero se queda con el
  // poster: preferible a un rectángulo negro esperando a YouTube.
  const VIDEO_REVEAL_TIMEOUT = 6000;
  let player;
  let loopInterval;
  let revealTimeout;

  function videoWrapper() {
    return document.querySelector('.hero-video-wrapper');
  }

  function revealVideo() {
    if (revealTimeout) clearTimeout(revealTimeout);
    const wrapper = videoWrapper();
    if (wrapper) wrapper.classList.add('video-ready');
  }

  function hideVideo() {
    if (revealTimeout) clearTimeout(revealTimeout);
    const wrapper = videoWrapper();
    if (wrapper) wrapper.classList.remove('video-ready');
  }

  function isDesktop() {
    return window.innerWidth >= DESKTOP_BREAKPOINT;
  }

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initYouTubePlayer() {
    // Skip on mobile or if user prefers reduced motion
    if (!isDesktop() || prefersReducedMotion()) return;

    const container = document.getElementById('hero-yt-player');
    if (!container) return;

    player = new YT.Player('hero-yt-player', {
      videoId: YOUTUBE_VIDEO_ID,
      playerVars: {
        autoplay: 1,
        mute: 1,
        controls: 0,
        showinfo: 0,
        rel: 0,
        modestbranding: 1,
        playsinline: 1,
        start: VIDEO_START,
        end: VIDEO_END,
        disablekb: 1,
        fs: 0,
        iv_load_policy: 3,
      },
      events: {
        onReady: onPlayerReady,
        onStateChange: onPlayerStateChange,
        onError: hideVideo,
      },
    });
  }

  function onPlayerReady(event) {
    event.target.mute();
    event.target.playVideo();
    startLoopCheck();
    if (revealTimeout) clearTimeout(revealTimeout);
    revealTimeout = setTimeout(hideVideo, VIDEO_REVEAL_TIMEOUT);
  }

  function onPlayerStateChange(event) {
    if (event.data === YT.PlayerState.PLAYING) {
      revealVideo();
    }
    if (event.data === YT.PlayerState.ENDED) {
      player.seekTo(VIDEO_START, true);
      player.playVideo();
    }
  }

  function startLoopCheck() {
    if (loopInterval) clearInterval(loopInterval);
    loopInterval = setInterval(() => {
      if (player && player.getCurrentTime) {
        const currentTime = player.getCurrentTime();
        if (currentTime >= VIDEO_END || currentTime < VIDEO_START) {
          player.seekTo(VIDEO_START, true);
        }
      }
    }, 500);
  }

  // Cleanup on View Transitions navigation
  document.addEventListener('astro:before-swap', () => {
    if (loopInterval) clearInterval(loopInterval);
    if (revealTimeout) clearTimeout(revealTimeout);
    if (player && player.destroy) player.destroy();
  }, { once: true });

  // Re-initialize on View Transitions back-navigation
  document.addEventListener('astro:after-swap', () => {
    hideVideo();
    if (isDesktop() && !prefersReducedMotion()) {
      if (window.YT && window.YT.Player) {
        initYouTubePlayer();
      }
    }
  });

  // Load YouTube IFrame API only on desktop
  if (isDesktop() && !prefersReducedMotion()) {
    if (!window.YT) {
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
      window.onYouTubeIframeAPIReady = initYouTubePlayer;
    } else {
      initYouTubePlayer();
    }
  }
</script>
