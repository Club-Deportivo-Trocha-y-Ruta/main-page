---
/**
 * Hero de la portada.
 *
 * Marco propio —no `SectionShell`—, pero del sistema editorial hacia adentro:
 * el fondo es la cadena del tono `tinted` (`getTone('tinted')` en
 * `@lib/editorial`, no clases escritas a mano) y la textura es la misma topo
 * que usan las secciones, con su deriva de scroll y su desvanecido hacia abajo.
 *
 * El hero dejó de ser un cartel: era una foto a pantalla completa con el texto
 * encima, en blanco sobre degradados oscuros. Ahora es claro y a dos columnas
 * —texto a la izquierda, foto a la derecha—, y lo que estaba escondido en un
 * chip pasa a ser la pieza que más dice del club: la tarjeta de temporada, con
 * el riel de fechas y la próxima carrera real.
 *
 * La regla de fondo no cambia: nada escrito a mano que el contenido pueda
 * decir. El año de fundación sale de `SITE.founded` y el pulso de
 * `heroPulse()` —la misma derivación de `/calendario` y `/enlaces`, así que las
 * tres nunca se contradicen—. Si ya corrió toda la temporada, la tarjeta no se
 * pinta y no la reemplaza nada.
 *
 * Las cifras de la temporada (años del club, fechas corridas) no se escriben
 * aquí: viven en la banda de credibilidad de la sección siguiente
 * (`StatsCounter`), que es la que las publica con su procedencia y su enlace
 * para comprobarlas. El hero aporta lo que la banda no dice: el dibujo del
 * riel y cuál es la próxima fecha.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Button from '@components/common/Button.astro';
import SeasonRail from '@components/sections/SeasonRail.astro';
import { getHeroPoster } from '@lib/hero-poster';
import { heroPulse } from '@lib/home';
import { buildSeason } from '@lib/calendar';
import { CTA_TRIAL_LABEL, SITE } from '@lib/constants';
import { getTone, TOPO_PATHS, TOPO_TILE, uniqueSvgId } from '@lib/editorial';

interface Props {
  title?: string;
  /** Fragmento exacto del título que va resaltado con el trazo de marca. */
  highlight?: string;
  subtitle?: string;
}

const {
  title = 'Formando campeones en la vida y en la pista',
  highlight = 'en la vida',
  subtitle = 'Ciclomontañismo para niños desde los 4 años, con pista propia en Yumbo, Valle del Cauca.',
} = Astro.props;

const poster = await getHeroPoster();
const tone = getTone('tinted');
const topoPatternId = uniqueSvgId('hero-topo');

type Event = CollectionEntry<'events'>;
const events = (await getCollection('events')).filter((event: Event) => !event.data.draft);

// Un solo "ahora" para las dos derivaciones: `buildSeason()` y `heroPulse()`
// resuelven el mismo estado y no pueden discrepar por dos `new Date()`.
const now = new Date();
const season = buildSeason(events, now);
const pulse = heroPulse(events, now);

// El resaltado se aplica sobre el texto tal cual viene: si el fragmento no
// aparece en el título, se pinta el título completo sin marcar.
const cut = highlight ? title.indexOf(highlight) : -1;
const beforeMark = cut >= 0 ? title.slice(0, cut) : title;
const afterMark = cut >= 0 && highlight ? title.slice(cut + highlight.length) : '';
---

<section
  aria-labelledby="hero-titulo"
  class:list={['relative isolate overflow-clip', tone.surface]}
>
  <!-- Curvas topo: misma textura, mismo color de patrón y mismo desvanecido
       que `SectionShell` con `pattern="topo"` y `scrollDriven`. Se pinta más
       alta que la sección para que la deriva nunca descubra una franja sin
       patrón, y la sección recorta con `overflow-clip` —no `hidden`, que
       crearía un contenedor de scroll y congelaría el `view()`. -->
  <svg
    class:list={[
      'sda-parallax-slow pointer-events-none absolute inset-x-0 -top-8 -z-10 h-[calc(100%+4rem)] w-full',
      tone.pattern,
    ]}
    aria-hidden="true"
    focusable="false"
    style="mask-image: linear-gradient(to bottom, black, transparent 78%);"
  >
    <defs>
      <pattern
        id={topoPatternId}
        width={TOPO_TILE}
        height={TOPO_TILE}
        patternUnits="userSpaceOnUse"
      >
        {
          TOPO_PATHS.map((d) => (
            <path d={d} fill="none" stroke="currentColor" stroke-width="1.25" />
          ))
        }
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${topoPatternId})`}></rect>
  </svg>

  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <!-- En móvil se apila texto → foto → tarjeta de temporada; desde lg la foto
         ocupa la columna derecha completa y la tarjeta baja bajo el texto. -->
    <div class="grid gap-x-12 gap-y-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7 lg:col-start-1 lg:row-start-1">
        <p
          class="text-text-secondary inline-flex items-center gap-2 rounded-full border border-black/10 bg-white/80 px-4 py-1.5 text-xs font-semibold tracking-widest uppercase"
        >
          <span class="bg-accent inline-block size-1.5 rounded-full" aria-hidden="true"></span>
          Yumbo · Valle del Cauca · Desde {SITE.founded}
        </p>

        <h1
          id="hero-titulo"
          class="font-display text-text-primary mt-6 text-4xl leading-[1.05] font-bold tracking-tight sm:text-5xl lg:text-6xl"
        >
          {beforeMark}{cut >= 0 && <span class="editorial-mark">{highlight}</span>}{afterMark}
        </h1>

        <p class="text-text-secondary mt-5 max-w-xl text-base sm:text-lg">{subtitle}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button variant="accent" size="lg" href="/inscripciones">
            {CTA_TRIAL_LABEL}
            <svg
              class="ml-2 h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </Button>
          <Button variant="outline" size="lg" href="/quienes-somos">Conoce el club</Button>
        </div>
      </div>

      <div class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-center">
        <!-- `sizes` describe la columna real —desde lg son ~5/12 de
             `max-w-7xl`, no el ancho del viewport— y tiene que decir lo mismo
             que el `imagesizes` del preload en `BaseLayout.astro`: si los dos
             discrepan, el navegador descarga una variante y precarga otra. -->
        <img
          src={poster.src}
          srcset={poster.srcSet.attribute || undefined}
          sizes="(min-width: 1024px) 30rem, 100vw"
          alt="Dos niños del club, con casco, gafas y guantes, sonríen sobre sus bicicletas"
          width="1280"
          height="720"
          class="shadow-overlay aspect-[4/3] w-full rounded-2xl object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      {
        /*
        El pulso del club, ascendido a tarjeta: en qué punto va la temporada y
        cuál es la próxima fecha. Si ya corrió la última, no se pinta nada.
      */
      }
      {
        pulse && (
          <div class="lg:col-span-7 lg:col-start-1 lg:row-start-2">
            <div class="bg-surface shadow-raised max-w-[35rem] rounded-2xl border border-black/5 p-5 sm:p-6">
              {/* El conteo de fechas corridas no se escribe aquí: lo publica
                  la banda de credibilidad de la sección siguiente, y repetirlo
                  a un scroll de distancia es la misma cifra dos veces. Lo que
                  el riel dibuja viaja como texto en su propio resumen. */}
              <p class="text-primary-deep text-xs font-bold tracking-[0.16em] uppercase">
                Temporada {season.year}
              </p>

              <SeasonRail season={season} class="mt-4" />

              <div class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                <p class="text-text-secondary min-w-0 text-sm">
                  {pulse.today ? (
                    <span class="bg-accent text-surface-dark mr-1 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold tracking-wider uppercase">
                      <Icon name="ph:lightning-bold" class="size-3.5" aria-hidden="true" />
                      Corremos hoy
                    </span>
                  ) : (
                    <span class="text-text-primary font-semibold">Próxima fecha: {pulse.when}</span>
                  )}
                  {/* Solo el título: la ciudad ya viene dentro de él en casi
                      toda la colección ("VII Válida Copa Valle 2026 - Yumbo"),
                      y pintar además `where` la repetía. */}
                  {pulse.title && <span> · {pulse.title}</span>}
                </p>

                <a
                  href="/calendario"
                  class="text-primary-deep inline-flex min-h-11 shrink-0 items-center gap-1.5 text-sm font-semibold hover:underline"
                >
                  Ver calendario
                  <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" />
                </a>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
