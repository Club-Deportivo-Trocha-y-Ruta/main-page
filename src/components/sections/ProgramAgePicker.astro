---
/**
 * Selector de edad de `/programas` (docs/08-plan-creatividad-ui.md, tarea 5).
 *
 * Un grupo de radios —uno por edad que algún programa cubre, más «todas»— que
 * resalta la etapa que le corresponde a esa edad. **No hay JavaScript**: el
 * resaltado lo hace `:has()` sobre el contenedor de la página, leyendo qué radio
 * quedó `:checked`.
 *
 * Reparto de responsabilidades:
 * - Las edades salen de `buildAgePicker()`, que las deriva de `ageMin`/`ageMax`
 *   de la colección `programs`. Aquí no hay ni un número escrito a mano.
 * - El texto (la pregunta, la aclaración, el «todas las edades») sale de
 *   `src/content/pages/programas.md` → `agePicker`.
 * - Cómo se ve el resaltado está en `global.css`. Lo único que se genera en
 *   build es el puente entre ambos: una regla por edad que enciende
 *   `--age-emphasis` en los elementos con esa edad en su `data-ages`. Es la
 *   única parte que no se puede escribir estática, porque CSS no sabe comparar
 *   el `value` de un radio con un rango numérico.
 *
 * Degradación: sin `:has()` (o sin CSS) el selector sigue siendo un grupo de
 * radios usable y **todo se ve normal**, que es el estado por defecto —el radio
 * «todas» arranca marcado—. Nada de la página depende de tener una edad elegida.
 */
import { AGE_ALL_VALUE, AGE_INPUT_NAME, AGE_SCOPE_CLASS, type AgeOption } from '@lib/programs';

interface Props {
  options: AgeOption[];
  /** Pregunta del `<legend>`. */
  legend: string;
  /** Aclaración de qué hace elegir una edad. */
  hint?: string;
  /** Texto de la opción que quita el filtro. */
  allLabel: string;
  class?: string;
}

const { options, legend, hint, allLabel, class: className } = Astro.props;

const hintId = hint ? 'programa-edad-ayuda' : undefined;

/**
 * El puente CSS. Una regla por edad, con los dos valores conocidos en build:
 * el `value` del radio y la edad que se busca dentro de `data-ages` (`~=`
 * compara palabra completa, así que `1` no matchea `11`).
 */
const emphasisRules = options
  .map(
    (option) =>
      `.${AGE_SCOPE_CLASS}:has(input[name="${AGE_INPUT_NAME}"][value="${option.age}"]:checked) ` +
      `[data-ages~="${option.age}"]{--age-emphasis:1}`
  )
  .join('\n');

const CHIP_CLASS = [
  // 44px de alto y de ancho mínimos: objetivo táctil cómodo en móvil.
  'inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3.5',
  'border border-primary/25 bg-surface font-display text-sm font-bold text-text-primary',
  'transition-colors duration-200',
  'peer-hover:bg-primary/10',
  // Lima sobre grafito: 9:1, muy por encima del 4.5:1 exigido.
  'peer-checked:border-accent-deep peer-checked:bg-accent peer-checked:text-surface-dark',
  // El radio real está en `sr-only`, así que el foco tiene que verse aquí.
  'peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary-deep',
].join(' ');
---

{options.length > 1 && (
  <div class={className}>
    <style is:inline set:html={emphasisRules}></style>

    <fieldset class="not-prose" aria-describedby={hintId}>
      <legend class="text-xs font-semibold uppercase tracking-[0.16em] text-primary-deep">
        {legend}
      </legend>

      {hint && (
        <p id={hintId} class="mt-1.5 text-sm leading-snug text-text-secondary">
          {hint}
        </p>
      )}

      <div class="mt-3 flex flex-wrap gap-2">
        <label class="cursor-pointer">
          <input
            type="radio"
            name={AGE_INPUT_NAME}
            value={AGE_ALL_VALUE}
            class="peer sr-only"
            checked
          />
          <span class={CHIP_CLASS}>{allLabel}</span>
        </label>

        {options.map((option) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name={AGE_INPUT_NAME}
              value={option.age}
              aria-label={option.ariaLabel}
              class="peer sr-only"
            />
            <span class={CHIP_CLASS}>{option.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>
)}
