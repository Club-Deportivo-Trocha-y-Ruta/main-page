---
/**
 * TrochaVerdeNav — sticky in-page nav for /trocha-verde
 * 4 anchors: #especies #siembras #proceso #sponsors
 * CSS-only sticky, zero-JS. Mobile-first.
 * Uses --header-h CSS custom property set by BaseLayout's inline script,
 * which measures header + AnnouncementBar (if visible) on load, resize, and
 * when the bar is dismissed. Fallback 4rem covers the case where JS hasn't run.
 */
---

<nav
  class="sticky z-30 mb-10 w-screen border-b border-emerald-100 bg-white shadow-sm"
  style="top: var(--header-h, 4rem); margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);"
  aria-label="Secciones de Trocha Verde"
>
  <ul class="mx-auto flex max-w-7xl items-center gap-1 overflow-x-auto px-4 py-1.5 sm:gap-2 sm:px-6 lg:px-8">
    <li>
      <a
        href="#especies"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:bg-emerald-50 hover:text-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 sm:px-4"
      >
        <span aria-hidden="true">🌿</span>
        Especies
      </a>
    </li>
    <li>
      <a
        href="#siembras"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:bg-emerald-50 hover:text-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 sm:px-4"
      >
        <span aria-hidden="true">🌱</span>
        Siembras
      </a>
    </li>
    <li>
      <a
        href="#proceso"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:bg-emerald-50 hover:text-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 sm:px-4"
      >
        <span aria-hidden="true">♻️</span>
        Proceso
      </a>
    </li>
    <li>
      <a
        href="#sponsors"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:bg-emerald-50 hover:text-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 sm:px-4"
      >
        <span aria-hidden="true">🤝</span>
        Empresas
      </a>
    </li>
  </ul>
</nav>
