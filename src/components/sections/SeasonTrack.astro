---
/**
 * La temporada de un vistazo: el año en doce meses, cada fecha en el suyo y una
 * barra que se llena hasta hoy.
 *
 * Responde "¿en qué punto vamos?", que es lo que uno quiere saber al abrir un
 * calendario deportivo a mitad de temporada. Lo corrido queda apagado, la que
 * sigue se resalta en lima y lo que falta va en hueco.
 *
 * Antes era un riel de una parada por fecha. Con 14 fechas ya no cabía ni en
 * escritorio: el riel se volvía un carrusel con scroll horizontal, la mitad del
 * año quedaba fuera de pantalla y hacía falta un script para centrarlo en la
 * fecha que sigue. El año siempre tiene doce meses, así que agrupar por mes
 * deja el dibujo de un tamaño fijo por muchas fechas que se sumen, muestra el
 * ritmo real de la temporada (los meses sin carrera también se ven) y no
 * necesita JS. La rejilla se reacomoda por trimestres en el teléfono (3 × 4),
 * cuatrimestres (4 × 3), semestres (6 × 2) y el año corrido en escritorio.
 *
 * La barra de cada mes es un tramo del mismo degradado: puestos en fila,
 * los doce tramos dibujan un solo riel de teal a lima.
 */
import { Icon } from 'astro-icon/components';
import type { Season, SeasonMonth, SeasonStop } from '@lib/calendar';

type Entry = { id: string; data: { title: string } };

interface Props {
  season: Season<Entry>;
  /** Prefijo del enlace de cada parada, normalmente un ancla de la página. */
  hrefBase?: string;
  class?: string;
}

const { season, hrefBase = '#evento-', class: className } = Astro.props;

type Stop = SeasonStop<Entry>;
type Month = SeasonMonth<Entry>;

const isNext = (stop: Stop) => season.next?.id === stop.id;
const isCancelled = (stop: Stop) => stop.status === 'cancelled';
const isCurrentMonth = (month: Month) => month.elapsed > 0 && month.elapsed < 1;

// Ningún estado depende solo del color: la que sigue es más grande y va
// rotulada, lo corrido es relleno y lo que falta, hueco.
const dot: Record<string, string> = {
  past: 'size-2 bg-primary-deep/60',
  ongoing: 'size-3 bg-accent ring-[3px] ring-accent/30',
  upcoming: 'size-2.5 bg-surface ring-2 ring-primary-deep/40',
};
const dotFor = (stop: Stop) => (isNext(stop) ? dot.ongoing : (dot[stop.status] ?? dot.upcoming));

const statusNote = (stop: Stop) => {
  if (isCancelled(stop)) return ' — cancelada';
  if (isNext(stop)) return stop.status === 'ongoing' ? ' — en curso' : ' — la próxima';
  return stop.status === 'past' ? ' — corrida' : '';
};

const round2 = (n: number) => Math.round(n * 100) / 100;

// El tramo `index` del degradado de todo el año: el fondo mide doce meses y se
// corre hasta mostrar solo el que toca.
const fillStyle = (month: Month) =>
  [
    `background-position:${round2((month.index / 11) * 100)}% 0`,
    month.elapsed < 1 &&
      `clip-path:inset(0 ${round2((1 - month.elapsed) * 100)}% 0 0 round 9999px)`,
  ]
    .filter(Boolean)
    .join(';');
---

{
  season.stops.length > 0 && (
    <figure class:list={['not-prose', className]}>
      <figcaption class="sr-only">
        Temporada {season.year}: {season.completed} de {season.total} fechas corridas.
        {season.cancelled > 0 &&
          ` ${season.cancelled === 1 ? 'Una fecha cancelada' : `${season.cancelled} fechas canceladas`}.`}
        {season.next &&
          ` La próxima es en ${season.next.label}${
            season.next.qualifier ? ` (${season.next.qualifier})` : ''
          }.`}
      </figcaption>

      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <p class="text-primary-deep text-xs font-bold tracking-[0.16em] uppercase">
          Temporada {season.year}
        </p>
        <p class="text-text-secondary text-xs">
          <span class="text-text-primary font-bold">{season.completed}</span> de {season.total}{' '}
          fechas corridas
          {season.cancelled > 0 && (
            <span class="whitespace-nowrap">
              {' · '}
              {season.cancelled === 1 ? '1 cancelada' : `${season.cancelled} canceladas`}
            </span>
          )}
        </p>
      </div>

      <ol class="mt-5 grid grid-cols-3 gap-x-1.5 gap-y-6 sm:grid-cols-4 md:grid-cols-6 xl:grid-cols-12">
        {season.months.map((month) => (
          <li class="min-w-0">
            <p
              class:list={[
                'px-1 text-[11px] tracking-wider uppercase',
                isCurrentMonth(month)
                  ? 'text-primary-deep font-bold'
                  : 'text-text-secondary font-semibold',
              ]}
            >
              <span aria-hidden="true">{month.short}</span>
              <span class="sr-only">{month.name}</span>
            </p>

            {/* Tramo del riel: gris de fondo, lleno hasta donde va el mes */}
            <div class="relative mt-1.5 flex h-3 items-center" aria-hidden="true">
              <div class="bg-text-primary/10 relative h-1.5 w-full overflow-hidden rounded-full">
                {month.elapsed > 0 && (
                  <div
                    class="season-track-fill from-primary to-accent absolute inset-0 bg-gradient-to-r bg-[length:1200%_100%]"
                    style={fillStyle(month)}
                  />
                )}
              </div>
              {isCurrentMonth(month) && (
                <span
                  class="bg-text-primary ring-surface absolute size-2.5 -translate-x-1/2 rounded-full ring-2"
                  style={`left:${round2(month.elapsed * 100)}%`}
                />
              )}
            </div>

            {month.stops.length > 0 ? (
              <ul class="mt-2 flex flex-col gap-1">
                {month.stops.map((stop) => (
                  <li data-stop-id={stop.id}>
                    <a
                      href={`${hrefBase}${stop.id}`}
                      class:list={[
                        'group focus-visible:outline-primary flex items-start gap-1 rounded-md px-0.5 py-1 focus-visible:outline-2 focus-visible:outline-offset-2',
                        isNext(stop)
                          ? 'bg-accent/15 ring-accent/50 ring-1 ring-inset'
                          : 'hover:bg-primary/8',
                      ]}
                      aria-label={`${stop.event.data.title} — ${stop.dateLabel}${statusNote(stop)}`}
                    >
                      <span
                        class="flex h-5 w-3 shrink-0 items-center justify-center"
                        aria-hidden="true"
                      >
                        {isCancelled(stop) ? (
                          <Icon
                            name="ph:x-circle-fill"
                            class="text-text-secondary/60 size-3.5 group-hover:scale-125 motion-safe:transition-transform motion-safe:duration-200"
                          />
                        ) : (
                          <span
                            class:list={[
                              'block rounded-full group-hover:scale-125 motion-safe:transition-transform motion-safe:duration-200',
                              dotFor(stop),
                            ]}
                          />
                        )}
                      </span>

                      <span class="flex min-w-0 flex-col items-start break-words hyphens-auto">
                        <span
                          class:list={[
                            'font-display text-sm leading-5 font-bold',
                            stop.status === 'past' ? 'text-text-secondary' : 'text-text-primary',
                            isCancelled(stop) && 'line-through',
                          ]}
                        >
                          {stop.day}
                        </span>
                        <span
                          class:list={[
                            'max-w-full text-xs leading-tight',
                            isNext(stop)
                              ? 'text-text-primary font-semibold'
                              : 'text-text-secondary',
                            isCancelled(stop) && 'line-through decoration-1',
                          ]}
                        >
                          {stop.label}
                        </span>

                        {/*
                        Solo cuando la temporada pasa dos veces por la misma ciudad:
                        sin esto, "Yumbo" el 5 de septiembre y "Yumbo" el 18 de octubre
                        se leen como la misma fecha repetida. Va en texto plano y no en
                        chip para no competir con "Sigue" y "Cancelada", que son estado.
                      */}
                        {stop.qualifier && (
                          <span
                            class:list={[
                              'text-text-secondary mt-0.5 max-w-full text-[10px] leading-tight',
                              isCancelled(stop) && 'line-through decoration-1',
                            ]}
                          >
                            {stop.qualifier}
                          </span>
                        )}

                        {isCancelled(stop) && (
                          <span class="bg-text-primary/[0.06] text-text-secondary mt-1 rounded-full px-1.5 py-0.5 text-[10px] font-bold tracking-wider uppercase">
                            Cancelada
                          </span>
                        )}

                        {isNext(stop) && (
                          <span class="text-accent-deep mt-1 text-[10px] font-bold tracking-wider uppercase">
                            {stop.status === 'ongoing' ? 'En curso' : 'Sigue'}
                          </span>
                        )}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-2 px-1 text-xs leading-5">
                <span class="text-text-secondary/50" aria-hidden="true">
                  —
                </span>
                <span class="sr-only">Sin fechas</span>
              </p>
            )}
          </li>
        ))}
      </ol>
    </figure>
  )
}
