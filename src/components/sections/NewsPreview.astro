---
/**
 * Últimas noticias en la portada.
 *
 * Portada de periódico antes que rejilla: la crónica más reciente ocupa el
 * lugar principal y las dos anteriores quedan como titulares de apoyo. Así se
 * entiende qué pasó el fin de semana sin abrir nada.
 *
 * Las tres portadas llevan `transitionName` para morfear hacia la crónica al
 * abrirlas. Las tres son crónicas distintas (`latest` sale del mismo `slice(0,
 * 3)` que `previous`), así que ningún `view-transition-name` se repite en la
 * portada — un nombre duplicado cancelaría la transición de la página entera.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import NewsCard from '@components/common/NewsCard.astro';

type NewsEntry = CollectionEntry<'news'>;

const news = (await getCollection('news'))
  .filter((n: NewsEntry) => !n.data.draft)
  .sort((a: NewsEntry, b: NewsEntry) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const [latest, ...previous] = news;
---

{latest && (
  <SectionShell tone="muted" width="wide" labelledby="noticias-heading">
    <SectionIntro
      id="noticias-heading"
      eyebrow="Noticias"
      eyebrowIcon="ph:newspaper-bold"
      title="Lo último que pasó en carrera"
      highlight="en carrera"
      lead="Crónicas con nombres propios: quién corrió, cómo le fue y qué sigue."
      class="max-w-2xl"
    />

    <!-- Portada de periódico: la última ocupa el ancho completo y las
         anteriores quedan debajo. La talla `lead` reparte foto y texto en dos
         columnas, así que necesita el ancho entero para no estirar el afiche. -->
    <NewsCard
      variant="lead"
      class="reveal mt-10"
      href={`/noticias/${latest.id}`}
      transitionName={`news-img-${latest.id}`}
      title={latest.data.title}
      date={latest.data.date}
      category={latest.data.category}
      excerpt={latest.data.excerpt}
      image={latest.data.image}
      imageAlt={latest.data.imageAlt ?? latest.data.title}
      imageLayout={latest.data.imageLayout}
      body={latest.body}
    />

    {previous.length > 0 && (
      <ul class="mt-6 grid gap-6 sm:grid-cols-2">
        {previous.map((post: NewsEntry, index: number) => (
          <li class="reveal" style={`--stagger:${(index + 1) * 90}ms`}>
            <NewsCard
              href={`/noticias/${post.id}`}
              transitionName={`news-img-${post.id}`}
              title={post.data.title}
              date={post.data.date}
              category={post.data.category}
              excerpt={post.data.excerpt}
              image={post.data.image}
              imageAlt={post.data.imageAlt ?? post.data.title}
              imageLayout={post.data.imageLayout}
              body={post.body}
            />
          </li>
        ))}
      </ul>
    )}

    <p class="mt-10 text-center">
      <a
        href="/noticias"
        class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-deep px-5 py-2.5 font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white"
      >
        Ver todas las crónicas
        <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" />
      </a>
    </p>
  </SectionShell>
)}
