---
import { getCollection, type CollectionEntry } from 'astro:content';
import Card from '@components/common/Card.astro';
import Badge from '@components/common/Badge.astro';
import Button from '@components/common/Button.astro';
import SectionTitle from '@components/common/SectionTitle.astro';
import { formatDate } from '@lib/utils';

type NewsEntry = CollectionEntry<'news'>;

const allNews = (await getCollection('news'))
  .filter((n: NewsEntry) => !n.data.draft)
  .sort((a: NewsEntry, b: NewsEntry) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const [featuredNews, ...otherNews] = allNews;

const badgeVariant: Record<string, 'primary' | 'accent' | 'cyan' | 'neutral'> = {
  competencias: 'primary',
  club: 'cyan',
  entrenamiento: 'accent',
  comunidad: 'neutral',
};
---

<section class="py-20 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4">
    <SectionTitle title="Últimas Noticias" />

    {allNews.length > 0 && (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {allNews.map((news: NewsEntry) => (
          <Card href={`/noticias/${news.id}`} class="flex flex-col h-full">
            {news.data.image ? (
              <img
                src={news.data.image}
                alt={news.data.imageAlt ?? news.data.title}
                width="800"
                height="450"
                class="aspect-video w-full object-cover rounded-t-xl"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="aspect-video rounded-t-xl bg-surface-muted"></div>
            )}
            <div class="flex flex-col flex-grow p-6">
              <div class="mb-3">
                <Badge variant={badgeVariant[news.data.category] ?? 'neutral'}>
                  {news.data.category}
                </Badge>
              </div>
              <h3 class="font-display text-xl font-bold text-text-primary">
                {news.data.title}
              </h3>
              <p class="mt-3 text-text-secondary line-clamp-3 text-sm">
                {news.data.excerpt}
              </p>
              <div class="mt-auto pt-4">
                <time class="block text-xs font-medium text-text-secondary" datetime={news.data.date.toISOString()}>
                  {formatDate(news.data.date)}
                </time>
              </div>
            </div>
          </Card>
        ))}
      </div>
    )}

    <div class="mt-12 text-center">
      <Button href="/noticias" variant="outline">Ver todas las noticias</Button>
    </div>
  </div>
</section>
