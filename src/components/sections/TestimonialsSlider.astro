---
import { getCollection, type CollectionEntry } from 'astro:content';
import TestimonialsCarousel from '@components/interactive/TestimonialsCarousel.tsx';
import SectionTitle from '@components/common/SectionTitle.astro';

type Testimonial = CollectionEntry<'testimonials'>;

const testimonials = (await getCollection('testimonials'))
  .filter((t: Testimonial) => !t.data.draft)
  .sort((a: Testimonial, b: Testimonial) => a.data.order - b.data.order);

const testimonialData = testimonials.map((t: Testimonial) => ({
  id: t.id,
  name: t.data.name,
  roleLabel: t.data.roleLabel,
  quote: t.data.quote,
  photo: t.data.photo,
}));
---

<section class="bg-surface-dark py-20">
  <div class="max-w-4xl mx-auto px-4">
    <div class="[&_h2]:text-white [&_p]:text-white/70">
      <SectionTitle
        title="Lo que dicen las familias"
        subtitle="Testimonios de padres y corredores que hacen parte de nuestra comunidad"
      />
    </div>
    <TestimonialsCarousel client:visible testimonials={testimonialData} />
  </div>
</section>
