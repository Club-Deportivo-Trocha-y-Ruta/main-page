---
import { getCollection, type CollectionEntry } from 'astro:content';
import { CLUB_STATS, getYearsActive } from '@lib/constants';

// Los valores base son el acumulado histórico del club (fuente única en
// constants.ts). Si el contenido de las collections lo supera, se usa el mayor.
const yearsActive = getYearsActive();

// ─── Datos dinámicos desde collections ────────────────────────────────────────
const allRiders = await getCollection('riders');
const ridersCount = allRiders.filter((r: CollectionEntry<'riders'>) => !r.data.draft).length;

const allEvents = await getCollection('events');
const eventsCount = allEvents.filter((e: CollectionEntry<'events'>) => !e.data.draft).length;

// Usa el mayor entre el base histórico y el conteo dinámico
const ridersTarget = Math.max(CLUB_STATS.ridersTrained, ridersCount);
const eventsTarget = Math.max(CLUB_STATS.competitions, eventsCount);

const stats = [
  { value: `${yearsActive}+`, label: 'Años formando ciclistas', target: yearsActive, suffix: '+' },
  { value: `${ridersTarget}+`, label: 'Niños entrenados', target: ridersTarget, suffix: '+' },
  { value: `${eventsTarget}+`, label: 'Competencias', target: eventsTarget, suffix: '+' },
  { value: `${CLUB_STATS.medals}+`, label: 'Medallas ganadas', target: CLUB_STATS.medals, suffix: '+' },
];
---

<section class="bg-surface-muted py-16">
  <div class="mx-auto max-w-5xl px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {stats.map((stat) => (
        <div>
          <span
            class="block text-4xl md:text-5xl font-display font-bold text-primary"
            data-count-target={stat.target}
            data-count-suffix={stat.suffix}
          >
            0{stat.suffix}
          </span>
          <span class="mt-2 block text-sm md:text-base text-text-secondary font-medium">
            {stat.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  function initCounters() {
    const counters = document.querySelectorAll('[data-count-target]:not([data-counted])');
    if (!counters.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      counters.forEach(function (el) {
        el.textContent = el.dataset.countTarget + (el.dataset.countSuffix || '');
        el.dataset.counted = 'true';
      });
      return;
    }

    const observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          animateCount(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    counters.forEach(function (el) {
      observer.observe(el);
    });
  }

  function animateCount(el) {
    el.dataset.counted = 'true';
    var target = parseInt(el.dataset.countTarget, 10);
    var suffix = el.dataset.countSuffix || '';
    var duration = 1500;
    var start = performance.now();

    function update(now) {
      var elapsed = now - start;
      var progress = Math.min(elapsed / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      var current = Math.round(eased * target);
      el.textContent = current + suffix;
      if (progress < 1) requestAnimationFrame(update);
    }

    requestAnimationFrame(update);
  }

  initCounters();
  document.addEventListener('astro:page-load', initCounters);
</script>
