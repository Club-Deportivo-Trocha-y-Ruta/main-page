---
/**
 * La banda de credibilidad de la portada.
 *
 * Antes mostraba cuatro cifras que decían venir de las collections y no venían:
 * calculaba `Math.max(<constante>, conteo)`, pero los cinco corredores están
 * en `draft`, así que el conteo era 0 y la constante ganaba siempre. Y dos de
 * esas cifras —niños formados y medallas— se repetían más abajo, en
 * `AboutPreview`, y ninguna de las dos tenía fuente de verdad.
 *
 * Ahora enseña solo lo que el sitio puede probar, y cada cifra dice de dónde
 * sale y enlaza a la página donde se comprueba: la regla del sistema —toda
 * cifra sale del contenido— convertida en algo que el lector puede verificar.
 * Las cifras sin respaldo se eliminaron del sitio entero.
 *
 * El contador sigue animándose al entrar en pantalla, y respeta
 * `prefers-reduced-motion`. Antes lo hacía con un `<script is:inline>`
 * propio (IntersectionObserver + requestAnimationFrame); ahora usa la
 * utilidad CSS compartida `.count-up` de `global.css`
 * (docs/08-plan-creatividad-ui.md, Sprint 1 tarea 6, extraída de
 * `TrochaVerde.astro`): cero JS, mismo disparador `.reveal`/`.revealed` que
 * ya usa el resto del sitio. El tipo/tamaño de la cifra se deja igual que
 * antes (a propósito no se migró a `<StatFigure countUp>`: su escala
 * (`text-3xl sm:text-4xl`) es más chica que la de esta banda,
 * `text-4xl sm:text-5xl`, y no hay un pedido explícito de achicarla).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SectionShell from '@components/editorial/SectionShell.astro';
import { getYearsActive } from '@lib/constants';
import { buildClubFigures } from '@lib/home';
import { summarizeTrees } from '@lib/trocha-verde';

type Event = CollectionEntry<'events'>;
type Program = CollectionEntry<'programs'>;
type Tree = CollectionEntry<'trees'>;

const events = (await getCollection('events')).filter((e: Event) => !e.data.draft);
const trees = (await getCollection('trees')).filter((t: Tree) => !t.data.draft);
const programs = (await getCollection('programs'))
  .filter((p: Program) => !p.data.draft && p.data.active)
  .map((p: Program) => ({
    ageMin: p.data.ageMin,
    ageMax: p.data.ageMax,
    schedule: p.data.schedule,
    maxStudents: p.data.maxStudents,
  }));

const figures = buildClubFigures({
  years: getYearsActive(),
  programs,
  events,
  trees: summarizeTrees(trees.map((tree: Tree) => tree.data)).totalTrees,
});

// Fallback sin JS (mismo criterio que TrochaVerde.astro): sin el
// IntersectionObserver de BaseLayout.astro, `.revealed` no llega nunca y
// --count-value se quedaría en 0 para siempre; y la banda entera (recién
// convertida en `.reveal`) se quedaría invisible. Regla genérica, no por
// instancia: cubre las cuatro cifras. Va como string + `set:html` (no como
// <style is:inline> literal): un <style> real anidado dentro del
// `{figures.length > 0 && (...)}` de más abajo rompe el parser embebido de
// prettier-plugin-astro (repro mínimo, mismo hallazgo que en
// StatFigure.astro).
const countUpNoscript =
  '<style>.count-up__digits{--count-value:var(--count-target) !important}' +
  '.reveal{opacity:1 !important;transform:none !important}</style>';
---

{
  figures.length > 0 && (
    <SectionShell tone="plain" width="wide" spacing="compact" label="El club en cifras">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
        {figures.map((figure, index) => (
          <li class="reveal" style={`--stagger:${index * 80}ms`}>
            <a
              href={figure.href}
              class="group border-primary/25 hover:border-primary-deep focus-visible:outline-primary flex h-full flex-col border-l-2 pl-4 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              <Icon
                name={figure.icon}
                class="text-primary-deep size-5 shrink-0"
                aria-hidden="true"
              />

              <p class="font-display text-primary-deep mt-3 text-4xl leading-none font-extrabold sm:text-5xl">
                <span
                  class="count-up"
                  style={`--count-target:${figure.value};--count-digits:${String(figure.value).length}`}
                >
                  <span class="count-up__digits" aria-hidden="true" />
                  <span class="sr-only">{figure.value}</span>
                </span>
              </p>

              <p class="text-text-primary mt-2 text-sm leading-snug font-semibold sm:text-base">
                {figure.label}
              </p>
              <p class="text-text-secondary mt-1 text-xs leading-snug">{figure.note}</p>

              <span class="text-primary-deep mt-auto flex items-center gap-1 pt-3 text-xs font-semibold opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
                Compruébalo
                <Icon name="ph:arrow-right-bold" class="size-3.5" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>

      {
        // No autocerrar este <noscript>: prettier-plugin-astro reescribe la forma
        // abierta a `<noscript ... />` con --write y luego no logra parsear esa
        // forma (SyntaxError en --check). Verificado 2026-08-26 en las dos
        // direcciones; Astro compila cualquiera de las dos.
      }
      <noscript set:html={countUpNoscript}></noscript>
    </SectionShell>
  )
}
