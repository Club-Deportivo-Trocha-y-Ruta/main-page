---
import { getCollection, type CollectionEntry } from 'astro:content';

// ─── Valores base históricos del club ─────────────────────────────────────────
// Estos representan el acumulado real que el club conoce de sus 15+ años.
// Actualizar manualmente cuando se tengan cifras más precisas.
// Si el contenido de las collections supera estos valores, se usa el mayor.
const BASE_STATS = {
  riders: 80,        // niños que han pasado por el club desde 2010
  events: 50,        // competencias en las que ha participado el club
  medals: 100,       // medallas/podios acumulados
};

// ─── Años activos (siempre dinámico) ──────────────────────────────────────────
const FOUNDING_DATE = new Date(2010, 4, 1); // 1 de mayo de 2010
const now = new Date();
const yearsActive = now.getFullYear() - FOUNDING_DATE.getFullYear()
  - (now < new Date(now.getFullYear(), FOUNDING_DATE.getMonth(), FOUNDING_DATE.getDate()) ? 1 : 0);

// ─── Datos dinámicos desde collections ────────────────────────────────────────
const allRiders = await getCollection('riders');
const ridersCount = allRiders.filter((r: CollectionEntry<'riders'>) => !r.data.draft).length;

const allEvents = await getCollection('events');
const eventsCount = allEvents.filter((e: CollectionEntry<'events'>) => !e.data.draft).length;

// Usa el mayor entre el base histórico y el conteo dinámico
const stats = [
  { value: `${yearsActive}+`, label: 'Años formando ciclistas' },
  { value: `${Math.max(BASE_STATS.riders, ridersCount)}+`, label: 'Niños entrenados' },
  { value: `${Math.max(BASE_STATS.events, eventsCount)}+`, label: 'Competencias' },
  { value: `${BASE_STATS.medals}+`, label: 'Medallas ganadas' },
];
---

<section class="bg-surface-muted py-16">
  <div class="mx-auto max-w-5xl px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {stats.map((stat) => (
        <div>
          <span class="block text-4xl md:text-5xl font-display font-bold text-primary">
            {stat.value}
          </span>
          <span class="mt-2 block text-sm text-text-secondary">
            {stat.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
