---
interface Props {}

const stats = [
  { value: '15+', label: 'Años formando ciclistas' },
  { value: '200+', label: 'Niños entrenados' },
  { value: '50+', label: 'Competencias' },
  { value: '100+', label: 'Medallas ganadas' },
];
---

<section class="bg-surface-muted py-16">
  <div class="mx-auto max-w-5xl px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {stats.map((stat) => (
        <div>
          <span class="block text-4xl md:text-5xl font-display font-bold text-primary">
            {stat.value}
          </span>
          <span class="mt-2 block text-sm text-text-secondary">
            {stat.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
