---
/**
 * La banda de credibilidad de la portada.
 *
 * Antes mostraba cuatro cifras que decían venir de las collections y no venían:
 * calculaba `Math.max(<constante>, conteo)`, pero los cinco corredores están
 * en `draft`, así que el conteo era 0 y la constante ganaba siempre. Y dos de
 * esas cifras —niños formados y medallas— se repetían más abajo, en
 * `AboutPreview`, y ninguna de las dos tenía fuente de verdad.
 *
 * Ahora enseña solo lo que el sitio puede probar, y cada cifra dice de dónde
 * sale y enlaza a la página donde se comprueba: la regla del sistema —toda
 * cifra sale del contenido— convertida en algo que el lector puede verificar.
 * Las cifras sin respaldo se eliminaron del sitio entero.
 *
 * El contador sigue animándose al entrar en pantalla, y respeta
 * `prefers-reduced-motion`.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SectionShell from '@components/editorial/SectionShell.astro';
import { getYearsActive } from '@lib/constants';
import { buildClubFigures } from '@lib/home';
import { summarizeTrees } from '@lib/trocha-verde';

type Event = CollectionEntry<'events'>;
type Program = CollectionEntry<'programs'>;
type Tree = CollectionEntry<'trees'>;

const events = (await getCollection('events')).filter((e: Event) => !e.data.draft);
const trees = (await getCollection('trees')).filter((t: Tree) => !t.data.draft);
const programs = (await getCollection('programs'))
  .filter((p: Program) => !p.data.draft && p.data.active)
  .map((p: Program) => ({
    ageMin: p.data.ageMin,
    ageMax: p.data.ageMax,
    schedule: p.data.schedule,
    maxStudents: p.data.maxStudents,
  }));

const figures = buildClubFigures({
  years: getYearsActive(),
  programs,
  events,
  trees: summarizeTrees(trees.map((tree: Tree) => tree.data)).totalTrees,
});
---

{
  figures.length > 0 && (
    <SectionShell tone="plain" width="wide" spacing="compact" label="El club en cifras">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
        {figures.map((figure) => (
          <li>
            <a
              href={figure.href}
              class="group flex h-full flex-col border-l-2 border-primary/25 pl-4 transition-colors duration-200 hover:border-primary-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <Icon
                name={figure.icon}
                class="size-5 shrink-0 text-primary-deep"
                aria-hidden="true"
              />

              <p class="mt-3 font-display text-4xl font-extrabold leading-none text-primary-deep sm:text-5xl">
                <span data-count-target={figure.value} data-count-suffix="">
                  {figure.value}
                </span>
              </p>

              <p class="mt-2 text-sm font-semibold leading-snug text-text-primary sm:text-base">
                {figure.label}
              </p>
              <p class="mt-1 text-xs leading-snug text-text-secondary">{figure.note}</p>

              <span class="mt-auto flex items-center gap-1 pt-3 text-xs font-semibold text-primary-deep opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
                Compruébalo
                <Icon name="ph:arrow-right-bold" class="size-3.5" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </SectionShell>
  )
}

<script is:inline>
  function initCounters() {
    const counters = document.querySelectorAll('[data-count-target]:not([data-counted])');
    if (!counters.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      counters.forEach(function (el) {
        el.textContent = el.dataset.countTarget + (el.dataset.countSuffix || '');
        el.dataset.counted = 'true';
      });
      return;
    }

    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            animateCount(entry.target);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.5 }
    );

    counters.forEach(function (el) {
      observer.observe(el);
    });
  }

  function animateCount(el) {
    el.dataset.counted = 'true';
    var target = parseInt(el.dataset.countTarget, 10);
    var suffix = el.dataset.countSuffix || '';
    var duration = 1500;
    var start = performance.now();

    function update(now) {
      var elapsed = now - start;
      var progress = Math.min(elapsed / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      var current = Math.round(eased * target);
      el.textContent = current + suffix;
      if (progress < 1) requestAnimationFrame(update);
    }

    requestAnimationFrame(update);
  }

  initCounters();
  document.addEventListener('astro:page-load', initCounters);
</script>
