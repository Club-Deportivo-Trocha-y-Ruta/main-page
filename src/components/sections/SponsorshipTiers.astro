---
import { CONTACT } from '@lib/constants';

const tiers = [
  {
    name: 'Principal',
    icon: '🏆',
    highlighted: true,
    benefits: [
      'Logo destacado en uniforme oficial',
      'Presencia en todos los eventos',
      'Logo prominente en sitio web',
      'Menciones en redes sociales',
      'Banner en competencias',
      'Reportes de impacto trimestrales',
    ],
  },
  {
    name: 'Oficial',
    icon: '🥇',
    highlighted: false,
    benefits: [
      'Logo en sitio web',
      'Presencia en eventos principales',
      'Menciones en redes sociales',
      'Logo en material promocional',
    ],
  },
  {
    name: 'Aliado',
    icon: '🤝',
    highlighted: false,
    benefits: [
      'Logo en sitio web',
      'Mención en redes sociales',
      'Logo en material impreso',
    ],
  },
  {
    name: 'Proveedor',
    icon: '🔧',
    highlighted: false,
    benefits: [
      'Reconocimiento como proveedor oficial',
      'Logo en sección de proveedores',
      'Mención en eventos relevantes',
    ],
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
  {tiers.map((tier) => {
    const whatsappMsg = encodeURIComponent(`Hola, quiero información sobre el patrocinio nivel ${tier.name}`);
    const whatsappUrl = `${CONTACT.whatsapp}?text=${whatsappMsg}`;

    return (
      <div
        class={[
          'rounded-xl border p-6 bg-white shadow-sm flex flex-col',
          tier.highlighted
            ? 'border-primary ring-2 ring-primary/20 relative'
            : 'border-surface-muted',
        ].join(' ')}
      >
        {tier.highlighted && (
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap">
            Mas popular
          </span>
        )}

        <div class="text-center mb-5">
          <span class="text-4xl" role="img" aria-label={`Nivel ${tier.name}`}>
            {tier.icon}
          </span>
          <h3 class="mt-3 text-xl font-display font-bold text-text-primary">
            {tier.name}
          </h3>
        </div>

        <ul class="flex-1 space-y-2.5 mb-6" role="list">
          {tier.benefits.map((benefit) => (
            <li class="flex items-start gap-2 text-sm text-text-secondary">
              <svg
                class="w-4 h-4 text-accent shrink-0 mt-0.5"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={[
            'block w-full text-center rounded-lg font-semibold text-sm py-2.5 px-4',
            'transition-colors duration-200',
            'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
            tier.highlighted
              ? 'bg-primary text-white hover:bg-primary-dark'
              : 'border-2 border-primary text-primary hover:bg-primary hover:text-white',
          ].join(' ')}
        >
          Quiero ser {tier.name}
        </a>
      </div>
    );
  })}
</div>
