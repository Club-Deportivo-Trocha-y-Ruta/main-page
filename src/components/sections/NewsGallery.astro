---
import { getCollection } from 'astro:content';
import ImageLightbox from '@components/interactive/ImageLightbox.tsx';

interface Props {
  /** Carpeta dentro de /images/ con las fotos */
  imageFolder: string;
  /** Lista de nombres de archivo */
  imageFiles: string[];
  /** Alt texts opcionales por imagen, mismo orden que imageFiles */
  imageAlts?: string[];
  /** Alt fallback cuando no hay imageAlts. Se usa con índice (1-based). */
  altFallback?: string;
  /** Máximo de fotos visibles en el grid antes de "ver más" */
  maxVisible?: number;
  /** Slug del album en /galeria/ para enlazar */
  albumSlug?: string;
  /** Título de la sección */
  title?: string;
}

const {
  imageFolder,
  imageFiles,
  imageAlts = [],
  altFallback,
  maxVisible = 9,
  albumSlug,
  title = 'Fotos del evento',
} = Astro.props;

const allImages = imageFiles.map((file, index) => {
  const customAlt = imageAlts[index];
  const fallback = altFallback
    ? `${altFallback} — foto ${index + 1} de ${imageFiles.length}`
    : file.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ');
  return {
    src: `${imageFolder}/${file}`,
    alt: customAlt || fallback,
  };
});

const hasMore = allImages.length > maxVisible;

// Solo enlazamos al álbum si existe y está publicado: un slug mal escrito en el
// frontmatter de la noticia produciría un 404. El botón anuncia las fotos del
// álbum, no las de esta rejilla: la crónica suele embeber varias en el cuerpo y
// listar aquí solo el resto, y el álbum las tiene todas.
const album = albumSlug
  ? (await getCollection('gallery')).find((entry) => entry.id === albumSlug && !entry.data.draft)
  : undefined;
const showAlbumLink = Boolean(album) && hasMore;
const albumPhotoCount = album?.data.images.length ?? allImages.length;
---

<section class="border-surface-muted mt-12 border-t pt-8" aria-labelledby="news-gallery-title">
  <h2 id="news-gallery-title" class="font-display mb-6 text-2xl font-bold">
    {title}
    <span class="text-text-secondary ml-2 text-base font-normal">
      ({allImages.length} fotos)
    </span>
  </h2>

  <!-- `news-gallery-grid` es solo un gancho CSS: el island `ImageLightbox` no
       se toca (mismo criterio documentado en `/galeria/[...slug].astro`, que
       lo reutiliza "sin tocar"), así que el detalle de álbum —que monta el
       mismo componente sin esta clase— no hereda el efecto polaroid. -->
  <div class="news-gallery-grid">
    <ImageLightbox client:visible images={allImages} />
  </div>

  {
    showAlbumLink && (
      <div class="mt-6 text-center">
        <a
          href={`/galeria/${albumSlug}`}
          class="border-primary text-primary hover:bg-primary inline-flex items-center gap-2 rounded-lg border-2 px-6 py-3 font-semibold transition-colors hover:text-white"
        >
          Ver álbum completo ({albumPhotoCount} fotos)
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>
    )
  }
</section>

<style is:global>
  /* Efecto polaroid de las miniaturas (docs/08 tarea 11). `is:global` a
     propósito: los `<button>` de la rejilla los renderiza el island React
     `ImageLightbox`, no esta plantilla, así que el scoping normal de Astro
     —que solo marca con su atributo los elementos que el propio componente
     imprime— nunca los alcanzaría y la regla quedaría muerta. El selector
     va acotado a `.news-gallery-grid` (el wrapper de arriba), así que no
     sangra hacia el mismo island montado en `/galeria/[...slug].astro`.
     La rotación va en el `<button>`, nunca en el `<img>` de adentro (ahí
     vive el `group-hover:scale-105` propio del componente): son elementos
     distintos, así que `rotate` y `scale` no compiten por la misma
     declaración y Lightning CSS no las colapsa (la trampa documentada en la
     tarea 9). El marco blanco es `padding` (más grueso abajo, como el
     reverso en blanco de una polaroid) sobre fondo `--color-surface`: el
     `<img>` de adentro no es absoluto, así que un padding en el botón ya lo
     deja inscrito sin tocar el componente. El marco (fondo + padding) es
     estático —no es animación— así que va en una regla base incondicional;
     solo la transición y la rotación quedan detrás de la media query,
     igual que el margen incondicional + rotación condicional de
     AlbumCard.astro. El selector lleva además `[type="button"]`: el mismo
     island también imprime el modal (cerrar/anterior/siguiente) dentro de
     este wrapper, y esos tres `<button>` no traen ese atributo —solo la
     miniatura de la rejilla lo tiene explícito (ver ImageLightbox.tsx)—,
     así que sin el calificador el polaroid se filtraba a los controles del
     visor. */
  .news-gallery-grid button[type='button'] {
    background-color: var(--color-surface);
    padding: 0.5rem 0.5rem 1rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .news-gallery-grid button[type='button'] {
      transition: rotate var(--duration-micro) var(--ease-spring);
    }

    .news-gallery-grid button[type='button']:where(:nth-child(odd)) {
      rotate: -1.5deg;
    }

    .news-gallery-grid button[type='button']:where(:nth-child(even)) {
      rotate: 1.2deg;
    }

    .news-gallery-grid button[type='button']:hover,
    .news-gallery-grid button[type='button']:focus-visible {
      rotate: 0deg;
    }
  }
</style>
