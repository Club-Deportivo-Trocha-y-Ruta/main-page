---
import SectionTitle from '@components/common/SectionTitle.astro';
import VideoFacade from '@components/common/VideoFacade.astro';
import Button from '@components/common/Button.astro';
import { SOCIAL } from '@lib/constants';

const videos = [
  {
    id: 'dQw4w9WgXcQ',
    title: 'Entrenamiento semanal',
  },
  {
    id: 'dQw4w9WgXcQ',
    title: 'Copa Valle XCO 2026',
  },
];
---

<section class="py-16 px-4 bg-surface-muted/40">
  <div class="max-w-5xl mx-auto">
    <SectionTitle
      title="El Club en Acción"
      subtitle="Conoce nuestras actividades, entrenamientos y competencias"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      {videos.map((video) => (
        <VideoFacade
          videoId={video.id}
          title={video.title}
          thumbnailQuality="hq"
        />
      ))}
    </div>

    <div class="flex justify-center">
      <Button
        href={SOCIAL.youtube}
        variant="outline"
        size="md"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-5 h-5 mr-2"
          aria-hidden="true"
        >
          <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z" />
        </svg>
        Ver más videos en YouTube
      </Button>
    </div>
  </div>
</section>
