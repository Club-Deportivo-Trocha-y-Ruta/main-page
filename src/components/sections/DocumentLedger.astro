---
/**
 * Ledger de documentos de Transparencia: una categoría a la vez.
 *
 * El corazón del encargo: antes de listar los PDF, cada categoría explica a
 * qué pregunta responde. Nadie debería tener que abrir "ECF Club Trocha y
 * Ruta 2024" para enterarse de que es un estado de cambios financieros —el
 * propósito de la categoría ya lo dice—. Cada ficha, además, muestra nombre,
 * para qué sirve, vigencia cuando la hay, tipo de archivo y el peso real
 * leído del disco en build (o lo omite si el archivo no aparece).
 */
import { Icon } from 'astro-icon/components';
import { getTone, type SectionTone } from '@lib/editorial';
import { slugify } from '@lib/utils';
import { fileType, type DocumentGroup, type TransparencyDocumentWithSize } from '@lib/transparency';

interface Props {
  groups: DocumentGroup<TransparencyDocumentWithSize>[];
  tone?: SectionTone;
  class?: string;
}

const { groups, tone = 'plain', class: className } = Astro.props;
const tokens = getTone(tone);
---

{groups.length > 0 && (
  <div class:list={['space-y-12', className]}>
    {groups.map((group) => {
      const headingId = `categoria-${slugify(group.categoria)}-titulo`;
      return (
        <section aria-labelledby={headingId}>
          <div class="flex items-start gap-3">
            <span
              class:list={[
                'flex size-10 shrink-0 items-center justify-center rounded-xl',
                tokens.inverted ? 'bg-white/10 text-accent-light' : 'bg-primary/10 text-primary-deep',
              ]}
              aria-hidden="true"
            >
              <Icon name={group.profile.icon} class="size-5" />
            </span>
            <div class="min-w-0">
              <h3
                id={headingId}
                class:list={['font-display text-lg font-bold sm:text-xl', tokens.heading]}
              >
                {group.profile.label}
              </h3>
              <p class:list={['mt-1 max-w-2xl text-sm leading-relaxed', tokens.muted]}>
                {group.profile.purpose}
              </p>
            </div>
          </div>

          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {group.documents.map((doc) => {
              const type = fileType(doc.archivo);
              return (
                <li>
                  <article
                    class:list={[
                      'flex h-full flex-col gap-3 rounded-2xl border p-4 sm:p-5',
                      tokens.hairline,
                      tokens.card,
                    ]}
                  >
                    <div class="flex items-start gap-3">
                      <Icon
                        name="ph:file-pdf-bold"
                        class:list={['mt-0.5 size-5 shrink-0', tokens.inverted ? 'text-accent-light' : 'text-primary-deep']}
                        aria-hidden="true"
                      />
                      <div class="min-w-0">
                        <h4 class:list={['text-sm font-semibold leading-snug', tokens.heading]}>
                          {doc.nombre}
                        </h4>
                        <p class:list={['mt-1 text-xs leading-relaxed', tokens.muted]}>
                          {doc.descripcion}
                        </p>
                      </div>
                    </div>

                    <div
                      class:list={[
                        'flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-semibold uppercase tracking-wide',
                        tokens.muted,
                      ]}
                    >
                      {doc.anio !== null && <span>Vigencia {doc.anio}</span>}
                      <span>{type}</span>
                      {doc.sizeLabel && <span>{doc.sizeLabel}</span>}
                    </div>

                    <a
                      href={doc.archivo}
                      download
                      data-analytics-event="transparencia_pdf_download"
                      data-analytics-pdf-name={doc.nombre}
                      aria-label={`Descargar ${doc.nombre} en ${type}${doc.sizeLabel ? `, ${doc.sizeLabel}` : ''}`}
                      class="mt-auto inline-flex w-fit items-center justify-center gap-2 rounded-lg border-2 border-primary-deep px-4 py-2 text-sm font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                    >
                      <Icon name="ph:download-simple-bold" class="size-4" aria-hidden="true" />
                      Descargar
                    </a>
                  </article>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
)}
