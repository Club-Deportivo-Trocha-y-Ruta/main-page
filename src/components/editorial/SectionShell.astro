---
/**
 * Marco de sección del sistema editorial.
 *
 * Resuelve fondo, aire vertical, ancho de contenido y textura decorativa a
 * partir de variantes, para que ninguna sección tenga que inventar clases.
 * El `<section>` siempre ocupa el ancho completo; el contenido se centra según
 * `width`.
 *
 * Ver docs/04-sistema-editorial.md.
 */
import { getImage } from 'astro:assets';
import cerroYumbo from '@assets/images/yumbo/cerro-yumbo-solid.webp';
import {
  getTone,
  getWidth,
  getSpacing,
  uniqueSvgId,
  TOPO_PATHS,
  TOPO_TILE,
  type SectionTone,
  type SectionPattern,
  type SectionWidth,
  type SectionSpacing,
} from '@lib/editorial';

interface Props {
  tone?: SectionTone;
  pattern?: SectionPattern;
  width?: SectionWidth;
  spacing?: SectionSpacing;
  id?: string;
  /** id del titular que nombra la sección (accesibilidad). */
  labelledby?: string;
  /** Nombre de la sección cuando no hay titular visible. */
  label?: string;
  class?: string;
  /** Clases extra para el contenedor interno. */
  innerClass?: string;
  /**
   * Habilita animaciones ligadas al scroll dentro de la sección.
   *
   * Hace dos cosas: recorta con `overflow-clip` en vez de `overflow-hidden`
   * —`hidden` crea un contenedor de scroll y `view()` se ancla a él en vez de
   * al viewport, dejando cualquier animación congelada— y le da deriva vertical
   * a la textura de fondo cuando hay `pattern="topo"`.
   *
   * Es opt-in y decorativo: sin soporte de scroll-driven animations o con
   * `prefers-reduced-motion`, todo queda quieto y en su sitio.
   */
  scrollDriven?: boolean;
  /**
   * Cualquier `data-*` extra viaja al `<section>` tal cual.
   *
   * Existe para que una página pueda etiquetar sus secciones con datos que solo
   * ella entiende —hoy, el rango de edades que cubre cada programa, que el CSS
   * del selector de `/programas` lee con `[data-ages~="7"]`— sin que el marco
   * editorial tenga que aprenderse el vocabulario de cada página.
   */
  [key: `data-${string}`]: string | number | undefined;
}

const {
  tone = 'plain',
  pattern = 'none',
  width = 'default',
  spacing = 'default',
  id,
  labelledby,
  label,
  class: className,
  innerClass,
  scrollDriven = false,
  ...dataAttrs
} = Astro.props;

const tokens = getTone(tone);
const patternId = uniqueSvgId('topo');

// La silueta del cerro va como máscara sobre el color del tono. El CSS vive en
// `.yumbo-skyline` (global.css): necesita `@supports` y una máscara compuesta,
// que un `style` inline no puede declarar. Aquí solo viaja la URL del asset.
const skyline =
  pattern === 'yumbo'
    ? await getImage({ src: cerroYumbo, width: 1200, format: 'webp' })
    : undefined;

// Alto de la lámina por corte. Con su proporción (2.62:1) da 250 px de ancho en
// móvil y 545 px en escritorio: se lee el cerro y el letrero sin convertirse en
// un mural. Cambiar un valor obliga a cambiar la reserva de abajo.
const SKYLINE_HEIGHT = 'h-24 sm:h-36 md:h-44 lg:h-52';

// Lo que el contenido deja libre por debajo para que la lámina no le pase por
// detrás. Se suma al padding del `spacing` de la sección; está calibrado para
// que incluso con `spacing="compact"` (py-12 md:py-16) la cima quede libre:
//   móvil 48+80 ≥ 96 · sm 48+112 ≥ 144 · md 64+128 ≥ 176 · lg 64+144 ≥ 208.
const SKYLINE_RESERVE = 'pb-20 sm:pb-28 md:pb-32 lg:pb-36';
---

<section
  id={id}
  aria-labelledby={labelledby}
  aria-label={label}
  {...dataAttrs}
  class:list={[
    'relative isolate',
    scrollDriven ? 'overflow-clip' : 'overflow-hidden',
    tokens.surface,
    getSpacing(spacing),
    className,
  ]}
>
  {
    pattern === 'topo' && (
      <svg
        class:list={[
          'pointer-events-none absolute -z-10 w-full',
          tokens.pattern,
          // Con deriva la textura se pinta más alta que la sección para que el
          // desplazamiento nunca descubra una franja sin patrón.
          scrollDriven
            ? 'sda-parallax-slow inset-x-0 -top-8 h-[calc(100%+4rem)]'
            : 'inset-0 h-full',
        ]}
        aria-hidden="true"
        focusable="false"
        style="mask-image: linear-gradient(to bottom, black, transparent 78%);"
      >
        <defs>
          <pattern
            id={patternId}
            width={TOPO_TILE}
            height={TOPO_TILE}
            patternUnits="userSpaceOnUse"
          >
            {TOPO_PATHS.map((d) => (
              <path d={d} fill="none" stroke="currentColor" stroke-width="1.25" />
            ))}
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#${patternId})`} />
      </svg>
    )
  }

  {
    skyline && (
      <span
        class:list={[
          // La caja tiene la proporción exacta de la lámina (aspect-ratio) y se
          // centra sola: así el degradado lateral de `.yumbo-skyline` funde los
          // bordes del cerro —la lámina es un rectángulo con la cima recortada—
          // y no los del viewport, y el centro coincide con el de la columna de
          // contenido en cualquier ancho de pantalla.
          'yumbo-mask yumbo-skyline pointer-events-none absolute bottom-0 left-1/2 -z-10 -translate-x-1/2',
          SKYLINE_HEIGHT,
          tokens.skyline,
        ]}
        aria-hidden="true"
        style={`aspect-ratio:${cerroYumbo.width} / ${cerroYumbo.height};--yumbo-mask:url(${skyline.src})`}
      />
    )
  }

  <div
    class:list={[
      'mx-auto px-4 sm:px-6 lg:px-8',
      getWidth(width),
      // El horizonte tiene su propia banda: el contenido termina antes de que
      // empiece la lámina, en vez de taparla.
      skyline && SKYLINE_RESERVE,
      innerClass,
    ]}
  >
    <slot />
  </div>
</section>
