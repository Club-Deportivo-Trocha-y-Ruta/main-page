---
/**
 * Rejilla de datos duros con icono: los hechos que una familia necesita para
 * decidir (edades, horario, lugar, costo) sin tener que leer un párrafo.
 *
 * Cada par va en un `<div>` hijo directo del `<dl>`: es la única anidación que
 * el HTML permite dentro de una lista de definición.
 */
import { Icon } from 'astro-icon/components';
import { getTone, type SectionTone } from '@lib/editorial';

export interface Fact {
  icon: string;
  label: string;
  value: string;
}

/** A partir de aquí un valor ocupa toda la fila en vez de partirse en cinco líneas. */
const LONG_VALUE = 48;

interface Props {
  items: (Fact | null | undefined)[];
  columns?: 1 | 2 | 3;
  tone?: SectionTone;
  class?: string;
}

const { items, columns = 2, tone = 'plain', class: className } = Astro.props;

const tokens = getTone(tone);
const facts = items.filter((item): item is Fact => Boolean(item?.value));

const columnClass: Record<number, string> = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
};
---

{facts.length > 0 && (
  <dl class:list={['grid gap-x-6 gap-y-4', columnClass[columns] ?? columnClass[2], className]}>
    {facts.map((fact) => (
      <div
        class:list={[
          'border-l-2 pl-3',
          tokens.hairline,
          columns > 1 && fact.value.length > LONG_VALUE && 'sm:col-span-2',
        ]}
      >
        <dt
          class:list={[
            'flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider',
            tokens.muted,
          ]}
        >
          <Icon
            name={fact.icon}
            class:list={['size-3.5 shrink-0', tokens.inverted ? 'text-accent-light' : 'text-primary-deep']}
            aria-hidden="true"
          />
          {fact.label}
        </dt>
        <dd class:list={['mt-1 text-sm font-semibold leading-snug', tokens.heading]}>
          {fact.value}
        </dd>
      </div>
    ))}
  </dl>
)}
