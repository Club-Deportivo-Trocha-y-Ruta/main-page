---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;

const classes = [
  'block rounded-xl bg-surface shadow-sm transition-all duration-200',
  href ? 'cursor-pointer hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 active:shadow-sm' : 'hover:shadow-md',
  className,
].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <div class={classes}>
    <slot />
  </div>
)}
