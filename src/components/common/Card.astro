---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;

const classes = [
  'block rounded-xl bg-surface shadow-sm transition-shadow duration-200 hover:shadow-md',
  className,
].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <div class={classes}>
    <slot />
  </div>
)}
