---
import { Image } from 'astro:assets';
import logo from '@assets/images/logo.webp';
import { NAV_ITEMS, SECONDARY_NAV } from '@lib/constants';
import MobileMenu from '../interactive/MobileMenu';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-surface/95 backdrop-blur-sm shadow-sm">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <Image
          src={logo}
          alt="Club Deportivo Trocha y Ruta"
          width={140}
          height={140}
          class="h-12 w-auto"
          loading="eager"
        />
      </a>

      <!-- Nav desktop -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
        {NAV_ITEMS.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-md text-sm font-medium transition-colors',
                isActive
                  ? 'text-primary font-semibold'
                  : 'text-text-secondary hover:text-primary hover:bg-primary/5',
              ]}
              {...(isActive ? { 'aria-current': 'page' } : {})}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA + hamburguesa -->
      <div class="flex items-center gap-3">
        <a
          href="/inscripciones"
          class="hidden sm:inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Inscríbete
        </a>

        <!-- Mobile menu (React Island) -->
        <div class="lg:hidden">
          <MobileMenu
            client:load
            navItems={NAV_ITEMS.map(i => ({ label: i.label, href: i.href }))}
            secondaryNavItems={SECONDARY_NAV.map(i => ({ label: i.label, href: i.href }))}
            currentPath={currentPath}
          />
        </div>
      </div>
    </div>
  </div>
</header>
