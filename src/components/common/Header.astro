---
import { Image } from 'astro:assets';
import logo from '@assets/images/logo.webp';
import { NAV_ITEMS, SECONDARY_NAV } from '@lib/constants';
import MobileMenu from '../interactive/MobileMenu';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-surface/95 backdrop-blur-sm shadow-sm">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex min-h-16 items-center justify-between py-2">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <Image
          src={logo}
          alt="Club Deportivo Trocha y Ruta"
          width={140}
          height={140}
          class="h-12 w-auto"
          loading="eager"
        />
      </a>

      <!-- Nav desktop -->
      <nav class="hidden lg:flex items-center bg-surface-muted/60 backdrop-blur-sm rounded-full px-2 py-1 gap-0.5" aria-label="Navegación principal">
        {NAV_ITEMS.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200',
                isActive
                  ? 'bg-surface text-primary font-semibold shadow-sm'
                  : 'text-text-secondary hover:text-primary hover:bg-surface/60',
              ]}
              {...(isActive ? { 'aria-current': 'page' } : {})}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA + hamburguesa -->
      <div class="flex items-center gap-3">
        <a
          href="/inscripciones"
          class="hidden sm:inline-flex items-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-surface-dark transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Inscríbete
          <svg class="ml-1 w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
        </a>

        <!-- Mobile menu (React Island) -->
        <div class="lg:hidden">
          <MobileMenu
            client:load
            navItems={NAV_ITEMS.map(i => ({ label: i.label, href: i.href }))}
            secondaryNavItems={SECONDARY_NAV.map(i => ({ label: i.label, href: i.href }))}
            currentPath={currentPath}
          />
        </div>
      </div>
    </div>
  </div>
</header>
