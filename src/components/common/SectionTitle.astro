---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'center' } = Astro.props;

const alignClass = align === 'center' ? 'text-center' : 'text-left';
const lineAlign = align === 'center' ? 'mx-auto' : '';
---

<div class={`mb-10 ${alignClass}`}>
  <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary">
    {title}
  </h2>
  <div class={`mt-3 h-1 w-16 rounded-full bg-accent ${lineAlign}`}></div>
  {subtitle && (
    <p class="mt-4 text-lg text-text-secondary max-w-2xl mx-auto">
      {subtitle}
    </p>
  )}
</div>
