---
/**
 * Mide hasta dónde lee la gente y emite `scroll_depth` en los umbrales 25/50/75/100.
 *
 * Vivía duplicado dentro de `noticias/[...slug].astro`, que era además la única
 * página instrumentada: entre mayo y agosto de 2026 se recogieron 655 eventos de
 * crónicas y ni uno solo de la portada, de programas o de Trocha Verde. Extraerlo
 * permite medir cualquier página sin volver a copiar el script.
 *
 * **El target va en el DOM, no en el script.** Es deliberado. La versión anterior
 * lo pasaba con `define:vars`, y eso no funciona bajo `ClientRouter`: Astro
 * reescribe la etiqueta del script para inyectar las variables —perdiendo por el
 * camino `data-astro-rerun`— y el bloque no se reejecuta al intercambiar el
 * documento. Resultado comprobado en navegación real: al pasar de /programas a
 * /trocha-verde la medición se apagaba. El DOM sí se intercambia siempre, así que
 * leer el target de un marcador es inmune al problema y además deja el script
 * idéntico en todas las páginas.
 *
 * Frente al original se corrige también la acumulación de listeners: antes cada
 * navegación registraba uno nuevo sin retirar el anterior, así que una misma
 * lectura podía contarse varias veces.
 *
 * El parámetro `depth` solo es explotable si la dimensión personalizada homónima
 * está registrada en GA4 (Administrar › Definiciones personalizadas).
 */
interface Props {
  /** Selector del bloque cuya lectura se mide. */
  target?: string;
}

const { target = 'main' } = Astro.props;
---

<div data-scroll-depth-target={target} hidden></div>

<script is:inline>
  (function () {
    const state = (window.__trochaScrollDepth = window.__trochaScrollDepth || {});
    if (state.bootstrapped) return;
    state.bootstrapped = true;

    const DEPTHS = [25, 50, 75, 100];
    const MARKER = '[data-scroll-depth-target]';

    function stop() {
      if (!state.cleanup) return;
      state.cleanup();
      state.cleanup = null;
    }

    function start() {
      stop();

      // La página entrante decide si se mide y qué se mide. Si no monta el
      // componente, el marcador no existe y la medición simplemente no arranca,
      // en vez de seguir atribuyendo scroll al target de la página anterior.
      const marker = document.querySelector(MARKER);
      state.target = marker ? marker.getAttribute('data-scroll-depth-target') : null;
      if (!state.target) return;

      const el = document.querySelector(state.target);
      if (!el) return;

      const fired = new Set();
      const controller = new AbortController();
      state.cleanup = function () {
        controller.abort();
      };

      function check() {
        const rect = el.getBoundingClientRect();
        const total = rect.height;
        if (total <= 0) return;

        const scrolled = Math.min(Math.max(-rect.top + window.innerHeight, 0), total);
        const pct = Math.round((scrolled / total) * 100);

        for (const d of DEPTHS) {
          if (pct >= d && !fired.has(d)) {
            fired.add(d);
            if (typeof window.__trochaEmit === 'function') {
              window.__trochaEmit('scroll_depth', { depth: d });
            }
          }
        }

        if (fired.size === DEPTHS.length) stop();
      }

      let ticking = false;
      window.addEventListener(
        'scroll',
        function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            check();
            ticking = false;
          });
        },
        { passive: true, signal: controller.signal }
      );

      check();
    }

    // El listener de la página que se abandona deja de ser válido antes del swap.
    document.addEventListener('astro:before-swap', stop);
    document.addEventListener('astro:page-load', start);

    // Red de seguridad para el primer render, por si `astro:page-load` ya pasó.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>
