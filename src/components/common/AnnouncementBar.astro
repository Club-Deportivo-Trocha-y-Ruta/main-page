---
import { getCollection, type CollectionEntry } from 'astro:content';

const allEvents = await getCollection('events');
const now = new Date();

const upcomingEvents = allEvents
  .filter((e: CollectionEntry<'events'>) => !e.data.draft && new Date(e.data.date) >= now)
  .sort((a: CollectionEntry<'events'>, b: CollectionEntry<'events'>) =>
    new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
  );

const nextEvent = upcomingEvents[0];

if (!nextEvent) return;

const eventDate = new Date(nextEvent.data.date);
const dateStr = eventDate.toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
});
---

<div
  id="announcement-bar"
  class="bg-surface-dark text-white py-2 px-4 text-center text-sm relative"
>
  <div class="mx-auto max-w-7xl flex items-center justify-center gap-2">
    <span class="hidden sm:inline text-accent font-bold text-xs uppercase tracking-widest">Próximo evento</span>
    <span class="hidden sm:inline text-white/40">·</span>
    <a
      href="/calendario"
      class="font-semibold hover:text-accent transition-colors inline-flex items-center gap-1"
    >
      {nextEvent.data.title}
      <span class="text-white/60 font-normal">— {dateStr}</span>
      <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
    </a>
  </div>
  <button
    id="close-announcement"
    aria-label="Cerrar anuncio"
    class="absolute right-3 top-1/2 -translate-y-1/2 text-white/50 hover:text-white transition-colors p-1"
  >
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
</div>

<script>
  const BAR_KEY = 'ann-bar-closed-v1';

  function initAnnouncementBar() {
    const bar = document.getElementById('announcement-bar');
    if (!bar) return;

    // Ocultar si ya fue cerrado
    if (localStorage.getItem(BAR_KEY)) {
      bar.remove();
      return;
    }

    const closeBtn = document.getElementById('close-announcement');
    closeBtn?.addEventListener('click', () => {
      localStorage.setItem(BAR_KEY, '1');
      bar.remove();
    });
  }

  initAnnouncementBar();
  document.addEventListener('astro:page-load', initAnnouncementBar);
</script>
