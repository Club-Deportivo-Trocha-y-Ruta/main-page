---
import { PUBLIC_GA4_MEASUREMENT_ID } from 'astro:env/client';
const ga4Id = PUBLIC_GA4_MEASUREMENT_ID;
const enableGA4 = Boolean(ga4Id);
---

{/*
  GA4 se carga en el hilo principal, con `async`, NO a través de Partytown.

  Hasta el 12 de agosto de 2026 el tag iba dentro de un web worker con
  `type="text/partytown"`. Ese día se desplegó la migración a Astro 7 y la
  medición se apagó en seco: Astro 7 reescribe cualquier script con
  `define:vars` para inyectar las variables y **descarta sus atributos** en el
  proceso, así que el bloque de consentimiento y `config` perdió su
  `type="text/partytown"` y pasó a ejecutarse en el hilo principal, donde
  sobrescribía el puente `window.gtag` que Partytown deja para reenviar al
  worker. Resultado: ni un solo hit llegó a Google durante dos semanas, sin
  error visible en consola.

  Por eso el orden de abajo importa y por eso no se usa `define:vars` en el
  script que lleva atributos (`src`/`async`). Ver también
  `ScrollDepth.astro`, que ya tropezó con lo mismo perdiendo `data-astro-rerun`.

  Google tampoco soporta oficialmente gtag.js dentro de un web worker, y el
  Consent Mode v2 depende de un orden de ejecución síncrono que un worker no
  garantiza. La carga directa con `async` es la configuración que Google
  documenta.
*/}
{enableGA4 && (
  <>
    {/*
      1. Bootstrap síncrono: dataLayer, stub de gtag y consentimiento por
         defecto ANTES de que gtag.js se ejecute (requisito de Consent Mode v2).
         `define:vars` es seguro aquí solo porque este script no lleva ningún
         atributo que deba sobrevivir. No añadas atributos a este bloque.
    */}
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });

      try {
        if (localStorage.getItem('trocha-analytics-consent') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch {}

      gtag('js', new Date());
      gtag('config', ga4Id, { anonymize_ip: true, send_page_view: true });
    </script>

    {/*
      2. gtag.js. Sin `define:vars`: sus atributos (`src`, `async`) tienen que
         llegar intactos al HTML.
    */}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>

    {/*
      3. Puente provider-neutral: catálogo cerrado de eventos y pageviews de
         navegación SPA. `window.gtag` ya existe (lo define el script 1, que
         corre antes en el mismo documento), así que no hace falta la cola de
         espera que exigía el puente asíncrono de Partytown.
    */}
    <script is:inline define:vars={{ ga4Id }}>
      (function () {
        if (window.__trochaAnalyticsBootstrapped) return;
        window.__trochaAnalyticsBootstrapped = true;

        const state = (window.__trochaAnalytics = window.__trochaAnalytics || {
          providers: [],
          queue: [],
          ready: false,
        });

        function dispatch(item) {
          for (const p of state.providers) {
            try {
              if (item.kind === 'pageview') p.trackPageview(item.path, item.title);
              else if (item.kind === 'event') p.trackEvent(item.event);
              else if (item.kind === 'consent') p.setConsent(item.status);
            } catch {}
          }
        }

        function registerProvider(p) {
          if (state.providers.some((x) => x.id === p.id)) return;
          state.providers.push(p);
          try { p.init(); } catch {}
          state.ready = true;
          while (state.queue.length > 0) {
            const item = state.queue.shift();
            dispatch(item);
          }
        }

        function callGtag(fn) {
          if (typeof window.gtag !== 'function') return;
          try { fn(); } catch {}
        }

        registerProvider({
          id: 'ga4',
          init() {},
          trackPageview(path, title) {
            callGtag(function () {
              window.gtag('event', 'page_view', {
                page_path: path,
                page_title: title,
                send_to: ga4Id,
              });
            });
          },
          trackEvent(event) {
            callGtag(function () {
              window.gtag('event', event.name, event.params || {});
            });
          },
          setConsent(status) {
            callGtag(function () {
              window.gtag('consent', 'update', { analytics_storage: status });
            });
          },
        });

        const ALLOWED_EVENTS = [
          'contact_submit',
          'inscription_step_view',
          'inscription_complete',
          'whatsapp_click',
          'cta_inscripcion_click',
          'sponsor_click',
          'transparencia_pdf_download',
          'scroll_depth',
        ];
        const ALLOWED_PARAMS = ['program_id', 'age_bucket', 'step', 'depth', 'pdf_name', 'sponsor_id'];

        function sanitize(params) {
          const out = {};
          if (!params) return out;
          for (const k of ALLOWED_PARAMS) {
            const v = params[k];
            if (v === undefined || v === null) continue;
            if (typeof v === 'string') out[k] = v.slice(0, 100);
            else if (typeof v === 'number' || typeof v === 'boolean') out[k] = v;
          }
          return out;
        }

        function emit(name, params) {
          if (ALLOWED_EVENTS.indexOf(name) === -1) return;
          const item = { kind: 'event', event: { name: name, params: sanitize(params) } };
          if (state.providers.length === 0) state.queue.push(item);
          else dispatch(item);
        }
        window.__trochaEmit = emit;

        function handleDelegatedClick(ev) {
          const target = ev.target;
          if (!(target instanceof Element)) return;
          const el = target.closest('[data-analytics-event]');
          if (!el) return;
          const name = el.getAttribute('data-analytics-event');
          if (!name) return;
          const params = {};
          const pdf = el.getAttribute('data-analytics-pdf-name');
          const sponsor = el.getAttribute('data-analytics-sponsor-id');
          const programId = el.getAttribute('data-analytics-program-id');
          if (pdf) params.pdf_name = pdf;
          if (sponsor) params.sponsor_id = sponsor;
          if (programId) params.program_id = programId;
          emit(name, params);
        }
        document.addEventListener('click', handleDelegatedClick);

        // El primer page_view lo manda gtag.js con send_page_view: true.
        // Aquí solo se emiten los pageviews de navegaciones posteriores (ClientRouter).
        let initialLoadHandled = false;
        document.addEventListener('astro:page-load', function () {
          if (!initialLoadHandled) {
            initialLoadHandled = true;
            return;
          }
          const path = window.location.pathname + window.location.search;
          const title = document.title;
          const queueItem = { kind: 'pageview', path: path, title: title };
          if (state.providers.length === 0) state.queue.push(queueItem);
          else dispatch(queueItem);
        });
      })();
    </script>
  </>
)}
