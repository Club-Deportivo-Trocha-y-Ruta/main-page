---
interface Props {
  name: string;
  photo: string;
  category: string;
  specialty?: string;
  href: string;
}

const { name, photo, category, specialty, href } = Astro.props;

import { Image } from 'astro:assets';
import Badge from '@components/common/Badge.astro';
import { getCategoryLabel } from '@lib/utils';

const badgeVariant: Record<string, 'primary' | 'accent' | 'cyan' | 'neutral'> = {
  juvenil: 'primary',
  infantil: 'cyan',
  'pre-infantil': 'cyan',
  elite: 'accent',
  sub23: 'primary',
  master: 'neutral',
};

const specialtyLabels: Record<string, string> = {
  xco: 'XCO',
  xcm: 'XCM',
  enduro: 'Enduro',
  'múltiple': 'Múltiple',
  ruta: 'Ruta',
};
---

<a
  href={href}
  class:list={[
    'group block rounded-xl',
    'transition-transform duration-[var(--duration-micro)] ease-spring',
    'hover:-translate-y-1 hover:shadow-lg',
    'motion-reduce:transition-none motion-reduce:hover:translate-y-0',
  ]}
>
  <div class="aspect-[3/4] overflow-hidden rounded-xl bg-surface-muted">
    <Image
      src={photo}
      alt={`Foto de ${name}`}
      width={400}
      height={500}
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
      inferSize={false}
    />
  </div>
  <div class="mt-3">
    <h3 class="font-display font-semibold text-text-primary group-hover:text-primary transition-colors text-sm sm:text-base leading-tight">
      {name}
    </h3>
    <div class="mt-1.5">
      <Badge variant={badgeVariant[category] ?? 'neutral'}>
        {getCategoryLabel(category)}
      </Badge>
    </div>
    {specialty && (
      <p class="mt-1 text-xs text-text-secondary uppercase">
        {specialtyLabels[specialty] ?? specialty}
      </p>
    )}
  </div>
</a>
