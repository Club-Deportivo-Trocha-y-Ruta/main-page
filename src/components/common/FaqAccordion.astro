---
/**
 * Acordeón de preguntas frecuentes.
 *
 * `id` es opcional y aditivo: cuando llega, la pregunta queda enlazable
 * (`/preguntas-frecuentes#pregunta-edad-minima`) y se resalta al aterrizar en
 * ella. Las páginas que no lo pasan —`/inscripciones`— se comportan igual que
 * antes.
 *
 * Sigue sin JavaScript: el desplegable es `<details>` nativo y el resaltado es
 * `:target` en CSS.
 */
interface FaqItem {
  question: string;
  answer: string;
  /** Ancla de la pregunta. Sin él, la pregunta no es enlazable. */
  id?: string;
}

interface Props {
  items: FaqItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={['space-y-3', className]}>
  {items.map((item) => (
    <details
      id={item.id}
      class="faq-item group scroll-mt-24 rounded-xl bg-surface shadow-sm ring-1 ring-black/5 transition-shadow duration-200 hover:shadow-md"
    >
      <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 font-display font-semibold text-text-primary text-lg select-none list-none [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <svg
          class="h-5 w-5 shrink-0 text-primary-deep transition-transform duration-200 group-open:rotate-180"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-6 pb-6 text-text-secondary leading-relaxed">
        {item.answer}
      </div>
    </details>
  ))}
</div>

<style>
  /* Al llegar por enlace, la pregunta se marca para que se vea cuál es. */
  .faq-item:target {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Apertura suave del acordeón (docs/06-plan-animaciones.md Fase 4 Tarea 12):
     mejora progresiva solo para navegadores con `::details-content` +
     `interpolate-size` (Chromium). Todo va detrás de este único `@supports`,
     así que en el resto de navegadores no se define ninguna regla nueva y el
     `<details>` nativo se abre/cierra exactamente igual que hoy — sin
     transición, instantáneo. */
  @supports (interpolate-size: allow-keywords) {
    .faq-item {
      interpolate-size: allow-keywords;
    }

    .faq-item::details-content {
      height: 0;
      overflow: clip;
      /* `ease-out` y no `--ease-spring`: el resorte sobrepasa ~6% su valor
         final, y sobre `height` ese overshoot empuja de más todo lo que va
         debajo del acordeón y lo devuelve — un rebote de layout de ~0.077 de
         shift. Hoy no cuenta para CLS porque siempre nace de un clic o un
         Enter (`hadRecentInput`), pero el rebote se ve. El resorte se queda
         donde no mueve layout: transform y opacity. */
      transition:
        height var(--duration-micro) ease-out,
        content-visibility var(--duration-micro) allow-discrete;
    }

    .faq-item[open]::details-content {
      height: auto;
    }

    @starting-style {
      .faq-item[open]::details-content {
        height: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .faq-item::details-content {
        transition: none;
      }
    }
  }
</style>
