---
import { Image } from 'astro:assets';
import logo from '@assets/images/logo.webp';
import { SITE, CONTACT, SOCIAL, SECONDARY_NAV, CHILD_SAFETY } from '../../lib/constants';

const footerLinks: Array<{ label: string; href: string }> = [
  ...SECONDARY_NAV.filter(i => i.href !== '/contacto'),
  { label: 'Inscripciones', href: '/inscripciones' },
  { label: 'Contacto', href: '/contacto' },
  {
    label: 'Política de Tratamiento de Datos',
    href: '/politica-de-tratamiento-de-datos',
  },
];

const year = new Date().getFullYear();
---

<footer class="bg-surface-dark text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Marca -->
      <div>
        <a href="/" class="inline-block">
          <Image
            src={logo}
            alt="Club Deportivo Trocha y Ruta"
            width={120}
            height={120}
            layout="fixed"
            class="h-16! w-auto brightness-0 invert"
          />
        </a>
        <p class="mt-3 text-sm text-gray-400 leading-relaxed">
          {SITE.tagline}
        </p>
        <p class="mt-2 text-sm text-gray-400">
          Desde {SITE.founded} formando ciclistas en Yumbo, Valle del Cauca.
        </p>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Navegación</h3>
        <ul class="mt-4 space-y-2">
          {footerLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="block py-1.5 text-sm text-gray-300 transition-colors hover:text-primary-light"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Contacto</h3>
        <ul class="mt-4 space-y-3 text-sm text-gray-300">
          <li class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{CONTACT.address}</span>
          </li>
          <li>
            <a href={CONTACT.phoneLink} class="flex items-center gap-2 transition-colors hover:text-primary-light">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {CONTACT.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-2 min-w-0 transition-colors hover:text-primary-light">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span class="break-all">{CONTACT.email}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Redes sociales -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Redes Sociales</h3>
        <div class="mt-4 flex gap-4">
          <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="rounded-lg bg-white/10 p-3 text-gray-300 transition-colors hover:bg-white/20 hover:text-primary-light">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="rounded-lg bg-white/10 p-3 text-gray-300 transition-colors hover:bg-white/20 hover:text-primary-light">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="rounded-lg bg-white/10 p-3 text-gray-300 transition-colors hover:bg-white/20 hover:text-primary-light">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
          </a>
          <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="rounded-lg bg-white/10 p-3 text-gray-300 transition-colors hover:bg-white/20 hover:text-primary-light">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
          <a href={SOCIAL.strava} target="_blank" rel="noopener noreferrer" aria-label="Strava" class="rounded-lg bg-white/10 p-2.5 text-gray-300 transition-colors hover:bg-white/20 hover:text-primary-light">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Protección Infantil -->
    <div class="mt-10 border-t border-white/10 pt-8">
      <div class="flex flex-col items-center gap-3 text-center sm:flex-row sm:justify-center sm:gap-6 sm:text-left">
        <div class="flex items-center gap-2 text-sm text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-primary" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <a href={CHILD_SAFETY.policyUrl} class="transition-colors hover:text-primary-light">
            Política de Protección Infantil
          </a>
        </div>
        <span class="hidden text-gray-600 sm:inline" aria-hidden="true">|</span>
        <div class="flex items-center gap-2 text-sm text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-primary" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Línea ICBF: <a href="tel:141" class="font-semibold text-primary transition-colors hover:text-primary-light">{CHILD_SAFETY.icbfLine}</a> (emergencias menores)</span>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-6 text-center text-sm text-gray-400">
      <p>&copy; {year} {SITE.name}. Todos los derechos reservados.</p>
      <p class="mt-1">
        Desarrollado con orgullo por <a href="https://www.linkedin.com/in/juadiga/" target="_blank" rel="noopener noreferrer" class="text-gray-300 transition-colors hover:text-primary-light">Juan Diego Garcia</a>, deportista y miembro activo del club
      </p>
    </div>
  </div>
</footer>
