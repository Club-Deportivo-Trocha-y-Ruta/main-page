---
/**
 * Pie del sitio.
 *
 * Era una lista plana de nueve enlaces donde "Galería" y "Política de
 * Tratamiento de Datos" pesaban lo mismo, más los datos de contacto y las
 * redes. Ahora repite el mapa del sitio agrupado como está organizado de
 * verdad —el club, la temporada, para familias, institucional— con la
 * agrupación en `@lib/navigation`, no escrita aquí.
 *
 * Y sabe en qué punto va el club: la cinta superior trae la temporada en curso
 * y el inventario de Trocha Verde, derivados del contenido. Es lo único del
 * sitio que aparece en las 144 páginas, así que es donde más rinde que el dato
 * esté vivo. Si el contenido no lo sostiene, la cinta no se pinta.
 *
 * Los iconos dibujados a mano pasaron a `astro-icon`, como el resto del sitio.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '@assets/images/logo.webp';
import { SITE, CONTACT, SOCIAL, CHILD_SAFETY, getYearsActive } from '@lib/constants';
import { FOOTER_GROUPS } from '@lib/navigation';
import { seasonProgress } from '@lib/linktree';
import { summarizeTrees } from '@lib/trocha-verde';

type Event = CollectionEntry<'events'>;
type Tree = CollectionEntry<'trees'>;

const events = (await getCollection('events')).filter((e: Event) => !e.data.draft);
const trees = (await getCollection('trees')).filter((t: Tree) => !t.data.draft);

const season = seasonProgress(events);
const totalTrees = summarizeTrees(trees.map((tree: Tree) => tree.data)).totalTrees;
const yearsActive = getYearsActive();

const socials = [
  { name: 'Instagram', url: SOCIAL.instagram, icon: 'ph:instagram-logo-bold' },
  { name: 'Facebook', url: SOCIAL.facebook, icon: 'ph:facebook-logo-bold' },
  { name: 'YouTube', url: SOCIAL.youtube, icon: 'ph:youtube-logo-bold' },
  { name: 'WhatsApp', url: CONTACT.whatsapp, icon: 'ph:whatsapp-logo-bold' },
];

const year = new Date().getFullYear();
---

<footer class="bg-surface-dark text-white">
  <!--
    La cinta: en qué punto va el club ahora mismo. Solo se pinta lo que el
    contenido sostiene.
  -->
  {(season || totalTrees > 0) && (
    <div class="border-b border-white/10 bg-white/[0.03]">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-3 px-4 py-4 text-sm sm:px-6 lg:px-8">
        {season && (
          <a
            href="/calendario"
            class="group inline-flex items-center gap-2 text-gray-300 transition-colors hover:text-white"
          >
            <Icon
              name="ph:flag-checkered-bold"
              class="size-4 shrink-0 text-primary-light"
              aria-hidden="true"
            />
            <span>
              Temporada {season.year}:{' '}
              <span class="font-semibold text-white">{season.completed} de {season.total}</span>{' '}
              fechas corridas
            </span>
          </a>
        )}

        {totalTrees > 0 && (
          <a
            href="/trocha-verde"
            class="group inline-flex items-center gap-2 text-gray-300 transition-colors hover:text-white"
          >
            <Icon name="ph:tree-bold" class="size-4 shrink-0 text-accent-light" aria-hidden="true" />
            <span>
              <span class="font-semibold text-white">{totalTrees}</span> árboles sembrados por Trocha
              Verde
            </span>
          </a>
        )}
      </div>
    </div>
  )}

  <!--
    Padding inferior extra solo en móvil: la barra de conversión fija
    (`ConversionBar.astro`, `md:hidden`) tapa el final de la página si no.
    De `md` en adelante no hay barra fija y se recupera el padding original.
  -->
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-24 sm:px-6 md:pb-12 lg:px-8 lg:pt-16 lg:pb-16">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_2.4fr]">
      <!-- Marca -->
      <div>
        <a href="/" class="inline-block">
          <Image
            src={logo}
            alt="Club Deportivo Trocha y Ruta"
            width={120}
            height={120}
            layout="fixed"
            class="h-16! w-auto brightness-0 invert"
          />
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-gray-400">
          {SITE.tagline}
        </p>
        <p class="mt-2 text-sm text-gray-400">
          {yearsActive} años formando ciclistas en Yumbo, Valle del Cauca.
        </p>

        <ul class="mt-5 space-y-3 text-sm text-gray-300">
          <li class="flex items-start gap-2">
            <Icon name="ph:map-pin-bold" class="mt-0.5 size-4 shrink-0 text-primary-light" aria-hidden="true" />
            <span>{CONTACT.address}</span>
          </li>
          <li>
            <a href={CONTACT.phoneLink} class="flex items-center gap-2 transition-colors hover:text-primary-light">
              <Icon name="ph:phone-bold" class="size-4 shrink-0 text-primary-light" aria-hidden="true" />
              {CONTACT.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${CONTACT.email}`}
              class="flex min-w-0 items-center gap-2 transition-colors hover:text-primary-light"
            >
              <Icon name="ph:envelope-simple-bold" class="size-4 shrink-0 text-primary-light" aria-hidden="true" />
              <span class="break-all">{CONTACT.email}</span>
            </a>
          </li>
        </ul>

        <div class="mt-6 flex flex-wrap gap-3">
          {socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${social.name} del Club Trocha y Ruta`}
              class="rounded-lg bg-white/10 p-3 text-gray-300 transition-colors hover:bg-white/20 hover:text-primary-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light"
            >
              <Icon name={social.icon} class="size-5" aria-hidden="true" />
            </a>
          ))}
          <a
            href={SOCIAL.strava}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Strava del Club Trocha y Ruta"
            class="rounded-lg bg-white/10 p-3 text-gray-300 transition-colors hover:bg-white/20 hover:text-primary-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light"
          >
            {/* Strava no está en Phosphor: se conserva el trazado propio. */}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-5"
              aria-hidden="true"
            >
              <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169" />
            </svg>
          </a>
        </div>
      </div>

      <!-- El mapa del sitio, agrupado por lo que es cada cosa -->
      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-4" aria-label="Mapa del sitio">
        {FOOTER_GROUPS.map((group) => (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400">
              {group.title}
            </h3>
            <ul class="mt-4 space-y-2">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block py-1.5 text-sm text-gray-300 transition-colors hover:text-primary-light"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <!-- Línea nacional de protección a la niñez (ICBF) -->
    <div class="mt-10 border-t border-white/10 pt-8">
      <p class="flex flex-wrap items-center justify-center gap-2 text-center text-sm text-gray-400">
        <Icon name="ph:phone-bold" class="size-4 shrink-0 text-primary-light" aria-hidden="true" />
        <span>
          Línea ICBF:{' '}
          <a
            href={`tel:${CHILD_SAFETY.icbfLine}`}
            class="font-semibold text-primary-light transition-colors hover:text-white"
            >{CHILD_SAFETY.icbfLine}</a
          >{' '}— protección a la niñez, gratuita y confidencial
        </span>
      </p>
    </div>

    <!-- Copyright -->
    <div class="mt-6 text-center text-sm text-gray-400">
      <p>&copy; {year} {SITE.name}. Todos los derechos reservados.</p>
      <p class="mt-1">
        Desarrollado con orgullo por <a
          href="https://www.linkedin.com/in/juadiga/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-300 underline decoration-gray-500 underline-offset-2 transition-colors hover:text-primary-light hover:decoration-primary-light"
          >Juan Diego Garcia</a
        >, deportista y miembro activo del club
      </p>
    </div>
  </div>
</footer>
