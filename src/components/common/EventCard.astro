---
interface Props {
  title: string;
  date: Date;
  location: string;
  category: string;
  status: string;
  href: string;
}

const { title, date, location, category, status, href } = Astro.props;

import Badge from '@components/common/Badge.astro';
import { getCategoryLabel, getEventStatusLabel } from '@lib/utils';

const statusVariant: Record<string, 'primary' | 'accent' | 'cyan' | 'neutral'> = {
  upcoming: 'primary',
  past: 'neutral',
  ongoing: 'cyan',
  cancelled: 'accent',
};
---

<a href={href} class="flex items-start gap-4 rounded-xl p-4 transition-colors hover:bg-surface-muted">
  <div class="min-w-[4rem] rounded-lg bg-primary/10 p-3 text-center">
    <span class="block text-xs font-semibold uppercase text-primary">
      {date.toLocaleDateString('es-CO', { month: 'short' })}
    </span>
    <span class="block font-display text-2xl font-bold text-primary">
      {date.getDate()}
    </span>
  </div>
  <div class="flex flex-col gap-1">
    <h3 class="font-display font-semibold text-text-primary">{title}</h3>
    <p class="text-sm text-text-secondary"><span aria-hidden="true">📍</span> {location}</p>
    <div class="mt-1 flex flex-wrap gap-2">
      <Badge>{getCategoryLabel(category)}</Badge>
      <Badge variant={statusVariant[status] ?? 'neutral'}>{getEventStatusLabel(status)}</Badge>
    </div>
  </div>
</a>
