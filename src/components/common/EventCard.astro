---
/**
 * Fecha del calendario: bloque de día + datos del evento.
 *
 * Las etiquetas salen de `@lib/calendar`, no de `getCategoryLabel()` de utils
 * —esa traduce categorías de corredores y dejaba las de evento en crudo
 * ("xco" en minúscula)—.
 */
import { Icon } from 'astro-icon/components';
import Badge from '@components/common/Badge.astro';
import AddToCalendar from '@components/common/AddToCalendar.astro';
import { isHomeRace } from '@lib/yumbo';
import {
  dayLabel,
  monthShort,
  getEventCategory,
  getEventLevel,
  getEventStatusLabel,
} from '@lib/calendar';

interface Props {
  title: string;
  date: Date;
  endDate?: Date;
  location: string;
  city?: string;
  category: string;
  level?: string;
  status: string;
  /** Opcional: sin href el título se renderiza como texto plano (evita
   *  enlaces circulares cuando la card ya está en su página destino). */
  href?: string;
  /** Crónicas publicadas del evento (solo tiene sentido en fechas corridas). */
  chronicles?: { href: string; title: string }[];
  /** Atenúa la card. Se usa para el bloque de fechas corridas. */
  muted?: boolean;
}

const {
  title,
  date,
  endDate,
  location,
  city,
  category,
  level,
  status,
  href,
  chronicles = [],
  muted = false,
} = Astro.props;

const categoryStyle = getEventCategory(category);
const levelLabel = getEventLevel(level);

// El estado solo se rotula cuando aporta algo: que una fecha pasada diga
// "Corrido" es ruido, porque ya va bajo el título de la sección.
const showStatus = status === 'ongoing' || status === 'cancelled';

// Correr en Yumbo cambia el plan de la familia —no hay que viajar— y cambia el
// papel del club, que deja de ser visitante. Se marca en la fecha, venga o ya
// corrida.
const atHome = isHomeRace(city);
---

<div
  class:list={[
    'group flex h-full items-start gap-3 rounded-xl border-l-4 p-3 sm:gap-4 sm:p-4',
    'ease-spring transition-[background-color,transform] duration-[var(--duration-micro)]',
    'hover:bg-surface-muted hover:-translate-y-1 hover:shadow-lg',
    'motion-reduce:transition-none motion-reduce:hover:translate-y-0',
    muted ? 'border-surface-muted' : 'border-primary',
    status === 'cancelled' && 'opacity-75',
  ]}
>
  <div
    class:list={[
      'min-w-[3.5rem] shrink-0 rounded-lg p-2 text-center sm:min-w-[4rem] sm:p-3',
      muted ? 'bg-black/5' : 'bg-primary/10',
    ]}
  >
    <span class="text-primary-deep block text-xs font-bold tracking-wide uppercase">
      {monthShort(date)}
    </span>
    <span class="font-display text-primary-deep block text-xl font-bold sm:text-2xl">
      {dayLabel(date, endDate)}
    </span>
  </div>

  <div class="flex min-w-0 flex-col gap-1">
    <h3
      class:list={[
        'font-display text-text-primary leading-snug font-semibold',
        status === 'cancelled' && 'line-through',
      ]}
    >
      {
        href ? (
          <a href={href} class="text-text-primary hover:text-primary-deep transition-colors">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>

    <p class="text-text-secondary flex items-start gap-1.5 text-sm">
      <Icon
        name="ph:map-pin-bold"
        class="ease-spring mt-0.5 size-4 shrink-0 transition-transform duration-[var(--duration-micro)] group-hover:rotate-[8deg] motion-reduce:transition-none motion-reduce:group-hover:rotate-0"
        aria-hidden="true"
      />
      <span>
        {location}
        {city && ` · ${city}`}
      </span>
    </p>

    <div class="mt-1 flex flex-wrap items-center gap-1.5 sm:gap-2">
      <Badge>
        <span class="inline-flex items-center gap-1">
          <Icon name={categoryStyle.icon} class="size-3" aria-hidden="true" />
          {categoryStyle.short}
        </span>
      </Badge>
      {levelLabel && <Badge variant="neutral">{levelLabel}</Badge>}
      {
        atHome && (
          <Badge variant="cyan">
            <span class="inline-flex items-center gap-1">
              <Icon name="ph:house-line-bold" class="size-3" aria-hidden="true" />
              En casa
            </span>
          </Badge>
        )
      }
      <!-- El lima marca lo bueno de la página; una fecha caída va en gris. -->
      {
        showStatus && (
          <Badge
            variant={status === 'ongoing' ? 'cyan' : 'neutral'}
            class={status === 'cancelled' ? 'font-bold tracking-wide uppercase' : undefined}
          >
            {getEventStatusLabel(status)}
          </Badge>
        )
      }
    </div>

    {
      status === 'upcoming' && (
        <AddToCalendar title={title} date={date} endDate={endDate} location={location} />
      )
    }

    {
      chronicles.length > 0 && (
        <ul class="mt-1.5 space-y-0.5">
          {chronicles.map((c) => (
            <li>
              <a
                href={c.href}
                class="text-primary-deep inline-flex items-start gap-1 text-sm hover:underline"
              >
                <Icon
                  name="ph:newspaper-clipping-bold"
                  class="mt-0.5 size-4 shrink-0"
                  aria-hidden="true"
                />
                <span>{c.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
