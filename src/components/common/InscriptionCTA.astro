---
import Button from '@components/common/Button.astro';
import { CONTACT } from '@lib/constants';
import { uniqueSvgId } from '@lib/editorial';

interface Props {
  variant?: 'banner' | 'inline';
  heading?: string;
  description?: string;
}

const {
  variant = 'inline',
  heading = 'Tu hijo puede empezar desde los 4 años',
  description = 'Primera clase de prueba gratis. Entrenadores certificados, ambiente seguro y divertido.',
} = Astro.props;

// La variante `banner` es un landmark propio y necesita nombre accesible. El
// id se genera por render porque el componente aparece dos veces en la portada.
const headingId = uniqueSvgId('cta-inscripcion');
---

{variant === 'banner' ? (
  /*
   * El texto va en grafito, no en blanco: el teal de marca (#20b7c9) solo
   * alcanza 2.4:1 contra blanco y no cumple WCAG AA ni para texto grande.
   * `text-surface-dark` sobre el mismo fondo da 5.5:1. Es la misma regla que
   * ya aplica el tono `brand` del sistema editorial (ver `src/lib/editorial.ts`).
   */
  <section class="bg-primary py-16 px-4" aria-labelledby={headingId}>
    <div class="mx-auto max-w-3xl text-center text-surface-dark">
      <h2 id={headingId} class="text-2xl md:text-3xl font-display font-bold">
        {heading}
      </h2>
      <p class="mt-3 text-base md:text-lg text-surface-dark/80">
        {description}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button variant="accent" size="lg" href="/inscripciones" data-analytics-event="cta_inscripcion_click">
          Clase de prueba gratis
        </Button>
        <a
          href={`${CONTACT.whatsapp}?text=Hola%2C%20quiero%20inscribir%20a%20mi%20hijo%20en%20el%20club`}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="whatsapp_click"
          class="inline-flex items-center gap-2 rounded-lg border-2 border-surface-dark px-7 py-3.5 text-lg font-semibold text-surface-dark transition-colors duration-200 hover:bg-surface-dark hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface-dark"
        >
          Preguntar por WhatsApp
        </a>
      </div>
    </div>
  </section>
) : (
  <div class="rounded-2xl border border-primary/20 bg-primary/5 px-6 py-8 md:px-10 md:py-10">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <h2 class="text-xl md:text-2xl font-display font-bold text-text-primary">
          {heading}
        </h2>
        <p class="mt-2 text-text-secondary">
          {description}
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 shrink-0">
        <Button variant="accent" size="md" href="/inscripciones" data-analytics-event="cta_inscripcion_click">
          Clase de prueba gratis
        </Button>
        <a
          href={`${CONTACT.whatsapp}?text=Hola%2C%20quiero%20inscribir%20a%20mi%20hijo%20en%20el%20club`}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="whatsapp_click"
          class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-deep px-5 py-2.5 text-base font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Preguntar por WhatsApp
        </a>
      </div>
    </div>
  </div>
)}
