---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Button from '@components/common/Button.astro';
import ClubSeal from '@components/editorial/ClubSeal.astro';
import { CONTACT, CTA_TRIAL_LABEL, NEXT_SESSION_LABEL } from '@lib/constants';
import { uniqueSvgId } from '@lib/editorial';
import { nextSession } from '@lib/programs';

interface Props {
  variant?: 'banner' | 'inline';
  heading?: string;
  description?: string;
  /**
   * Etiqueta del titular en la variante `inline`, para cuando la CTA se
   * incrusta dentro de una sección que ya trae su propio `h2` (ver
   * `AboutPreview`). La variante `banner` es su propio landmark y siempre
   * usa `h2`, sin importar este prop.
   */
  headingLevel?: 'h2' | 'h3';
  /**
   * Disposición de la variante `inline`. `row` (el default histórico) pone
   * texto y botones lado a lado desde `md` — pensado para cuando la tarjeta
   * ocupa el ancho completo de la sección. `stacked` mantiene los botones
   * debajo del texto en todas las tallas: es la forma correcta cuando la CTA
   * vive dentro de media columna (ver `AboutPreview`), donde la fila de `md`
   * aprieta el titular a una palabra por línea.
   */
  layout?: 'row' | 'stacked';
}

const {
  variant = 'inline',
  heading = 'Tu hijo puede empezar desde los 4 años',
  description = 'Primera clase de prueba gratis. Entrenadores certificados, ambiente seguro y divertido.',
  headingLevel: Heading = 'h2',
  layout = 'row',
} = Astro.props;

// La variante `banner` es un landmark propio y necesita nombre accesible. El
// id se genera por render porque el componente aparece dos veces en la portada.
const headingId = uniqueSvgId('cta-inscripcion');

/*
 * La próxima sesión sale del campo `sessions` de los programas activos, no de
 * un texto escrito aquí: si el club todavía no capturó sus horarios en datos,
 * la línea no se pinta y el banner queda como estaba. Solo la variante
 * `banner` la muestra —es el cierre de la página, donde la familia decide— y
 * por eso la colección solo se consulta ahí.
 *
 * Es un dato de build: `nextSession()` devuelve el día de la semana y la hora,
 * que se repiten cada semana y siguen siendo ciertos aunque pasen días sin
 * desplegar. Nunca "hoy" ni "mañana".
 */
type Program = CollectionEntry<'programs'>;

const upcoming =
  variant === 'banner'
    ? nextSession(
        (await getCollection('programs'))
          .filter((program: Program) => !program.data.draft && program.data.active)
          .map((program: Program) => ({
            id: program.id,
            title: program.data.title,
            sessions: program.data.sessions,
          }))
      )
    : null;
---

{
  variant === 'banner' ? (
    /*
     * El texto va en grafito, no en blanco: el teal de marca (#20b7c9) solo
     * alcanza 2.4:1 contra blanco y no cumple WCAG AA ni para texto grande.
     * `text-surface-dark` sobre el mismo fondo da 5.5:1. Es la misma regla que
     * ya aplica el tono `brand` del sistema editorial (ver `src/lib/editorial.ts`).
     */
    <section class="bg-primary px-4 py-16" aria-labelledby={headingId}>
      <div class="text-surface-dark mx-auto max-w-3xl text-center">
        {/*
          El sello encabeza el banner: es el cierre de la página y quien firma
          la promesa. Tono `brand` porque el fondo es el teal de marca, sobre
          el que el escudo (teal→lima, fondo transparente) se perdería sin su
          disco claro.
        */}
        <ClubSeal size="sm" tone="brand" rotate={-6} class="mb-5" />
        <h2 id={headingId} class="font-display text-2xl font-bold md:text-3xl">
          {heading}
        </h2>
        <p class="text-surface-dark/80 mt-3 text-base md:text-lg">{description}</p>
        {upcoming && (
          <p class="text-surface-dark mt-5 inline-flex items-center gap-2 rounded-full bg-white/40 px-4 py-2 text-sm font-semibold">
            <Icon name="ph:calendar-check-bold" class="h-4 w-4 shrink-0" aria-hidden="true" />
            <span>
              {NEXT_SESSION_LABEL}: {upcoming.label}
            </span>
          </p>
        )}
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button
            variant="accent"
            size="lg"
            href="/inscripciones"
            data-analytics-event="cta_inscripcion_click"
          >
            {CTA_TRIAL_LABEL}
          </Button>
          <a
            href={`${CONTACT.whatsapp}?text=Hola%2C%20quiero%20inscribir%20a%20mi%20hijo%20en%20el%20club`}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="whatsapp_click"
            class="border-surface-dark text-surface-dark hover:bg-surface-dark focus-visible:outline-surface-dark inline-flex items-center gap-2 rounded-lg border-2 px-7 py-3.5 text-lg font-semibold transition-colors duration-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            Preguntar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  ) : (
    <div class="border-primary/20 bg-primary/5 rounded-2xl border px-6 py-8 md:px-10 md:py-10">
      <div
        class:list={[
          'flex flex-col gap-6',
          layout === 'row' && 'md:flex-row md:items-center md:justify-between',
        ]}
      >
        <div>
          <Heading class="font-display text-text-primary text-xl font-bold md:text-2xl">
            {heading}
          </Heading>
          <p class="text-text-secondary mt-2">{description}</p>
        </div>
        <div class="flex shrink-0 flex-col items-start gap-3 sm:flex-row sm:items-center">
          <Button
            variant="accent"
            size="md"
            href="/inscripciones"
            data-analytics-event="cta_inscripcion_click"
          >
            {CTA_TRIAL_LABEL}
          </Button>
          <a
            href={`${CONTACT.whatsapp}?text=Hola%2C%20quiero%20inscribir%20a%20mi%20hijo%20en%20el%20club`}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="whatsapp_click"
            class="border-primary-deep text-primary-deep hover:bg-primary-deep focus-visible:outline-primary inline-flex items-center gap-2 rounded-lg border-2 px-5 py-2.5 text-base font-semibold transition-colors duration-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            Preguntar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  )
}
