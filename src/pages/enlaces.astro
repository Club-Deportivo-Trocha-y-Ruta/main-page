---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import LinktreeLayout from '@layouts/LinktreeLayout.astro';
import { SITE, CONTACT, SOCIAL } from '@lib/constants';
import logo from '@assets/images/logo.webp';

const UTM_QUERY = 'utm_source=qr&utm_medium=offline&utm_campaign=enlaces';

/** Adds the QR campaign parameters so GA4 can attribute offline scans. */
function withUtm(path: string): string {
  return `${path}${path.includes('?') ? '&' : '?'}${UTM_QUERY}`;
}

const whatsappMessage = encodeURIComponent(
  'Hola, quiero información sobre el Club Deportivo Trocha y Ruta',
);
const whatsappHref = `${CONTACT.whatsapp}?text=${whatsappMessage}`;

interface Stat {
  value: string;
  label: string;
}

const stats: Stat[] = [
  { value: `Desde ${SITE.founded}`, label: 'formando ciclistas' },
  { value: 'Desde 4 años', label: 'todas las edades' },
  { value: 'Yumbo', label: 'Valle del Cauca' },
];

interface PortalLink {
  label: string;
  description: string;
  href: string;
  icon: string;
}

const secondaryLinks: PortalLink[] = [
  {
    label: 'Calendario de eventos',
    description: 'Próximas competencias y salidas',
    href: withUtm('/calendario'),
    icon: 'ph:calendar-blank-bold',
  },
  {
    label: 'Noticias y resultados',
    description: 'Lo más reciente del club',
    href: withUtm('/noticias'),
    icon: 'ph:newspaper-bold',
  },
  {
    label: 'Trocha Verde',
    description: 'Programa de recuperación ambiental',
    href: withUtm('/trocha-verde'),
    icon: 'ph:plant-bold',
  },
  {
    label: 'Sitio web oficial',
    description: 'Conoce todo sobre el club',
    href: withUtm('/'),
    icon: 'ph:globe-bold',
  },
];

const socialNetworks = [
  {
    name: 'Instagram',
    url: SOCIAL.instagram,
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z',
  },
  {
    name: 'Facebook',
    url: SOCIAL.facebook,
    path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
  {
    name: 'YouTube',
    url: SOCIAL.youtube,
    path: 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
  {
    name: 'Strava',
    url: SOCIAL.strava,
    path: 'M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169',
  },
];

const year = new Date().getFullYear();
---

<LinktreeLayout
  title={`${SITE.shortName} · Enlaces`}
  description={`Todos los canales oficiales del ${SITE.name}: contacto por WhatsApp, inscripciones, calendario, noticias y redes sociales.`}
>
  <div class="mx-auto flex min-h-screen w-full max-w-md flex-col px-5 py-8 sm:py-12">
    <header class="reveal flex flex-col items-center text-center">
      <div class="relative">
        <div
          class="absolute inset-0 -z-10 scale-110 rounded-3xl bg-accent/40 blur-2xl"
          aria-hidden="true"
        ></div>
        <Image
          src={logo}
          alt={`Logo ${SITE.name}`}
          width={112}
          height={112}
          layout="fixed"
          loading="eager"
          class="h-24 w-24 rounded-2xl bg-white object-contain p-2.5 shadow-xl ring-4 ring-white/90 sm:h-28 sm:w-28"
        />
      </div>
      <h1 class="mt-4 font-display text-2xl font-bold leading-tight text-white sm:text-3xl">
        {SITE.name}
      </h1>
      <p class="mt-2 max-w-xs text-sm text-white/85">
        {SITE.tagline}
      </p>
    </header>

    <ul
      class="reveal mt-5 grid grid-cols-3 gap-2 rounded-2xl bg-white/10 p-3 ring-1 ring-white/20 backdrop-blur-sm"
      aria-label="El club en cifras"
    >
      {
        stats.map((stat) => (
          <li class="text-center">
            <span class="block font-display text-sm font-bold leading-tight text-accent-light">
              {stat.value}
            </span>
            <span class="mt-0.5 block text-[11px] leading-snug text-white/80">{stat.label}</span>
          </li>
        ))
      }
    </ul>

    <section class="mt-6 flex flex-col gap-3" aria-labelledby="acciones-title">
      <h2 id="acciones-title" class="sr-only">Contáctanos y preinscríbete</h2>

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal group flex items-center gap-4 rounded-2xl bg-accent px-5 py-5 text-surface-dark shadow-xl shadow-black/20 ring-1 ring-white/30 transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-light focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        <span
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-surface-dark/10"
          aria-hidden="true"
        >
          <Icon name="ph:whatsapp-logo-bold" class="h-7 w-7" />
        </span>
        <span class="flex-1 text-left">
          <span class="block font-display text-lg font-bold leading-tight">
            Escríbenos por WhatsApp
          </span>
          <span class="mt-0.5 block text-xs font-medium leading-snug text-surface-dark/80">
            Te respondemos hoy mismo · {CONTACT.phone}
          </span>
        </span>
        <Icon
          name="ph:caret-right-bold"
          class="h-5 w-5 shrink-0 opacity-70 transition-transform group-hover:translate-x-1"
          aria-hidden="true"
        />
      </a>

      <a
        href={withUtm('/inscripciones')}
        class="reveal group flex items-center gap-4 rounded-2xl bg-white px-5 py-4 text-text-primary shadow-lg shadow-black/15 transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary-dark"
          aria-hidden="true"
        >
          <Icon name="ph:clipboard-text-bold" class="h-6 w-6" />
        </span>
        <span class="flex-1 text-left">
          <span class="block font-display text-base font-bold leading-tight">
            Preinscribe a tu hijo o hija
          </span>
          <span class="mt-0.5 block text-xs leading-snug text-text-secondary">
            Formulario de preinscripción en línea
          </span>
        </span>
        <Icon
          name="ph:caret-right-bold"
          class="h-5 w-5 shrink-0 text-primary transition-transform group-hover:translate-x-1"
          aria-hidden="true"
        />
      </a>
    </section>

    <section class="mt-8" aria-labelledby="explora-title">
      <h2
        id="explora-title"
        class="reveal text-xs font-semibold uppercase tracking-widest text-white/70"
      >
        Explora el club
      </h2>
      <nav class="mt-3 flex flex-col gap-2" aria-label="Secciones del sitio">
        {
          secondaryLinks.map((link, index) => (
            <a
              href={link.href}
              class="reveal group flex min-h-12 items-center gap-3 rounded-xl bg-white/10 px-4 py-3 text-white ring-1 ring-white/20 backdrop-blur-sm transition-all duration-200 hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
              style={`transition-delay: ${index * 40}ms;`}
            >
              <Icon
                name={link.icon}
                class="h-5 w-5 shrink-0 text-accent-light"
                aria-hidden="true"
              />
              <span class="flex-1 text-left">
                <span class="block font-display text-sm font-semibold leading-tight">
                  {link.label}
                </span>
                <span class="mt-0.5 block text-[11px] leading-snug text-white/70">
                  {link.description}
                </span>
              </span>
              <Icon
                name="ph:caret-right-bold"
                class="h-4 w-4 shrink-0 opacity-60 transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              />
            </a>
          ))
        }
      </nav>
    </section>

    <section class="reveal mt-8 flex flex-col items-center" aria-labelledby="redes-title">
      <h2 id="redes-title" class="text-xs font-semibold uppercase tracking-widest text-white/70">
        Síguenos en redes
      </h2>
      <ul class="mt-3 flex items-center gap-3">
        {
          socialNetworks.map(({ name, url, path }) => (
            <li>
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Síguenos en ${name}`}
                class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white ring-1 ring-white/20 backdrop-blur-sm transition-all hover:scale-110 hover:bg-white hover:text-primary-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <path d={path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="reveal mt-auto pt-8 text-center text-xs text-white/70">
      <p>© {year} · {SITE.shortName}</p>
      <p class="mt-1">{CONTACT.address}</p>
    </footer>
  </div>
</LinktreeLayout>
