---
/**
 * Política Editorial.
 *
 * El club es cronista de su propia actividad: no es un medio independiente, y
 * la página lo dice de frente en vez de disimularlo. Lo que sí puede mostrar
 * es con qué reglas trabaja — de dónde sale cada dato, qué hace si se
 * equivoca y qué protocolo sigue con los menores que aparecen en sus fotos—,
 * respaldado por cifras reales del propio catálogo de estándares.
 *
 * Sigue el sistema editorial (docs/04-sistema-editorial.md), con el mismo
 * patrón de Transparencia (§9): cada categoría explica a qué pregunta
 * responde antes de desarrollarla.
 */
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import StatFigure from '@components/editorial/StatFigure.astro';
import EditorialStandards from '@components/sections/EditorialStandards.astro';
import { CONTACT } from '@lib/constants';
import {
  EDITORIAL_STANDARDS,
  CORRECTION_RESPONSE_HOURS,
  summarizeStandards,
} from '@lib/editorial-standards';

const summary = summarizeStandards(EDITORIAL_STANDARDS);

const contactSubject = encodeURIComponent('Consulta editorial - Club Trocha y Ruta');
const whatsappMessage = encodeURIComponent('Hola, quiero consultar sobre una publicación del club');
---

<BaseLayout
  title="Política Editorial"
  description="Cómo produce y corrige su contenido el Club Deportivo Trocha y Ruta: fuentes, plazo de corrección, conflictos de interés y protocolo de cobertura de menores."
>
  <!-- La promesa, respaldada por cifras reales -->
  <SectionShell
    tone="tinted"
    pattern="topo"
    width="wide"
    spacing="compact"
    labelledby="politica-editorial-titulo"
  >
    <Breadcrumb items={[{ label: 'Política Editorial' }]} />

    <div class="mt-6 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <SectionIntro
        as="h1"
        id="politica-editorial-titulo"
        eyebrow="Política Editorial"
        eyebrowIcon="ph:newspaper-bold"
        title="Contamos la actividad del club, verificada antes de publicarse"
        highlight="verificada antes de publicarse"
        lead="Trocha y Ruta es cronista de su propia actividad: no somos un medio independiente, pero cada dato se contrasta con una fuente antes de publicarse, y todo error tiene un canal de corrección con plazo de respuesta."
      />

      <div class="grid grid-cols-3 gap-6">
        <StatFigure
          value={summary.sourcesCount}
          label="Fuentes primarias declaradas"
          icon="ph:database-bold"
        />
        <StatFigure
          value={CORRECTION_RESPONSE_HOURS}
          unit="horas hábiles"
          label="Plazo de respuesta a correcciones"
          icon="ph:clock-bold"
        />
        <StatFigure
          value={summary.standardsCount}
          label="Estándares publicados"
          icon="ph:list-checks-bold"
        />
      </div>
    </div>
  </SectionShell>

  <!-- El corazón: qué responde cada estándar, antes de desarrollarlo -->
  <SectionShell tone="muted" width="wide" labelledby="estandares-titulo">
    <SectionIntro
      id="estandares-titulo"
      eyebrow="Cómo trabajamos"
      eyebrowIcon="ph:compass-bold"
      title="Qué cubre cada estándar, no solo su nombre"
      highlight="no solo su nombre"
      lead="De cómo se produce una crónica a qué protocolo sigue con los menores del club: cinco reglas, cada una explicada antes de desarrollarla."
      class="max-w-3xl"
    />

    <EditorialStandards standards={EDITORIAL_STANDARDS} tone="muted" class="mt-10 md:mt-12" />
  </SectionShell>

  <!-- Cierre: a quién escribirle -->
  <SectionShell
    tone="plain"
    width="default"
    spacing="compact"
    labelledby="contacto-editorial-titulo"
  >
    <div class="border-primary/15 bg-primary/5 rounded-2xl border p-6 text-center sm:p-8">
      <h2
        id="contacto-editorial-titulo"
        class="font-display text-text-primary text-lg font-bold sm:text-xl"
      >
        ¿Encontraste un error o tienes una consulta editorial?
      </h2>
      <p class="text-text-secondary mx-auto mt-2 max-w-xl">
        Escríbenos indicando la URL del contenido y qué habría que corregir.
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`mailto:${CONTACT.email}?subject=${contactSubject}`}
          class="bg-primary text-surface-dark hover:bg-primary-deep focus-visible:outline-primary inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors duration-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <Icon name="ph:envelope-bold" class="size-4" aria-hidden="true" />
          Escribir un correo
        </a>
        <a
          href={`${CONTACT.whatsapp}?text=${whatsappMessage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="border-primary-deep text-primary-deep hover:bg-primary-deep focus-visible:outline-primary inline-flex items-center gap-2 rounded-lg border-2 px-5 py-2.5 text-sm font-semibold transition-colors duration-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <Icon name="ph:whatsapp-logo-bold" class="size-4" aria-hidden="true" />
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </SectionShell>
</BaseLayout>
