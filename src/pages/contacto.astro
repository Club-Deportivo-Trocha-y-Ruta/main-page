---
/**
 * Contacto.
 *
 * Quien entra aquí está decidiendo si le confía su hijo al club, y no todas
 * las preguntas se responden por el mismo lado. La página abre eligiendo canal
 * —lo urgente por WhatsApp, lo que necesita detalle por el formulario, lo que
 * lleva adjuntos por correo, lo que solo se entiende viéndolo, en la pista—,
 * después el formulario, y luego las dos preguntas que todo el mundo hace
 * antes de escribir: cuándo entrenan y dónde queda.
 *
 * La semana sale de los `schedule` reales de la colección `programs`. Antes
 * había un bloque de "horarios de atención" escrito a mano que decía "Lunes a
 * Viernes 3:00 PM - 7:00 PM · Sábados 7:00 AM - 12:00 PM": ninguna de las dos
 * franjas coincidía con el contenido, y los domingos —que sí se entrena— no
 * aparecían por ningún lado.
 *
 * Sigue el sistema editorial (docs/04-sistema-editorial.md).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import StatFigure from '@components/editorial/StatFigure.astro';
import FactGrid from '@components/editorial/FactGrid.astro';
import ContactChannels from '@components/sections/ContactChannels.astro';
import WeekRhythm from '@components/sections/WeekRhythm.astro';
import ContactForm from '@components/interactive/ContactForm';
import { CONTACT } from '@lib/constants';
import { buildWeekRhythm, trainingPlaces, selectContactFaqs } from '@lib/contact';
import { generateFAQPageJsonLd } from '@lib/seo';

type Program = CollectionEntry<'programs'>;
type Faq = CollectionEntry<'faqs'>;

const asunto = Astro.url.searchParams.get('asunto') ?? undefined;

const programs = (await getCollection('programs'))
  .filter((program: Program) => !program.data.draft && program.data.active)
  .map((program: Program) => ({
    id: program.id,
    title: program.data.title,
    schedule: program.data.schedule,
    targetLevel: program.data.targetLevel,
    location: program.data.location,
    order: program.data.order,
  }));

const rhythm = buildWeekRhythm(programs);
const places = trainingPlaces(programs);

const faqs = selectContactFaqs((await getCollection('faqs')) as Faq[]);

// El JSON-LD declara exactamente las preguntas que se ven en pantalla.
const jsonLd =
  faqs.length > 0
    ? generateFAQPageJsonLd(faqs.map((faq) => ({ question: faq.data.question, answer: faq.data.answer })))
    : undefined;
---

<BaseLayout
  title="Contacto"
  description="Escríbenos por WhatsApp, por el formulario o por correo, y conoce la semana real de entrenamiento del Club Deportivo Trocha y Ruta en la Pista Carlos Castro de Yumbo."
  jsonLd={jsonLd}
>
  <!-- Elige por dónde -->
  <SectionShell
    tone="tinted"
    pattern="topo"
    width="wide"
    spacing="compact"
    labelledby="contacto-titulo"
  >
    <Breadcrumb items={[{ label: 'Contacto' }]} />

    <SectionIntro
      as="h1"
      id="contacto-titulo"
      class="mt-6 max-w-3xl"
      eyebrow="Contacto"
      eyebrowIcon="ph:chat-circle-dots-bold"
      title="Escríbenos por donde te quede mejor"
      highlight="por donde te quede mejor"
      lead="Cada canal sirve para algo distinto. Elige el que se parezca a lo que necesitas y te respondemos por ahí mismo."
    />

    <ContactChannels class="mt-10" />
  </SectionShell>

  <!-- El formulario -->
  <SectionShell id="escribir" tone="plain" width="wide" labelledby="escribir-titulo">
    <div class="grid gap-10 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
      <div>
        <SectionIntro
          id="escribir-titulo"
          eyebrow="Formulario"
          eyebrowIcon="ph:paper-plane-tilt-bold"
          title="Cuéntanos qué necesitas"
          highlight="qué necesitas"
          lead="Entre más nos digas de tu hijo o hija —la edad, si ya monta—, más concreta puede ser la respuesta."
        />
        <div class="mt-8">
          <ContactForm client:visible defaultSubject={asunto} />
        </div>
      </div>

      <div class="lg:pt-4">
        <h3 class="font-display text-lg font-bold text-text-primary">
          O directamente
        </h3>
        <FactGrid
          class="mt-4"
          columns={1}
          items={[
            { icon: 'ph:envelope-bold', label: 'Correo', value: CONTACT.email },
            { icon: 'ph:phone-bold', label: 'Teléfono', value: CONTACT.phone },
            { icon: 'ph:map-pin-bold', label: 'Dirección', value: CONTACT.address },
          ]}
        />

        <a
          href={`${CONTACT.whatsapp}?text=${encodeURIComponent('Hola, quiero información sobre el Club Deportivo Trocha y Ruta')}`}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="whatsapp_click"
          class="mt-6 flex items-center justify-center gap-2 rounded-lg bg-[#25D366] px-5 py-3 font-semibold text-white transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
        >
          <Icon name="ph:whatsapp-logo-bold" class="size-5 shrink-0" aria-hidden="true" />
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </SectionShell>

  <!-- Cuándo: la semana real -->
  <SectionShell tone="muted" width="wide" labelledby="semana-titulo">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <SectionIntro
        id="semana-titulo"
        class="max-w-2xl"
        eyebrow="Cuándo entrenamos"
        eyebrowIcon="ph:clock-bold"
        title="La semana del club, día por día"
        highlight="día por día"
        lead="Entre semana se entrena en la tarde, después del colegio; el fin de semana, temprano en la mañana. Cada franja sale del horario publicado de cada programa."
        tone="muted"
      />

      {rhythm.totalSessions > 0 && (
        <div class="flex gap-8">
          <StatFigure
            value={rhythm.activeDays}
            unit={rhythm.activeDays === 1 ? 'día' : 'días'}
            label="con entrenamiento"
            icon="ph:calendar-dots-bold"
            tone="muted"
          />
          <StatFigure
            value={rhythm.totalSessions}
            label="sesiones cada semana"
            icon="ph:bicycle-bold"
            tone="muted"
          />
        </div>
      )}
    </div>

    <WeekRhythm rhythm={rhythm} tone="muted" class="mt-10" />

    <p class="mt-8 text-sm text-text-secondary">
      Cada programa tiene su propio horario y su propio grupo.{' '}
      <a href="/programas" class="font-semibold text-primary-deep hover:underline"
        >Míralos en detalle</a
      >.
    </p>
  </SectionShell>

  <!-- Dónde -->
  <SectionShell id="donde" tone="plain" width="wide" labelledby="donde-titulo">
    <SectionIntro
      id="donde-titulo"
      class="max-w-2xl"
      eyebrow="Dónde entrenamos"
      eyebrowIcon="ph:map-pin-area-bold"
      title="La Pista Carlos Castro, en Yumbo"
      highlight="en Yumbo"
      lead="Es la casa del club, pero no todos los programas se quedan ahí: los mayores salen a rodar por fuera casi todas las sesiones."
    />

    <div class="mt-10 grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="overflow-hidden rounded-2xl border border-black/10">
        <iframe
          src={CONTACT.mapEmbed}
          width="100%"
          height="100%"
          class="aspect-video w-full"
          style="border:0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de la Pista de Ciclomontañismo Carlos Castro, Yumbo"></iframe>
      </div>

      <div>
        {places.length > 0 && (
          <>
            <h3 class="font-display text-lg font-bold text-text-primary">
              Dónde entrena cada programa
            </h3>
            <FactGrid
              class="mt-4"
              columns={1}
              items={places.map((place) => ({
                icon: 'ph:compass-bold',
                label: place.programTitle,
                value: place.location,
              }))}
            />
          </>
        )}

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
          <a
            href={CONTACT.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-primary-deep hover:underline"
          >
            <Icon name="ph:arrow-square-out-bold" class="size-4 shrink-0" aria-hidden="true" />
            Abrir en Google Maps
          </a>
          <p class="text-sm text-text-secondary">{CONTACT.address}</p>
        </div>
      </div>
    </div>
  </SectionShell>

  <!-- Quizá ya está respondido -->
  {faqs.length > 0 && (
    <SectionShell tone="tinted" width="default" spacing="compact" labelledby="faq-titulo">
      <SectionIntro
        id="faq-titulo"
        eyebrow="Antes de escribir"
        eyebrowIcon="ph:question-bold"
        title="Quizá ya está respondido"
        highlight="ya está respondido"
        lead="Las preguntas que más nos hacen las familias que llegan por primera vez."
      />

      <dl class="mt-8 space-y-5">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-primary/15 bg-surface/70 p-5 sm:p-6">
            <dt class="font-display text-base font-bold text-text-primary sm:text-lg">
              {faq.data.question}
            </dt>
            <dd class="mt-2 text-sm leading-relaxed text-text-secondary sm:text-base">
              {faq.data.answer}
            </dd>
          </div>
        ))}
      </dl>

      <a
        href="/preguntas-frecuentes"
        class="mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-deep hover:underline"
      >
        Ver todas las preguntas frecuentes
        <Icon name="ph:arrow-right-bold" class="size-4 shrink-0" aria-hidden="true" />
      </a>
    </SectionShell>
  )}
</BaseLayout>
