---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Button from '@components/common/Button.astro';
import SectionTitle from '@components/common/SectionTitle.astro';
import TrochaVerdeStats from '@components/sections/TrochaVerdeStats.astro';
import TrochaVerdeNav from '@components/sections/TrochaVerdeNav.astro';
import TrochaVerdeSiembras from '@components/sections/TrochaVerdeSiembras.astro';
import TrochaVerdeSponsors from '@components/sections/TrochaVerdeSponsors.astro';
// TrochaVerdeGrid en reserva — reintroducir como /trocha-verde/arboles cuando >40 árboles
// import TrochaVerdeGrid from '@components/sections/TrochaVerdeGrid.astro';
import { Icon } from 'astro-icon/components';
import { CONTACT } from '@lib/constants';
import { generateBreadcrumbJsonLd, generateSocialInitiativeJsonLd } from '@lib/seo';
import { slugify } from '@lib/utils';
import { categoryLabels, categoryColors, journeyLabels } from '@lib/tree-utils';
import carretillaAntes from '@assets/images/trocha-verde/carretilla-reciclada.jpg';
import carretillaDespues from '@assets/images/trocha-verde/carretilla-despues.jpg';

type Tree = CollectionEntry<'trees'>;

const trees = (await getCollection('trees'))
  .filter((t: Tree) => !t.data.draft)
  .sort((a: Tree, b: Tree) => a.data.order - b.data.order);

const totalTrees = trees.length;

// Inventario por especie (sin render de Markdown)
type SpeciesEntry = {
  commonName: string;
  scientificName: string;
  category: string;
  count: number;
  thumbnail: string;
  thumbnailAlt: string;
};
const speciesMap = new Map<string, SpeciesEntry>();
trees.forEach((t: Tree) => {
  const key = t.data.scientificName ?? t.data.species;
  if (speciesMap.has(key)) {
    speciesMap.get(key)!.count++;
  } else {
    speciesMap.set(key, {
      commonName: t.data.species,
      scientificName: t.data.scientificName ?? '',
      category: t.data.category,
      count: 1,
      thumbnail: t.data.image,
      thumbnailAlt: t.data.imageAlt,
    });
  }
});
const uniqueSpecies = speciesMap.size;
const sortedSpecies = [...speciesMap.values()].sort((a, b) =>
  a.commonName.localeCompare(b.commonName, 'es')
);

// Agrupar árboles por fecha de siembra (jornadas) — sin Content renderizado
type TreeItem = {
  id: string;
  species: string;
  scientificName?: string;
  category: string;
  status: string;
  plantedDate: Date;
  image: string;
  imageAlt: string;
  protectorColor?: string;
  notes?: string;
};

const treesByDate = new Map<string, { date: Date; trees: TreeItem[] }>();
trees.forEach((t: Tree) => {
  const dateKey = t.data.plantedDate.toISOString().split('T')[0];
  const item: TreeItem = {
    id: t.id,
    species: t.data.species,
    scientificName: t.data.scientificName,
    category: t.data.category,
    status: t.data.status,
    plantedDate: t.data.plantedDate,
    image: t.data.image,
    imageAlt: t.data.imageAlt,
    protectorColor: t.data.protectorColor,
    notes: t.data.notes,
  };
  if (!treesByDate.has(dateKey)) {
    treesByDate.set(dateKey, { date: t.data.plantedDate, trees: [] });
  }
  treesByDate.get(dateKey)!.trees.push(item);
});

// Ordenar jornadas cronológicamente — excluir Día de la Tierra temporalmente
const sortedDates = [...treesByDate.keys()]
  .sort()
  .filter(date => date !== '2026-04-22');

const journeys = sortedDates.map((dateKey, index) => ({
  dateKey,
  date: treesByDate.get(dateKey)!.date,
  label: journeyLabels[index] ?? `Siembra #${index + 1}`,
  trees: treesByDate.get(dateKey)!.trees,
}));

// WhatsApp URLs
const whatsappFamilias = `${CONTACT.whatsapp}?text=${encodeURIComponent('Hola, quiero unirme a la próxima siembra de Trocha Verde')}`;

const breadcrumbs = [{ label: 'Trocha Verde' }];

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: 'Inicio', url: '/' },
  { name: 'Trocha Verde', url: '/trocha-verde' },
]);

const initiativeJsonLd = generateSocialInitiativeJsonLd({
  title: 'Trocha Verde — Programa Ambiental',
  date: new Date('2026-03-15'),
  description: `Programa de reforestación del Club Trocha y Ruta: ${totalTrees} árboles nativos sembrados con llantas de bicicleta recicladas en la Pista Carlos Castro, Yumbo, Valle del Cauca.`,
  location: 'Pista de Ciclomontañismo Carlos Castro, Yumbo, Valle del Cauca',
  image: '/images/trocha-verde/dia-tierra-2026/afiche.jpg',
  url: '/trocha-verde',
  type: 'ambiental',
});

const jsonLd = [breadcrumbJsonLd, initiativeJsonLd];

const processSteps = [
  {
    number: '01',
    title: 'Recolectamos',
    description: 'Recogemos llantas de bicicleta usadas y otros materiales que ya no se utilizan.',
    icon: 'ph:recycle-bold',
  },
  {
    number: '02',
    title: 'Pintamos',
    description: 'Los niños del club pintan las llantas con colores brillantes, dándoles nueva vida.',
    icon: 'ph:palette-bold',
  },
  {
    number: '03',
    title: 'Sembramos',
    description: 'Plantamos árboles nativos dentro de las llantas, que sirven como protectores naturales.',
    icon: 'ph:plant-bold',
  },
  {
    number: '04',
    title: 'Acompañamos',
    description: 'Cada árbol recibe un letrero artesanal pintado a mano y seguimiento constante de los niños.',
    icon: 'ph:hand-heart-bold',
  },
];
---

<PageLayout
  title="Trocha Verde"
  description={`Programa de reforestación del Club Trocha y Ruta: ${totalTrees} árboles nativos sembrados con llantas de bicicleta recicladas en Yumbo, Valle del Cauca`}
  ogImage="/images/trocha-verde/dia-tierra-2026/afiche.jpg"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <!-- 1. Hero compacto -->
  <div class="relative -mt-8 mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-800 via-emerald-700 to-emerald-500 px-6 py-12 text-white sm:px-10 sm:py-16">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
      <svg class="h-full w-full" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="50" r="40" fill="currentColor" />
        <circle cx="350" cy="100" r="60" fill="currentColor" />
        <circle cx="150" cy="350" r="50" fill="currentColor" />
        <circle cx="300" cy="300" r="35" fill="currentColor" />
      </svg>
    </div>
    <div class="relative z-10 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-200">
        Programa Ambiental
      </p>
      <p class="mt-2 font-display text-3xl font-bold sm:text-4xl md:text-5xl">
        Donde cada pedalada deja raíces
      </p>
      <!-- Misión — 2 líneas compactas -->
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-emerald-100 sm:text-lg">
        Nuestros niños pedalean por los cerros de Yumbo — y aprenden que cuidar esos senderos es cuidar su deporte.
        Cada llanta que pintamos y cada árbol nativo que sembramos es una lección viva: el Valle se defiende con las manos.
      </p>

      <!-- Contadores animados (4 stats inline) -->
      <TrochaVerdeStats />

      <!-- CTAs -->
      <div class="mt-8 flex flex-wrap justify-center gap-3 sm:gap-4">
        <a
          href={whatsappFamilias}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-bold text-text-primary shadow-sm transition-colors hover:bg-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:px-6 sm:py-3 sm:text-base"
          data-whatsapp-cta
          data-source="trocha-verde"
          data-location="hero"
          aria-label="Únete a la próxima siembra por WhatsApp"
        >
          <Icon name="ph:whatsapp-logo-bold" class="h-5 w-5" aria-hidden="true" />
          Únete a la próxima siembra
        </a>
        <a
          href="#sponsors"
          class="inline-flex items-center gap-2 rounded-full border border-white/40 bg-white/10 px-5 py-2.5 text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:px-6 sm:py-3 sm:text-base"
          data-sticky-nav-click
          data-section="sponsors"
        >
          Empresas: apadrina árboles
        </a>
      </div>
    </div>
  </div>

  <!-- 2. Sticky nav -->
  <TrochaVerdeNav />

  <!-- 3. Inventario por especie -->
  <section id="especies" class="mb-16 scroll-mt-28" aria-labelledby="especies-title">
    <SectionTitle
      title="Inventario de Especies"
      subtitle={`${uniqueSpecies} especies distintas sembradas en la pista`}
    />

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4">
      {sortedSpecies.map((sp) => {
        const catColors = categoryColors[sp.category] ?? categoryColors.nativo;
        const speciesSlug = slugify(sp.commonName);
        return (
          <a
            href={`/trocha-verde/${speciesSlug}`}
            class="flex flex-col overflow-hidden rounded-xl border border-emerald-100 bg-white transition-shadow hover:shadow-md focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-emerald-700"
            data-tree-card
            data-species={sp.commonName}
            data-tree-id={speciesSlug}
          >
            <div class="aspect-square overflow-hidden bg-surface-muted">
              {/* Thumbnails vienen de Cloudinary (URL remota) — se mantiene <img> con lazy + dims */}
              <img
                src={sp.thumbnail}
                alt={sp.thumbnailAlt}
                class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                loading="lazy"
                width="200"
                height="200"
              />
            </div>
            <div class="flex flex-1 flex-col justify-between p-3">
              <div>
                <p class="font-display text-sm font-bold leading-tight text-text-primary">
                  {sp.commonName}
                </p>
                {sp.scientificName && (
                  <p class="mt-0.5 line-clamp-2 text-xs italic leading-tight text-text-secondary">
                    {sp.scientificName}
                  </p>
                )}
              </div>
              <div class="mt-2 flex items-center justify-between">
                <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${catColors.bg} ${catColors.text}`}>
                  {categoryLabels[sp.category] ?? sp.category}
                </span>
                <span
                  class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-700 text-xs font-bold text-white"
                  aria-label={`${sp.count} ${sp.count === 1 ? 'árbol sembrado' : 'árboles sembrados'}`}
                >
                  {sp.count}
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 4. Timeline de Siembras -->
  <TrochaVerdeSiembras journeys={journeys} />

  <!-- 5. Sponsors block -->
  <TrochaVerdeSponsors />

  <!-- 6. El Proceso -->
  <section id="proceso" class="mb-16 scroll-mt-28" aria-labelledby="proceso-title">
    <SectionTitle
      title="El Proceso"
      subtitle="Así transformamos residuos en vida"
    />

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {processSteps.map((step) => (
        <div class="relative rounded-xl border border-emerald-100 bg-white p-6 text-center">
          <div
            class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-700"
            role="img"
            aria-label={`Paso ${step.number}: ${step.title}`}
          >
            <Icon name={step.icon} class="h-7 w-7" aria-hidden="true" />
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-500">
            Paso {step.number}
          </span>
          <h3 class="mt-1 font-display text-lg font-bold text-text-primary">
            {step.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- 7. Antes y Después -->
  <section class="mb-16" aria-labelledby="transformacion-title">
    <SectionTitle
      title="Transformación en acción"
      subtitle="Una carretilla reciclada que pasó de estar abandonada a ser herramienta clave de nuestras siembras"
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <figure class="overflow-hidden rounded-xl border border-emerald-100 bg-white">
        <div class="aspect-[4/3] overflow-hidden md:aspect-[3/4]">
          <Image
            src={carretillaAntes}
            alt="Carretilla reciclada antes de ser utilizada en las siembras de Trocha Verde"
            class="h-full w-full object-cover"
          />
        </div>
        <figcaption class="p-4 text-center">
          <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800">
            Antes
          </span>
          <p class="mt-2 text-sm text-text-secondary">
            Carretilla recuperada y lista para darle un nuevo propósito
          </p>
        </figcaption>
      </figure>

      <figure class="overflow-hidden rounded-xl border border-emerald-100 bg-white">
        <div class="aspect-[4/3] overflow-hidden md:aspect-[3/4]">
          <Image
            src={carretillaDespues}
            alt="Carretilla en uso transportando tierra para la siembra de árboles nativos"
            class="h-full w-full object-cover"
          />
        </div>
        <figcaption class="p-4 text-center">
          <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-sm font-semibold text-emerald-800">
            Después
          </span>
          <p class="mt-2 text-sm text-text-secondary">
            En plena jornada de siembra, transportando tierra para nuestros árboles
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 8. CTA final -->
  <section
    class="rounded-2xl bg-gradient-to-r from-emerald-50 to-emerald-100 px-6 py-12 text-center sm:px-10"
    aria-labelledby="cta-final-title"
  >
    <h2
      id="cta-final-title"
      class="font-display text-2xl font-bold text-text-primary sm:text-3xl"
    >
      ¿Quieres sembrar con nosotros?
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-text-secondary">
      Únete a nuestras jornadas de siembra. Familias, empresas y amigos del medio ambiente son bienvenidos.
      Juntos hacemos de Yumbo un lugar más verde.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <Button
        href={whatsappFamilias}
        variant="accent"
        size="lg"
        data-whatsapp-cta
        data-source="trocha-verde"
        data-location="footer"
      >
        Escríbenos por WhatsApp
      </Button>
      <Button href="/contacto" variant="outline">
        Contáctanos
      </Button>
    </div>
  </section>
</PageLayout>

<script>
  /**
   * GA4 custom events — Trocha Verde
   * Requires gtag() available via @astrojs/partytown + consent mode v2.
   * No PII in any parameter.
   */

  // Declaración de tipo para gtag en window (puede no estar disponible si partytown no cargó)
  declare function gtag(...args: unknown[]): void;

  function sendEvent(name: string, params: Record<string, string>) {
    if (typeof gtag === 'function') {
      gtag('event', name, params);
    }
  }

  function initTrochaVerdeAnalytics() {

    // sticky_nav_click: clicks en TrochaVerdeNav anchors
    document.querySelectorAll<HTMLAnchorElement>('[data-sticky-nav-click]').forEach((el) => {
      el.addEventListener('click', () => {
        const section = el.dataset.section ?? el.getAttribute('href')?.replace('#', '') ?? 'unknown';
        sendEvent('sticky_nav_click', { section });
      });
    });

    // whatsapp_cta_click: todos los CTAs de WhatsApp en la página
    document.querySelectorAll<HTMLElement>('[data-whatsapp-cta]').forEach((el) => {
      el.addEventListener('click', () => {
        sendEvent('whatsapp_cta_click', {
          source: el.dataset.source ?? 'trocha-verde',
          location: el.dataset.location ?? 'unknown',
        });
      });
    });

    // tree_card_click: tarjetas de árbol o especie
    document.querySelectorAll<HTMLElement>('[data-tree-card]').forEach((el) => {
      el.addEventListener('click', () => {
        sendEvent('tree_card_click', {
          species: el.dataset.species ?? 'unknown',
          tree_id: el.dataset.treeId ?? 'unknown',
        });
      });
    });

    // jornada_accordion_open: apertura de acordeones de siembra
    document.querySelectorAll<HTMLDetailsElement>('[data-journey-accordion]').forEach((el) => {
      const dateKey = el.querySelector('summary')?.id?.replace('journey-summary-', '') ?? 'unknown';
      el.addEventListener('toggle', () => {
        if (el.open) {
          sendEvent('jornada_accordion_open', { jornada_id: dateKey });
        }
      });
    });
  }

  // Inicializar en carga normal y tras View Transitions
  initTrochaVerdeAnalytics();
  document.addEventListener('astro:page-load', initTrochaVerdeAnalytics);
</script>
