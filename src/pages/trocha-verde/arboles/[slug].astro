---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { slugify, formatDate } from '@lib/utils';
import { generateBreadcrumbJsonLd } from '@lib/seo';

type Tree = CollectionEntry<'trees'>;

export async function getStaticPaths() {
  const allTrees = await getCollection('trees', (t: Tree) => !t.data.draft);
  return allTrees.map((tree: Tree) => ({
    params: { slug: tree.id },
    props: { tree },
  }));
}

const { tree } = Astro.props as { tree: Tree };
const { Content } = await render(tree);

const categoryLabels: Record<string, string> = {
  frutal: 'Frutal',
  ornamental: 'Ornamental',
  nativo: 'Nativo',
  maderable: 'Maderable',
};
const categoryColors: Record<string, { bg: string; text: string }> = {
  frutal: { bg: 'bg-amber-100', text: 'text-amber-700' },
  ornamental: { bg: 'bg-purple-100', text: 'text-purple-900' },
  nativo: { bg: 'bg-emerald-100', text: 'text-emerald-700' },
  maderable: { bg: 'bg-orange-100', text: 'text-orange-700' },
};
const statusLabels: Record<string, string> = {
  sembrado: 'Sembrado',
  creciendo: 'Creciendo',
  floreciendo: 'Floreciendo',
};

const catColors = categoryColors[tree.data.category] || categoryColors.nativo;
const speciesSlug = slugify(tree.data.species);

const protectorLabel = tree.data.protectorColor
  ? `Llanta ${tree.data.protectorColor}`
  : undefined;

const treeNumber = tree.id.match(/-(\d+)$/)?.[1];
const treeLabel = treeNumber ? `${tree.data.species} ${treeNumber}` : tree.data.species;

const breadcrumbs = [
  { label: 'Trocha Verde', href: '/trocha-verde' },
  { label: tree.data.species, href: `/trocha-verde/${speciesSlug}` },
  { label: treeLabel },
];

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: 'Inicio', url: '/' },
  { name: 'Trocha Verde', url: '/trocha-verde' },
  { name: tree.data.species, url: `/trocha-verde/${speciesSlug}` },
  { name: treeLabel, url: `/trocha-verde/arboles/${tree.id}` },
]);

const pageTitle = `${tree.data.species} — Trocha Verde`;
const pageDescription =
  tree.data.notes ??
  `Árbol de ${tree.data.species} sembrado el ${formatDate(tree.data.plantedDate)} en la Pista de Ciclomontañismo Carlos Castro, Yumbo.`;
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={tree.data.image}
  breadcrumbs={breadcrumbs}
  jsonLd={[breadcrumbJsonLd]}
>
  <!-- Hero árbol -->
  <div class="relative -mt-8 mb-12 overflow-hidden rounded-2xl">
    <img
      src={tree.data.image}
      alt={tree.data.imageAlt}
      class="h-64 w-full object-cover sm:h-80"
      loading="eager"
      width="1200"
      height="320"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/80 to-transparent" />
    <div class="absolute bottom-0 left-0 p-6 sm:p-8">
      <span
        class={`inline-flex items-center rounded-full px-3 py-1 text-sm font-medium ${catColors.bg} ${catColors.text}`}
      >
        {categoryLabels[tree.data.category]}
      </span>
      <h2 class="mt-2 font-display text-3xl font-bold text-white sm:text-4xl">
        {tree.data.species}
      </h2>
      {tree.data.scientificName && (
        <p class="mt-1 text-lg italic text-emerald-200">{tree.data.scientificName}</p>
      )}
    </div>
  </div>

  <!-- Datos rápidos -->
  <div
    class="mb-12 flex flex-wrap gap-3"
    role="region"
    aria-label="Datos del árbol"
  >
    <div class="flex items-center gap-3 rounded-xl border border-emerald-100 bg-white px-5 py-4">
      <Icon name="ph:calendar-bold" class="h-5 w-5 shrink-0 text-emerald-600" aria-hidden="true" />
      <div>
        <p class="font-display text-sm font-bold text-text-primary">Fecha de siembra</p>
        <p class="text-sm text-text-secondary">{formatDate(tree.data.plantedDate)}</p>
      </div>
    </div>

    {tree.data.donor && (
      <div class="flex items-center gap-3 rounded-xl border border-emerald-100 bg-white px-5 py-4">
        <Icon name="ph:heart-bold" class="h-5 w-5 shrink-0 text-emerald-600" aria-hidden="true" />
        <div>
          <p class="font-display text-sm font-bold text-text-primary">Donado por</p>
          <p class="text-sm text-text-secondary">{tree.data.donor}</p>
        </div>
      </div>
    )}

    <div class="flex items-center gap-3 rounded-xl border border-emerald-100 bg-white px-5 py-4">
      <Icon name="ph:map-pin-bold" class="h-5 w-5 shrink-0 text-emerald-600" aria-hidden="true" />
      <div>
        <p class="font-display text-sm font-bold text-text-primary">Ubicación</p>
        <p class="text-sm text-text-secondary">{tree.data.location}</p>
      </div>
    </div>

    <div class="flex items-center gap-3 rounded-xl border border-emerald-100 bg-white px-5 py-4">
      <Icon name="ph:plant-bold" class="h-5 w-5 shrink-0 text-emerald-600" aria-hidden="true" />
      <div>
        <p class="font-display text-sm font-bold text-text-primary">Estado</p>
        <p class="text-sm text-text-secondary">{statusLabels[tree.data.status]}</p>
      </div>
    </div>

    {protectorLabel && (
      <div class="flex items-center gap-3 rounded-xl border border-emerald-100 bg-white px-5 py-4">
        <Icon name="ph:shield-bold" class="h-5 w-5 shrink-0 text-emerald-600" aria-hidden="true" />
        <div>
          <p class="font-display text-sm font-bold text-text-primary">Protector</p>
          <p class="text-sm text-text-secondary">{protectorLabel}</p>
        </div>
      </div>
    )}
  </div>

  <!-- Contenido markdown -->
  <div class="prose prose-emerald mb-12 max-w-none">
    <Content />
  </div>

  <!-- CO₂ estimado -->
  {tree.data.co2EstimateKg && (
    <div
      class="mb-12 flex items-start gap-4 rounded-xl border border-emerald-200 bg-emerald-50 p-6"
      role="region"
      aria-label={`CO₂ estimado: ${tree.data.co2EstimateKg} kg por año`}
    >
      <Icon
        name="ph:leaf-bold"
        class="mt-0.5 h-6 w-6 shrink-0 text-emerald-600"
        aria-hidden="true"
      />
      <div>
        <p class="font-display font-bold text-emerald-800">Captura de CO₂ estimada</p>
        <p class="mt-1 text-sm leading-relaxed text-emerald-700">
          ~{tree.data.co2EstimateKg} kg CO₂/año estimado al alcanzar su madurez
        </p>
      </div>
    </div>
  )}

  <!-- Acciones -->
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
    <a
      href={`/trocha-verde/${speciesSlug}`}
      class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
    >
      Ver más sobre {tree.data.species}
      <Icon name="ph:arrow-right-bold" class="h-4 w-4" aria-hidden="true" />
    </a>

    <a
      href="/trocha-verde"
      class="inline-flex items-center gap-2 rounded-lg border border-emerald-200 bg-white px-5 py-3 text-sm font-medium text-emerald-700 transition-colors hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
    >
      <Icon name="ph:arrow-left-bold" class="h-4 w-4" aria-hidden="true" />
      Volver a Trocha Verde
    </a>
  </div>
</PageLayout>
