---
/**
 * Ficha de un árbol concreto de Trocha Verde.
 *
 * El árbol abre como protagonista —su foto, su especie (con enlace), cuánto
 * lleva vivo desde `plantedDate`— y se respalda con lo que su contenido trae:
 * el padrino cuando existe (el dato más humano de la ficha, 60 de 77 lo
 * tienen), con qué protector lo cuida el club y por qué, su estado y la nota
 * real escrita para él. Cierra con los demás árboles de su especie y cómo
 * apadrinar el próximo.
 *
 * Hermana de `/trocha-verde/[species]`: mismo sistema editorial (docs/04,
 * sección 12 — hero + contexto + datos + paso siguiente), mismos mapas y
 * helpers de `@lib/tree-utils`.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import ShareButtons from '@components/common/ShareButtons.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import StatFigure from '@components/editorial/StatFigure.astro';
import FactGrid from '@components/editorial/FactGrid.astro';
import TreeCard from '@components/sections/TreeCard.astro';
import { CONTACT } from '@lib/constants';
import { generateBreadcrumbJsonLd } from '@lib/seo';
import { formatDate } from '@lib/utils';
import {
  categoryLabels,
  categoryColors,
  statusLabels,
  getProtector,
  protectorDescription,
  protectorStory,
  timeSincePlanted,
  findSpeciesForTree,
  treesOfSpecies,
  treeDisplayLabel,
  speciesGrammar,
} from '@lib/tree-utils';

type Tree = CollectionEntry<'trees'>;
type SpeciesEntry = CollectionEntry<'species'>;

export async function getStaticPaths() {
  const allTrees = await getCollection('trees', (t: Tree) => !t.data.draft);
  return allTrees.map((tree: Tree) => ({
    params: { slug: tree.id },
    props: { tree },
  }));
}

const { tree } = Astro.props as { tree: Tree };
const { Content } = await render(tree);

const allSpecies = await getCollection('species', (s: SpeciesEntry) => !s.data.draft);
const allTrees = await getCollection('trees', (t: Tree) => !t.data.draft);

// La especie del árbol puede no tener ficha propia todavía (pasa con "Abano",
// sembrado el Día de la Tierra sin species/abano.md): el enlace se omite en
// vez de apuntar a una ruta que no existe.
const speciesEntry = findSpeciesForTree(tree, allSpecies);
const speciesLike = speciesEntry ?? { id: tree.id, data: { commonName: tree.data.species } };
const speciesTrees = treesOfSpecies(allTrees, speciesLike);
const treeLabel = treeDisplayLabel(tree, speciesTrees);

const siblingTrees = speciesTrees.filter((entry) => entry.id !== tree.id);
const SIBLING_DISPLAY_LIMIT = 6;
const siblingsToShow = siblingTrees.slice(0, SIBLING_DISPLAY_LIMIT);
const hiddenSiblingsCount = siblingTrees.length - siblingsToShow.length;

const grammar = speciesGrammar(speciesEntry?.data ?? { commonName: tree.data.species });
const otherWord = grammar.article === 'las' ? 'Otras' : 'Otros';

const catColors = categoryColors[tree.data.category] ?? categoryColors.nativo;
const catLabel = categoryLabels[tree.data.category] ?? tree.data.category;
const statusLabel = statusLabels[tree.data.status] ?? tree.data.status;
const scientificName = tree.data.scientificName ?? speciesEntry?.data.scientificName;

// Cuánto lleva vivo, no solo cuándo se sembró.
const duration = timeSincePlanted(tree.data.plantedDate);
const leadSentence = `Lleva ${duration.value} ${duration.unit} creciendo en la pista Carlos Castro.`;

const protectorInfo = getProtector(tree.data.protector);
const protectorText = protectorDescription(tree.data.protector, tree.data.protectorColor);

const speciesUrl = speciesEntry ? `/trocha-verde/${speciesEntry.id}` : undefined;

const breadcrumbItems = [
  { label: 'Trocha Verde', href: '/trocha-verde' },
  speciesEntry
    ? { label: speciesEntry.data.commonName, href: speciesUrl }
    : { label: tree.data.species },
  { label: treeLabel },
];

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: 'Inicio', url: '/' },
  { name: 'Trocha Verde', url: '/trocha-verde' },
  { name: speciesEntry?.data.commonName ?? tree.data.species, url: speciesUrl ?? '/trocha-verde' },
  { name: treeLabel, url: `/trocha-verde/arboles/${tree.id}` },
]);

const pageTitle = `${treeLabel} | Trocha Verde`;

const whatsappApadrinar = `${CONTACT.whatsapp}?text=${encodeURIComponent(
  `Hola, quiero apadrinar un árbol de ${tree.data.species} en Trocha Verde`
)}`;
---

<BaseLayout
  title={pageTitle}
  description={tree.data.notes}
  ogImage={tree.data.image}
  jsonLd={[breadcrumbJsonLd]}
>
  <!-- El árbol como protagonista -->
  <SectionShell
    tone="tinted"
    pattern="topo"
    width="wide"
    spacing="compact"
    labelledby="arbol-titulo"
  >
    <Breadcrumb items={breadcrumbItems} />

    <div class="mt-6 grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
      <SectionIntro
        as="h1"
        id="arbol-titulo"
        eyebrow="Trocha Verde"
        eyebrowIcon="ph:tree-bold"
        title={treeLabel}
        lead={leadSentence}
      >
        <div class="mt-3 flex flex-wrap items-center gap-3">
          {speciesEntry ? (
            <a
              href={speciesUrl}
              class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary-deep transition-colors duration-200 hover:bg-primary/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-deep"
            >
              <Icon name="ph:tree-bold" class="size-3.5" aria-hidden="true" />
              {speciesEntry.data.commonName}
            </a>
          ) : (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-muted px-3 py-1 text-sm font-medium text-text-secondary">
              <Icon name="ph:tree-bold" class="size-3.5" aria-hidden="true" />
              {tree.data.species}
            </span>
          )}
          <span
            class={`inline-flex items-center rounded-full px-3 py-1 text-sm font-medium ${catColors.bg} ${catColors.text}`}
          >
            {catLabel}
          </span>
          {scientificName && <p class="font-display text-sm italic text-text-secondary">{scientificName}</p>}
        </div>

        <FactGrid
          class="mt-6"
          columns={2}
          items={[
            { icon: 'ph:map-pin-bold', label: 'Dónde crece', value: tree.data.location },
            { icon: 'ph:plant-bold', label: 'Estado', value: statusLabel },
          ]}
        />
      </SectionIntro>

      <img
        src={tree.data.image}
        alt={tree.data.imageAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="800"
        height="600"
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-md"
      />
    </div>

    <div class="mt-8 max-w-2xl space-y-4">
      {tree.data.donor && (
        <aside
          class="flex gap-3 rounded-2xl border border-primary/15 bg-surface/70 p-5 backdrop-blur-sm sm:p-6"
          aria-label="Padrino del árbol"
        >
          <Icon name="ph:heart-bold" class="mt-0.5 size-5 shrink-0 text-accent-deep" aria-hidden="true" />
          <div>
            <p class="font-display text-sm font-bold text-text-primary">Este árbol tiene padrino</p>
            <p class="mt-1 text-sm leading-relaxed text-text-secondary">
              {tree.data.donor} lo sembró para la pista Carlos Castro.
            </p>
          </div>
        </aside>
      )}

      <aside
        class="flex gap-3 rounded-2xl border border-primary/15 bg-surface/70 p-5 backdrop-blur-sm sm:p-6"
        aria-label="Cómo se protege este árbol"
      >
        <Icon name={protectorInfo.icon} class="mt-0.5 size-5 shrink-0 text-primary-deep" aria-hidden="true" />
        <div>
          <p class="font-display text-sm font-bold text-text-primary">Cómo lo protegemos</p>
          <p class="mt-1 text-sm leading-relaxed text-text-secondary">
            {protectorText}. {protectorStory(tree.data.protector)}
          </p>
        </div>
      </aside>
    </div>

    <!-- Cifras que respaldan el titular: cuánto lleva vivo, con qué lo cuidamos -->
    <div class="mt-8 grid grid-cols-1 gap-6 border-t border-primary/15 pt-8 sm:max-w-xl sm:grid-cols-2">
      <StatFigure
        value={duration.value}
        unit={duration.unit}
        label="Lleva creciendo en la pista"
        note={`Sembrado el ${formatDate(tree.data.plantedDate)}`}
        icon="ph:hourglass-medium-bold"
      />
      <StatFigure
        value={protectorText}
        size="sm"
        label="Protegido con"
        icon={protectorInfo.icon}
      />
    </div>
  </SectionShell>

  <!-- Los demás árboles de su especie -->
  {siblingsToShow.length > 0 && (
    <SectionShell tone="muted" width="wide" labelledby="mas-arboles-titulo">
      <SectionIntro
        id="mas-arboles-titulo"
        eyebrow="Misma especie"
        eyebrowIcon="ph:tree-bold"
        title={`${otherWord} ${grammar.plural} en la pista`}
        lead="Cada ficha trae su propia fecha de siembra y, cuando lo hay, el nombre de quien la sembró."
        class="max-w-2xl"
      />

      <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" role="list">
        {siblingsToShow.map((sibling, index) => (
          <li class="reveal" style={`--stagger:${Math.min(index, 3) * 60}ms`}>
            <TreeCard
              id={sibling.id}
              label={treeDisplayLabel(sibling, speciesTrees)}
              image={sibling.data.image}
              imageAlt={sibling.data.imageAlt}
              plantedDate={sibling.data.plantedDate}
              status={sibling.data.status}
              donor={sibling.data.donor}
            />
          </li>
        ))}
      </ul>

      {hiddenSiblingsCount > 0 && speciesEntry && (
        <p class="mt-6 text-sm text-text-secondary">
          <a href={speciesUrl} class="font-semibold text-primary-deep hover:underline">
            Ver {grammar.article} {speciesTrees.length} {grammar.plural} →
          </a>
        </p>
      )}
    </SectionShell>
  )}

  <!-- La historia de este árbol: la nota real del club + el cuerpo editorial -->
  <SectionShell tone="plain" width="default" labelledby="sobre-titulo">
    <SectionIntro
      id="sobre-titulo"
      eyebrow="Sobre este árbol"
      eyebrowIcon="ph:notepad-bold"
      title="Este árbol tiene su propia historia"
      highlight="propia historia"
      lead={tree.data.notes}
      class="max-w-2xl"
    />

    <div class="prose prose-lg mt-8 max-w-3xl">
      <Content />
    </div>

    <div class="mt-8 max-w-3xl border-t border-black/10 pt-6">
      <ShareButtons title={treeLabel} description={tree.data.notes} />
    </div>
  </SectionShell>

  <!-- Paso siguiente -->
  <SectionShell tone="muted" width="default" spacing="compact" label="Paso siguiente">
    <div class="rounded-2xl border border-primary/20 bg-primary/5 px-6 py-8 text-center sm:px-10">
      <h2 class="font-display text-xl font-bold text-text-primary sm:text-2xl">
        Trocha Verde sigue creciendo
      </h2>
      <p class="mx-auto mt-2 max-w-xl text-text-secondary">
        Recorre el resto de especies sembradas en la pista Carlos Castro o escríbenos si quieres
        apadrinar el próximo árbol.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        {speciesEntry && (
          <a
            href={speciesUrl}
            class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-deep px-5 py-2.5 text-sm font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-deep"
          >
            <Icon name="ph:arrow-left-bold" class="size-4" aria-hidden="true" />
            Ver toda la especie
          </a>
        )}
        <a
          href="/trocha-verde"
          class="inline-flex items-center gap-2 rounded-lg bg-primary-deep px-5 py-2.5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-deep"
        >
          <Icon name="ph:tree-bold" class="size-4" aria-hidden="true" />
          Ver todo Trocha Verde
        </a>
        <a
          href={whatsappApadrinar}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="whatsapp_click"
          class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-deep px-5 py-2.5 text-sm font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-deep"
        >
          <Icon name="ph:whatsapp-logo-bold" class="size-4" aria-hidden="true" />
          Apadrinar un árbol
        </a>
      </div>
    </div>
  </SectionShell>
</BaseLayout>
