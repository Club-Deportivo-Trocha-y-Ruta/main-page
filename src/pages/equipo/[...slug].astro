---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import Badge from '@components/common/Badge.astro';
import { getCategoryLabel, getAge } from '@lib/utils';
import { SITE } from '@lib/constants';

type Rider = CollectionEntry<'riders'>;

export async function getStaticPaths() {
  const riders = await getCollection('riders');
  return riders
    .filter((r: Rider) => !r.data.draft)
    .map((r: Rider) => ({ params: { slug: r.id }, props: { rider: r } }));
}

const { rider } = Astro.props as { rider: Rider };
const { Content } = await render(rider);
const { name, category, specialty, birthDate, yearJoined, dorsalNumber, achievements } = rider.data;
const age = getAge(birthDate);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  memberOf: { '@type': 'SportsOrganization', name: SITE.name, url: SITE.url },
};

const badgeVariant: Record<string, 'primary' | 'accent' | 'cyan' | 'neutral'> = {
  juvenil: 'primary',
  infantil: 'cyan',
  'pre-infantil': 'cyan',
  elite: 'accent',
  sub23: 'primary',
  master: 'neutral',
};
---

<BaseLayout title={name} jsonLd={jsonLd}>
  <article class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <Breadcrumb items={[{ label: 'Equipo', href: '/equipo' }, { label: name }]} />

    <div class="grid md:grid-cols-3 gap-8 md:gap-12">
      <!-- Foto -->
      <div class="md:col-span-1">
        <div
          class="aspect-[3/4] max-w-xs mx-auto md:max-w-none bg-surface-muted rounded-2xl"
          role="img"
          aria-label={`Foto de ${name}`}
        >
        </div>
      </div>

      <!-- Info -->
      <div class="md:col-span-2">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-text-primary">
          {name}
        </h1>

        <div class="mt-3 flex flex-wrap gap-2">
          <Badge variant={badgeVariant[category] ?? 'neutral'} size="md">
            {getCategoryLabel(category)}
          </Badge>
          {specialty && (
            <Badge variant="neutral" size="md">
              {specialty.toUpperCase()}
            </Badge>
          )}
        </div>

        <dl class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
          <div>
            <dt class="text-xs text-text-secondary uppercase tracking-wide">Edad</dt>
            <dd class="font-semibold text-text-primary">{age} años</dd>
          </div>
          {yearJoined && (
            <div>
              <dt class="text-xs text-text-secondary uppercase tracking-wide">En el club desde</dt>
              <dd class="font-semibold text-text-primary">{yearJoined}</dd>
            </div>
          )}
          {dorsalNumber && (
            <div>
              <dt class="text-xs text-text-secondary uppercase tracking-wide">Dorsal</dt>
              <dd class="font-semibold text-text-primary">#{dorsalNumber}</dd>
            </div>
          )}
        </dl>
      </div>
    </div>

    <!-- Biografia -->
    <div class="prose prose-lg max-w-3xl mt-12 overflow-x-auto">
      <Content />
    </div>

    <!-- Logros -->
    {achievements && achievements.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-display font-bold text-text-primary mb-6">Logros</h2>
        <div class="space-y-3">
          {achievements.map((a: Rider['data']['achievements'][number]) => (
            <div class="flex items-start gap-3 p-4 rounded-lg bg-surface-muted">
              <span aria-hidden="true">🏅</span>
              <div>
                <p class="font-semibold text-text-primary">
                  {a.position ? `${a.position}° puesto - ` : ''}{a.event} ({a.year})
                </p>
                {a.description && (
                  <p class="text-sm text-text-secondary mt-0.5">{a.description}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
