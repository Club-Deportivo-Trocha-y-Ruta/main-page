---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import PageLayout from '@layouts/PageLayout.astro';
import EventCard from '@components/common/EventCard.astro';
import AddToCalendar from '@components/common/AddToCalendar.astro';
import Badge from '@components/common/Badge.astro';
import SectionTitle from '@components/common/SectionTitle.astro';
import ShareButtons from '@components/common/ShareButtons.astro';
import { generateEventsListJsonLd } from '@lib/seo';
import { getCategoryLabel, formatDate } from '@lib/utils';

type Event = CollectionEntry<'events'>;
type News = CollectionEntry<'news'>;

const events = (await getCollection('events')).filter((e: Event) => !e.data.draft);

// Crónicas por evento: se derivan de `relatedEvent` en las noticias, que es el
// campo que los editores llenan de forma consistente.
const news = (await getCollection('news')).filter((n: News) => !n.data.draft);
const chroniclesByEvent = new Map<string, { href: string; title: string }[]>();
for (const article of news) {
  const eventId = article.data.relatedEvent;
  if (!eventId) continue;
  const list = chroniclesByEvent.get(eventId) ?? [];
  list.push({ href: `/noticias/${article.id}`, title: article.data.title });
  chroniclesByEvent.set(eventId, list);
}

const upcoming = events
  .filter((e: Event) => e.data.status === 'upcoming' || e.data.status === 'ongoing')
  .sort((a: Event, b: Event) => a.data.date.getTime() - b.data.date.getTime());

const past = events
  .filter((e: Event) => e.data.status === 'past')
  .sort((a: Event, b: Event) => b.data.date.getTime() - a.data.date.getTime());

// El primero de la lista se destaca como card hero; el resto va en la grilla.
const [nextEvent, ...restUpcoming] = upcoming;

const allSorted = [...upcoming, ...past];
const jsonLd = generateEventsListJsonLd(
  allSorted.map((e: Event) => ({
    title: e.data.title,
    date: e.data.date,
    url: '/calendario',
  }))
);

const nextDayFormatter = new Intl.DateTimeFormat('es-CO', { day: 'numeric', timeZone: 'UTC' });
const nextMonthFormatter = new Intl.DateTimeFormat('es-CO', { month: 'long', timeZone: 'UTC' });
---

<PageLayout
  title="Calendario"
  description="Próximas competencias y eventos del club"
  breadcrumbs={[{ label: 'Calendario' }]}
  jsonLd={jsonLd}
>
  <div class="space-y-16">
    <!-- Compartir -->
    <div class="flex justify-start">
      <ShareButtons title="Calendario de Eventos - Trocha y Ruta" />
    </div>

    <!-- Proximo evento destacado -->
    {nextEvent && (
      <section aria-labelledby="proximo-evento">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-primary-deep">
          Próximo evento
        </p>
        <article class="reveal overflow-hidden rounded-2xl bg-surface-dark text-white shadow-lg">
          <div class="grid gap-6 p-6 md:grid-cols-[auto_1fr] md:gap-10 md:p-10">
            <div class="flex flex-row items-center gap-4 md:flex-col md:items-start md:gap-1">
              <span class="font-display text-6xl leading-none font-bold text-accent md:text-7xl">
                {nextEvent.data.endDate &&
                nextEvent.data.endDate.getUTCMonth() === nextEvent.data.date.getUTCMonth()
                  ? `${nextDayFormatter.format(nextEvent.data.date)}-${nextDayFormatter.format(nextEvent.data.endDate)}`
                  : nextDayFormatter.format(nextEvent.data.date)}
              </span>
              <span class="text-lg uppercase tracking-widest text-white/70">
                {nextMonthFormatter.format(nextEvent.data.date)} {nextEvent.data.date.getUTCFullYear()}
              </span>
            </div>

            <div class="min-w-0">
              <!-- Badges propios: los del componente Badge están calibrados para
                   fondos claros y aquí el fondo es grafito. -->
              <div class="flex flex-wrap gap-2">
                <span class="inline-block rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-surface-dark">
                  {getCategoryLabel(nextEvent.data.category)}
                </span>
                {nextEvent.data.level && (
                  <span class="inline-block rounded-full bg-white/15 px-2.5 py-0.5 text-xs font-medium capitalize text-white">
                    {nextEvent.data.level}
                  </span>
                )}
              </div>

              <h2 id="proximo-evento" class="mt-3 font-display text-2xl md:text-4xl font-bold">
                {nextEvent.data.title}
              </h2>

              <p class="mt-3 flex items-start gap-2 text-white/80">
                <Icon name="ph:map-pin" class="size-5 shrink-0 mt-0.5" aria-hidden="true" />
                <span>
                  {nextEvent.data.location}
                  {nextEvent.data.city && ` · ${nextEvent.data.city}`}
                </span>
              </p>

              {nextEvent.data.registrationDeadline && (
                <p class="mt-2 flex items-center gap-2 text-white/80">
                  <Icon name="ph:hourglass-medium" class="size-5 shrink-0" aria-hidden="true" />
                  <span>Inscripciones hasta el {formatDate(nextEvent.data.registrationDeadline)}</span>
                </p>
              )}

              <div class="mt-6 flex flex-wrap items-center gap-3 [&_a]:border-white/40 [&_a]:bg-white/10 [&_a]:text-white [&_a:hover]:bg-white/20">
                <AddToCalendar
                  title={nextEvent.data.title}
                  date={nextEvent.data.date}
                  endDate={nextEvent.data.endDate}
                  location={nextEvent.data.location}
                />
                {nextEvent.data.mapUrl && (
                  <a
                    href={nextEvent.data.mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  >
                    <Icon name="ph:navigation-arrow" class="size-4" aria-hidden="true" />
                    Cómo llegar
                  </a>
                )}
                {nextEvent.data.registrationUrl && (
                  <a
                    href={nextEvent.data.registrationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center gap-1.5 rounded-md bg-accent px-4 py-2 text-sm font-bold text-surface-dark transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  >
                    Inscríbete
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      </section>
    )}

    <!-- Resto de proximos eventos -->
    <section>
      <SectionTitle title={nextEvent ? 'Más eventos por venir' : 'Próximos Eventos'} align="left" />

      {restUpcoming.length > 0 ? (
        <div class="mt-6 grid gap-2 md:grid-cols-2">
          {restUpcoming.map((e: Event) => (
            <EventCard
              title={e.data.title}
              date={e.data.date}
              endDate={e.data.endDate}
              location={e.data.location}
              category={e.data.category}
              status={e.data.status}
            />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-text-secondary py-4">
          {nextEvent
            ? 'Por ahora este es el único evento confirmado. Publicamos las nuevas fechas apenas la Liga las oficializa.'
            : 'No hay eventos programados por el momento.'}
        </p>
      )}
    </section>

    <!-- Eventos pasados -->
    {past.length > 0 && (
      <section>
        <SectionTitle title="Eventos Pasados" align="left" />
        <div class="mt-6 grid gap-1 md:grid-cols-2">
          {past.map((e: Event) => (
            <EventCard
              title={e.data.title}
              date={e.data.date}
              endDate={e.data.endDate}
              location={e.data.location}
              category={e.data.category}
              status={e.data.status}
              chronicles={chroniclesByEvent.get(e.id) ?? []}
              muted
            />
          ))}
        </div>
      </section>
    )}
  </div>
</PageLayout>
