---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import PageLayout from '@layouts/PageLayout.astro';
import Card from '@components/common/Card.astro';
import Badge from '@components/common/Badge.astro';
import InscriptionCTA from '@components/common/InscriptionCTA.astro';
import { getRefreshImage } from '@lib/refresh-images';

const programs: CollectionEntry<'programs'>[] = (await getCollection('programs'))
  .filter((p: CollectionEntry<'programs'>) => !p.data.draft)
  .sort((a: CollectionEntry<'programs'>, b: CollectionEntry<'programs'>) => a.data.order - b.data.order);

// La foto se resuelve aquí porque el template de Astro no admite cuerpos de bloque en el map.
const programCards = programs.map((program: CollectionEntry<'programs'>, index: number) => ({
  program,
  index,
  photo: getRefreshImage(program.data.image),
}));

const levelLabels: Record<string, string> = {
  'iniciación': 'Iniciación',
  'formación': 'Formación',
  'competición': 'Competición',
  'recreativo': 'Recreativo',
};
---

<PageLayout
  title="Programas"
  description="Formación integral para cada etapa del ciclomontañismo"
  breadcrumbs={[{ label: 'Programas' }]}
>
  <div class="space-y-8 mb-12">
    {programCards.map(({ program, index, photo }) => (
      <Card class="p-0 overflow-hidden">
        <div class="flex flex-col md:flex-row gap-6">
          <div class="relative aspect-video md:aspect-auto md:w-1/3 md:min-h-[16rem] bg-surface-muted rounded-t-xl md:rounded-t-none md:rounded-l-xl overflow-hidden flex items-center justify-center shrink-0">
            {photo ? (
              <Image
                src={photo}
                alt={`Deportistas del programa ${program.data.title} del Club Trocha y Ruta`}
                layout="none"
                widths={[400, 600, 900]}
                sizes="(min-width: 768px) 33vw, 100vw"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            ) : (
              <Icon name="ph:bicycle" class="text-primary size-24" aria-hidden="true" />
            )}
          </div>
          <div class="flex-1 p-6 md:py-6 md:pr-6 md:pl-0">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <Badge variant="cyan">{levelLabels[program.data.targetLevel] || program.data.targetLevel}</Badge>
              {program.data.enrollmentOpen ? (
                <Badge variant="primary">Inscripciones abiertas</Badge>
              ) : (
                <Badge variant="neutral">Proximamente</Badge>
              )}
            </div>
            <h2 class="text-xl md:text-2xl font-display font-bold text-text-primary">
              <a href={`/programas/${program.id}`} class="hover:text-primary-deep transition-colors">
                {program.data.title}
              </a>
            </h2>
            {program.data.subtitle && (
              <p class="mt-1 text-text-secondary">{program.data.subtitle}</p>
            )}
            <!-- Datos de decisión: edad, horario, lugar y mensualidad visibles sin entrar al detalle -->
            <!-- Cada grupo dt/dd va en un <div> hijo directo del <dl>: es la única
                 anidación que el HTML permite dentro de una lista de definición. -->
            <dl class="mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-2 text-sm">
              <div>
                <dt class="flex items-center gap-1.5 text-xs uppercase tracking-wide text-text-secondary">
                  <Icon name="ph:user-bold" class="size-4 shrink-0 text-primary-deep" aria-hidden="true" />
                  Edades
                </dt>
                <dd class="mt-0.5 font-semibold text-text-primary">{program.data.ageRange}</dd>
              </div>
              <div>
                <dt class="flex items-center gap-1.5 text-xs uppercase tracking-wide text-text-secondary">
                  <Icon name="ph:clock-bold" class="size-4 shrink-0 text-primary-deep" aria-hidden="true" />
                  Horario
                </dt>
                <dd class="mt-0.5 font-semibold text-text-primary">{program.data.schedule}</dd>
              </div>
              {program.data.location && (
                <div>
                  <dt class="flex items-center gap-1.5 text-xs uppercase tracking-wide text-text-secondary">
                    <Icon name="ph:map-pin-bold" class="size-4 shrink-0 text-primary-deep" aria-hidden="true" />
                    Lugar
                  </dt>
                  <dd class="mt-0.5 font-semibold text-text-primary">{program.data.location}</dd>
                </div>
              )}
              {program.data.monthlyFee && (
                <div>
                  <dt class="flex items-center gap-1.5 text-xs uppercase tracking-wide text-text-secondary">
                    <Icon name="ph:currency-circle-dollar-bold" class="size-4 shrink-0 text-primary-deep" aria-hidden="true" />
                    Mensualidad
                  </dt>
                  <dd class="mt-0.5 font-semibold text-text-primary">{program.data.monthlyFee}</dd>
                </div>
              )}
            </dl>
            {program.data.objectives.length > 0 && (
              <ul class="mt-4 space-y-1 text-sm text-text-secondary">
                {program.data.objectives.slice(0, 3).map((obj: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-primary-deep mt-0.5 shrink-0">&#10003;</span>
                    <span>{obj}</span>
                  </li>
                ))}
              </ul>
            )}
            <a
              href={`/programas/${program.id}`}
              class="mt-4 inline-flex items-center gap-1 text-primary-deep font-semibold hover:underline"
            >
              Ver detalles &rarr;
            </a>
          </div>
        </div>
      </Card>
    ))}
  </div>

  <InscriptionCTA variant="inline" heading="Encuentra el programa ideal para tu hijo" description="Tenemos nivel para cada edad. Primera clase de prueba gratis, sin compromiso." />
</PageLayout>
