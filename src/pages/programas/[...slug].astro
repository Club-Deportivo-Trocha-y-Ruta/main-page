---
/**
 * Detalle de un programa.
 *
 * Quien llega aquí ya eligió el programa y está a un clic de preinscribir:
 * la página abre con la promesa (no con la ficha técnica), respalda con las
 * cifras propias del programa, sitúa la etapa dentro de la ruta completa del
 * club y cierra con el paso siguiente — incluida la etapa vecina, para quien
 * cayó en el programa equivocado.
 *
 * Sigue el sistema editorial (docs/04-sistema-editorial.md, sección 12).
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import Badge from '@components/common/Badge.astro';
import Button from '@components/common/Button.astro';
import ShareButtons from '@components/common/ShareButtons.astro';
import InscriptionCTA from '@components/common/InscriptionCTA.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import StatFigure from '@components/editorial/StatFigure.astro';
import FactGrid from '@components/editorial/FactGrid.astro';
import ProgramPathway from '@components/sections/ProgramPathway.astro';
import ProgramAdjacentNav from '@components/sections/ProgramAdjacentNav.astro';
import { CTA_TRIAL_LABEL } from '@lib/constants';
import { getRefreshImage } from '@lib/refresh-images';
import { generateCourseJsonLd } from '@lib/seo';
import { ENROLLMENT_POLICY } from '@lib/enrollment';
import {
  buildPathway,
  countWeeklySessions,
  getAdjacentPrograms,
  getLevelStyle,
  toPathwayInput,
} from '@lib/programs';

export async function getStaticPaths() {
  const programs = await getCollection('programs');
  return programs
    .filter((p: CollectionEntry<'programs'>) => !p.data.draft)
    .map((p: CollectionEntry<'programs'>) => ({ params: { slug: p.id }, props: { program: p } }));
}

const { program } = Astro.props as { program: CollectionEntry<'programs'> };
const { Content } = await render(program);

const { title } = program.data;
const photo = getRefreshImage(program.data.image);
const level = getLevelStyle(program.data.targetLevel);
const sessions = countWeeklySessions(program.data);

type Program = CollectionEntry<'programs'>;

// La ruta completa: dónde queda este programa entre los demás. Mismo filtro
// que getStaticPaths, así el programa actual siempre aparece en su propia
// ruta — incluso si algún día deja de estar activo o abierto a inscripción.
const allPrograms = (await getCollection('programs')).filter((p: Program) => !p.data.draft);
const pathwayInput = allPrograms.map(toPathwayInput);
const pathway = buildPathway(pathwayInput);
const step = pathway.stages.find((stage) => stage.id === program.id)?.step ?? 1;
const { previous, next } = getAdjacentPrograms(pathwayInput, program.id);

// Frase que sitúa la etapa dentro de la ruta: solo menciona lo que existe.
const routeLeadParts = [
  `${title} es la etapa ${step} de ${pathway.stages.length} en la ruta de formación del club.`,
];
if (previous) {
  routeLeadParts.push(`Antes de esta etapa está ${previous.title} (${previous.ageRange}).`);
}
if (next) {
  routeLeadParts.push(`Cuando esté listo, el siguiente paso es ${next.title} (${next.ageRange}).`);
}
const routeLead = routeLeadParts.join(' ');

const jsonLd = generateCourseJsonLd({
  title,
  url: `/programas/${program.id}`,
  description: program.data.subtitle || title,
  image: photo?.src,
  ageRange: program.data.ageRange,
  ageMin: program.data.ageMin,
  ageMax: program.data.ageMax,
  targetLevel: program.data.targetLevel,
  schedule: program.data.schedule,
  monthlyFee: program.data.monthlyFee,
  enrollmentOpen: program.data.enrollmentOpen,
});
---

<BaseLayout
  title={program.data.seo?.metaTitle ?? `${title} | Programas`}
  description={program.data.seo?.metaDescription ?? program.data.summary ?? program.data.subtitle}
  jsonLd={jsonLd}
>
  <!-- La promesa, no la ficha técnica -->
  <SectionShell tone="tinted" pattern="topo" width="wide" spacing="compact" labelledby="programa-titulo">
    <Breadcrumb items={[{ label: 'Programas', href: '/programas' }, { label: program.data.title }]} />

    <div class="mt-6 grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
      <div>
        <SectionIntro
          as="h1"
          id="programa-titulo"
          eyebrow={`Etapa ${step} · ${level.label}`}
          eyebrowIcon={level.icon}
          title={program.data.title}
          lead={program.data.summary ?? program.data.subtitle}
        />

        <div class="mt-6 flex flex-wrap items-center gap-3">
          {program.data.enrollmentOpen ? (
            <Badge variant="accent">Inscripciones abiertas</Badge>
          ) : (
            <Badge variant="neutral">Próximamente</Badge>
          )}
          <Button variant="accent" href="/inscripciones" data-analytics-event="cta_inscripcion_click">
            {CTA_TRIAL_LABEL}
          </Button>
        </div>
      </div>

      <div class="relative">
        <div
          class="absolute -inset-3 rounded-3xl"
          style={`background:color-mix(in srgb, ${level.color} 16%, transparent)`}
          aria-hidden="true"
        ></div>

        {photo ? (
          <Image
            src={photo}
            alt={`Deportistas del programa ${program.data.title} del Club Trocha y Ruta`}
            layout="none"
            widths={[500, 800, 1100]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="relative aspect-[4/3] w-full rounded-2xl object-cover shadow-md"
          />
        ) : (
          <div class="relative flex aspect-[4/3] w-full items-center justify-center rounded-2xl bg-surface-muted">
            <Icon name={program.data.icon} class="size-20 text-primary/50" aria-hidden="true" />
          </div>
        )}

        <span
          class:list={[
            'absolute -top-4 -left-1 flex size-14 items-center justify-center rounded-2xl shadow-lg sm:-left-3 sm:-top-5',
            'font-display text-xl font-extrabold',
            level.solid,
            level.ink,
          ]}
          aria-hidden="true"
        >
          {String(step).padStart(2, '0')}
        </span>
      </div>
    </div>

    <!-- Cifras del propio programa: solo lo que el contenido respalda -->
    <div class="mt-12 grid grid-cols-2 gap-6 border-t border-primary/15 pt-8 sm:grid-cols-4">
      <StatFigure value={program.data.ageRange} size="sm" label="Edades" icon="ph:user-bold" />
      {sessions !== null && (
        <StatFigure
          value={sessions}
          label={sessions === 1 ? 'sesión por semana' : 'sesiones por semana'}
          icon="ph:calendar-dots-bold"
        />
      )}
      {program.data.duration && (
        <StatFigure
          value={program.data.duration}
          size="sm"
          label="Duración de cada sesión"
          icon="ph:hourglass-medium-bold"
        />
      )}
      {program.data.maxStudents && (
        <StatFigure value={program.data.maxStudents} label="Cupos por grupo" icon="ph:users-three-bold" />
      )}
    </div>
  </SectionShell>

  <!-- La ruta completa: de dónde viene y hacia dónde sigue -->
  <SectionShell tone="muted" width="wide" labelledby="ruta-titulo" scrollDriven>
    <SectionIntro
      id="ruta-titulo"
      eyebrow="La ruta completa"
      eyebrowIcon="ph:path-bold"
      title="No es un programa suelto: es un tramo del camino"
      highlight="un tramo del camino"
      lead={routeLead}
      class="max-w-2xl"
    />

    <div class="mt-10 rounded-2xl border border-primary/15 bg-surface/70 p-5 backdrop-blur-sm sm:p-7">
      <ProgramPathway programs={pathwayInput} activeId={program.id} legend />
    </div>
  </SectionShell>

  <!-- La ficha completa: horario, seguro, metodología, objetivos y lo que hay que llevar -->
  <SectionShell tone="plain" width="default" labelledby="detalle-titulo">
    <SectionIntro
      id="detalle-titulo"
      eyebrow="El programa"
      eyebrowIcon="ph:clipboard-text-bold"
      title="Todo lo que necesitas saber antes de inscribir"
      highlight="antes de inscribir"
      lead="Horario, cupo, metodología y equipo: la ficha completa, tal como la usan nuestros entrenadores."
      class="max-w-2xl"
    />

    <FactGrid
      class="mt-10"
      columns={3}
      items={[
        { icon: 'ph:clock-bold', label: 'Horario', value: program.data.schedule },
        program.data.location
          ? { icon: 'ph:map-pin-bold', label: 'Dónde entrena', value: program.data.location }
          : null,
        program.data.monthlyFee
          ? { icon: 'ph:currency-circle-dollar-bold', label: 'Mensualidad', value: program.data.monthlyFee }
          : null,
      ]}
    />

    <!-- Seguro: una sola fuente (ENROLLMENT_POLICY), no un precio copiado a mano -->
    <div class="mt-6 flex items-start gap-3 rounded-xl border border-primary/15 bg-primary/5 p-4">
      <Icon name="ph:shield-check-bold" class="mt-0.5 size-5 shrink-0 text-primary-deep" aria-hidden="true" />
      <p class="text-sm text-text-primary">
        <span class="font-semibold">
          Seguro deportivo incluido: {ENROLLMENT_POLICY.annualFee}/año con {ENROLLMENT_POLICY.insurer}.
        </span>{' '}
        <span class="text-text-secondary">
          Cubre gastos médicos, rehabilitación y traslado en ambulancia durante entrenamientos y competencias.
        </span>{' '}
        <a
          href="/inscripciones#seguro-titulo"
          class="font-semibold text-primary-deep underline-offset-2 hover:underline"
        >
          Ver toda la cobertura
        </a>
      </p>
    </div>

    {program.data.methodology && (
      <div class="mt-8 rounded-r-xl border-l-4 bg-black/[0.03] p-5" style={`border-color:${level.color}`}>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-text-secondary">Cómo se entrena</p>
        <p class="mt-1.5 text-sm leading-relaxed text-text-primary">{program.data.methodology}</p>
      </div>
    )}

    {program.data.objectives.length > 0 && (
      <div class="mt-8">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-text-secondary">
          Qué se lleva de esta etapa
        </p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {program.data.objectives.map((objective: string) => (
            <li class="flex items-start gap-2 text-sm leading-snug text-text-secondary">
              <Icon
                name="ph:check-circle-fill"
                class:list={['mt-0.5 size-4 shrink-0', level.text]}
                aria-hidden="true"
              />
              <span>{objective}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {(program.data.requirements.length > 0 || program.data.equipmentNeeded.length > 0) && (
      <div class="mt-8 grid gap-8 border-t border-black/10 pt-8 sm:grid-cols-2">
        {program.data.requirements.length > 0 && (
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-wider text-text-secondary">
              Requisitos para inscribirse
            </p>
            <ul class="mt-3 space-y-2">
              {program.data.requirements.map((requirement: string) => (
                <li class="flex items-start gap-2 text-sm leading-snug text-text-secondary">
                  <Icon
                    name="ph:check-circle-fill"
                    class:list={['mt-0.5 size-4 shrink-0', level.text]}
                    aria-hidden="true"
                  />
                  <span>{requirement}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {program.data.equipmentNeeded.length > 0 && (
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-wider text-text-secondary">
              Equipamiento que debe llevar
            </p>
            <ul class="mt-3 space-y-2">
              {program.data.equipmentNeeded.map((item: string) => (
                <li class="flex items-start gap-2 text-sm leading-snug text-text-secondary">
                  <Icon
                    name="ph:check-circle-fill"
                    class:list={['mt-0.5 size-4 shrink-0', level.text]}
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    <!-- Cuerpo markdown: la historia completa del programa -->
    <div class="prose prose-lg mt-10 max-w-3xl border-t border-black/10 pt-8">
      <Content />
    </div>

    <div class="mt-8 border-t border-black/10 pt-6">
      <ShareButtons title={program.data.title} description={program.data.summary ?? program.data.subtitle} />
    </div>
  </SectionShell>

  <!-- Paso siguiente: preinscribir, o seguir a la etapa vecina -->
  <SectionShell tone="muted" width="default" spacing="compact" label="Preinscripción">
    <InscriptionCTA
      variant="inline"
      heading={`¿Listo para inscribir a tu hijo o hija en ${program.data.title}?`}
      description="Completa la preinscripción y el director deportivo te contacta para agendar la clase de prueba gratuita."
    />

    <ProgramAdjacentNav previous={previous} next={next} class="mt-8 border-t border-black/10 pt-8" />
  </SectionShell>
</BaseLayout>
