---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import Badge from '@components/common/Badge.astro';
import NewsGallery from '@components/sections/NewsGallery.astro';
import RaceLineup from '@components/sections/RaceLineup.astro';
import { formatDate } from '@lib/utils';
import { generateArticleJsonLd } from '@lib/seo';

type NewsEntry = CollectionEntry<'news'>;

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news
    .filter((n: NewsEntry) => !n.data.draft)
    .map((n: NewsEntry) => ({ params: { slug: n.id }, props: { entry: n } }));
}

const { entry } = Astro.props as { entry: NewsEntry };
const { Content } = await render(entry);

const { title, date, updatedDate, author, category, excerpt, image, imageLayout, tags, galleryFolder, galleryImages, lineup, seo } = entry.data;
const hasDedicatedOg = Boolean(seo?.ogImage);
const ogImage = (seo?.ogImage || image) as string;
const ogImageWidth = hasDedicatedOg ? 1200 : undefined;
const ogImageHeight = hasDedicatedOg ? 630 : undefined;

const badgeVariant: Record<string, 'primary' | 'accent' | 'neutral'> = {
  competencias: 'primary',
  club: 'primary',
  entrenamiento: 'accent',
  comunidad: 'neutral',
};

const jsonLd = generateArticleJsonLd({
  title,
  date,
  updatedDate,
  author,
  excerpt,
  url: `/noticias/${entry.id}`,
  image,
  category,
  tags,
});
---

<BaseLayout
  title={`${title} | Noticias`}
  description={excerpt}
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  jsonLd={jsonLd}
  ogType="article"
  articlePublishedTime={date.toISOString()}
  articleModifiedTime={(updatedDate ?? date).toISOString()}
  articleAuthor={author}
  articleSection={category}
  articleTags={tags}
>
  <article class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <Breadcrumb items={[{ label: 'Noticias', href: '/noticias' }, { label: title }]} />

    {image && imageLayout === 'contain' ? (
      <div class="mb-8 overflow-hidden rounded-xl flex justify-center">
        <img src={image} alt={entry.data.imageAlt ?? title} class="max-h-[32rem] md:max-h-[40rem] w-auto object-contain" loading="eager" decoding="async" fetchpriority="high" />
      </div>
    ) : image ? (
      <div class="mb-8 overflow-hidden rounded-xl">
        <img src={image} alt={entry.data.imageAlt ?? title} class="w-full h-64 md:h-96 object-cover" loading="eager" decoding="async" fetchpriority="high" />
      </div>
    ) : null}

    <header class="mb-8 max-w-3xl mx-auto">
      <Badge variant={badgeVariant[category] ?? 'neutral'}>{category}</Badge>
      <h1 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-bold leading-tight">
        {title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-secondary">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>&middot;</span>
        <span>{author}</span>
      </div>
    </header>

    {lineup && lineup.length > 0 && (
      <div class="mx-auto max-w-3xl mb-12">
        <RaceLineup athletes={lineup} />
      </div>
    )}

    <div class="prose prose-lg mx-auto max-w-3xl">
      <Content />
    </div>

    {galleryFolder && galleryImages.length > 0 && (
      <div class="mx-auto max-w-3xl mt-8">
        <NewsGallery
          imageFolder={galleryFolder}
          imageFiles={galleryImages}
          altFallback={title}
          albumSlug={entry.data.relatedGallery}
        />
      </div>
    )}
  </article>

  <script is:inline>
    (function () {
      function initScrollDepth() {
        const article = document.querySelector('article');
        if (!article) return;
        const fired = new Set();
        const depths = [25, 50, 75, 100];

        function check() {
          const rect = article.getBoundingClientRect();
          const total = rect.height;
          if (total <= 0) return;
          const scrolled = Math.min(Math.max(-rect.top + window.innerHeight, 0), total);
          const pct = Math.round((scrolled / total) * 100);
          for (const d of depths) {
            if (pct >= d && !fired.has(d)) {
              fired.add(d);
              if (typeof window.__trochaEmit === 'function') {
                window.__trochaEmit('scroll_depth', { depth: d });
              }
            }
          }
          if (fired.size === depths.length) {
            window.removeEventListener('scroll', onScroll);
          }
        }

        let ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            check();
            ticking = false;
          });
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        check();
      }
      initScrollDepth();
      document.addEventListener('astro:page-load', initScrollDepth);
    })();
  </script>
</BaseLayout>
