---
/**
 * Detalle de una crónica.
 *
 * Una crónica del club no es una entrada de blog suelta: es un capítulo de la
 * temporada. Por eso la página deja de ser "imagen + título + texto" y sitúa lo
 * que se lee — de qué carrera habla, qué fotos hay de ese día, si existe otra
 * crónica de la misma fecha, y qué se publicó antes y después.
 *
 * Todo eso ya estaba en el frontmatter sin usarse: nueve de las diez crónicas
 * declaran `relatedEvent` y nueve `relatedGallery`. Los eslabones se resuelven
 * contra las colecciones reales en `@lib/chronicle`; si alguno no existe, no se
 * pinta el bloque en vez de enlazar a una página inexistente.
 *
 * Sigue el sistema editorial (docs/04-sistema-editorial.md).
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import ShareButtons from '@components/common/ShareButtons.astro';
import WhatsappShareButton from '@components/common/WhatsappShareButton.astro';
import ScrollDepth from '@components/common/ScrollDepth.astro';
import InscriptionCTA from '@components/common/InscriptionCTA.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import ClubSeal from '@components/editorial/ClubSeal.astro';
import NewsGallery from '@components/sections/NewsGallery.astro';
import RaceLineup from '@components/sections/RaceLineup.astro';
import ChronicleContext from '@components/sections/ChronicleContext.astro';
import ChronicleAdjacentNav from '@components/sections/ChronicleAdjacentNav.astro';
import { formatDate } from '@lib/utils';
import { getCategoryStyle, readingTime } from '@lib/news';
import { resolveChronicleContext, placeChronicle } from '@lib/chronicle';
import { generateArticleJsonLd, toColombiaIso } from '@lib/seo';

type NewsEntry = CollectionEntry<'news'>;
type EventEntry = CollectionEntry<'events'>;
type GalleryEntry = CollectionEntry<'gallery'>;

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news
    .filter((n: NewsEntry) => !n.data.draft)
    .map((n: NewsEntry) => ({ params: { slug: n.id }, props: { entry: n } }));
}

const { entry } = Astro.props as { entry: NewsEntry };
const { Content } = await render(entry);

const {
  title,
  date,
  updatedDate,
  author,
  category,
  excerpt,
  image,
  imageLayout,
  tags,
  galleryFolder,
  galleryImages,
  lineup,
  seo,
} = entry.data;

const hasDedicatedOg = Boolean(seo?.ogImage);
const ogImage = (seo?.ogImage || image) as string;
const ogImageWidth = hasDedicatedOg ? 1200 : undefined;
const ogImageHeight = hasDedicatedOg ? 630 : undefined;

// La etiqueta legible de la categoría vive en `@lib/news`. Antes se pintaba el
// valor crudo del enum ("competencias", en minúscula y plural).
const categoryStyle = getCategoryStyle(category);
const minutes = readingTime(entry.body);

const allNews = (await getCollection('news')).filter((n: NewsEntry) => !n.data.draft);
const events = (await getCollection('events')).filter((e: EventEntry) => !e.data.draft);
const albums = (await getCollection('gallery')).filter((a: GalleryEntry) => !a.data.draft);

const context = resolveChronicleContext(entry, events, albums, allNews);
const placement = placeChronicle(allNews, entry.id);

const jsonLd = generateArticleJsonLd({
  title,
  date,
  updatedDate,
  author,
  excerpt,
  url: `/noticias/${entry.id}`,
  image,
  category,
  tags,
});
---

<BaseLayout
  title={seo?.metaTitle ?? `${title} | Noticias`}
  description={seo?.metaDescription ?? excerpt}
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  jsonLd={jsonLd}
  ogType="article"
  articlePublishedTime={toColombiaIso(date)}
  articleModifiedTime={toColombiaIso(updatedDate ?? date)}
  articleAuthor={author}
  articleSection={category}
  articleTags={tags}
>
  <article>
    <!--
      Barra de progreso de lectura (docs/08-plan-creatividad-ui.md tarea 14):
      decorativa y `aria-hidden`, CSS puro en `.reading-progress`
      (global.css). `sticky`, no `fixed` — motivo documentado ahí mismo.
    -->
    <div class="reading-progress" aria-hidden="true"></div>

    <!-- Cabecera: quién, cuándo y de qué va -->
    <SectionShell tone="plain" width="wide" spacing="compact" labelledby="cronica-titulo">
      <Breadcrumb items={[{ label: 'Noticias', href: '/noticias' }, { label: title }]} />

      <header class="mx-auto mt-6 max-w-3xl">
        <p
          class:list={[
            'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider',
            categoryStyle.soft,
            categoryStyle.text,
          ]}
        >
          <Icon name={categoryStyle.icon} class="size-3.5 shrink-0" aria-hidden="true" />
          {categoryStyle.label}
        </p>

        <h1
          id="cronica-titulo"
          class="mt-4 text-balance font-display text-3xl font-bold leading-tight text-text-primary md:text-4xl lg:text-5xl"
        >
          {title}
        </h1>

        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-text-secondary">{excerpt}</p>

        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-secondary">
          <time datetime={toColombiaIso(date)}>{formatDate(date)}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{author}</span>
          {minutes !== null && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span class="inline-flex items-center gap-1">
                <Icon name="ph:clock-bold" class="size-3.5 shrink-0" aria-hidden="true" />
                {minutes} min de lectura
              </span>
            </>
          )}
          {updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>Actualizada el {formatDate(updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      {image && (
        <div
          class:list={[
            'mt-8 overflow-hidden rounded-2xl',
            imageLayout === 'contain' && 'flex justify-center',
          ]}
        >
          {/*
            Contraparte del morph de `NewsCard`: mismo `news-img-{id}` que lleva
            el recuadro de la portada en el listado, así que la tarjeta que se
            acaba de tocar aterriza aquí en vez de fundirse con la página. Va en
            el `<img>` y no en su contenedor porque con `imageLayout: contain`
            —nueve de las diez crónicas son afiches— el contenedor es una franja
            del ancho de la columna con el afiche centrado: terminar el morph
            ahí dejaría el afiche creciendo dentro de una caja casi vacía. En el
            `<img>` la animación aterriza exactamente sobre el afiche.

            Aquí sí se usa la directiva `transition:name`, mientras que en la
            tarjeta el nombre va como propiedad CSS en línea. Dos razones: hay
            una sola imagen destacada por crónica, así que los ~2,4 KB de
            `<style>` que la directiva emite por elemento nombrado no escalan; y
            son justamente estas reglas las que animan el par, porque
            `ClientRouter` reemplaza el `<head>` dentro del callback de
            `startViewTransition` y las del listado se van con él. Quitarla
            también aquí cambiaría el fundido de Astro (180 ms,
            `mix-blend-mode: plus-lighter`) por el del navegador.
          */}
          <img
            src={image}
            alt={entry.data.imageAlt ?? title}
            width="1200"
            height="675"
            transition:name={`news-img-${entry.id}`}
            class:list={[
              imageLayout === 'contain'
                ? 'max-h-[32rem] w-auto object-contain md:max-h-[40rem]'
                : 'h-64 w-full object-cover md:h-96',
            ]}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      )}
    </SectionShell>

    <!-- El cuerpo, con la ficha de la carrera al lado -->
    <SectionShell tone="plain" width="wide" spacing="compact" label="Cuerpo de la crónica">
      <div class="mx-auto max-w-3xl">
        <ChronicleContext context={context} class="mb-10" />

        {lineup && lineup.length > 0 && (
          <div class="mb-12">
            <RaceLineup athletes={lineup} eventName={context.race?.title} />
          </div>
        )}

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>
        {
          /*
            Respaldo sin JS para el `.stat-strip`/`.stat-callout` que la crónica
            pueda traer con `reveal` (docs/08-plan-creatividad-ui.md, Sprint 3
            tarea 15) y para el `.count-up` opcional que anide adentro (tarea 6).
            El markdown no puede emitir su propio `<noscript>` por bloque como sí
            hace `StatFigure.astro`, así que la red de seguridad vive una sola
            vez aquí, igual de genérica que la de `StatsCounter.astro`: sin JS,
            `.revealed` nunca llega (lo añade el IntersectionObserver de
            `BaseLayout.astro`) y tanto el bloque como el conteo se quedarían en
            `opacity: 0` / `--count-value: 0` para siempre. `set:html` sobre un
            string, no `<style is:inline>` literal — mismo motivo que
            `StatFigure.astro`: un `<style>` real anidado rompe el parser
            embebido de prettier-plugin-astro. Inocuo en crónicas sin estos
            bloques: los selectores simplemente no matchean nada.
          */
        }
        <noscript set:html="<style>.stat-strip.reveal,.stat-callout.reveal,.stat-strip.reveal .stat-strip__item{opacity:1 !important;transform:none !important}.count-up__digits{--count-value:var(--count-target) !important}</style>" />

        {galleryFolder && galleryImages.length > 0 && (
          <div class="mt-10">
            <NewsGallery
              imageFolder={galleryFolder}
              imageFiles={galleryImages}
              altFallback={title}
              albumSlug={context.album?.id}
            />
          </div>
        )}

        {/*
          Salida hacia la inscripción. Las crónicas son el 59% de las páginas vistas y
          lo único que atrae tráfico nuevo —la de Ginebra retuvo 65 minutos de lectura—,
          pero hasta agosto de 2026 terminaban en "ver todas las crónicas" y no ofrecían
          ningún paso siguiente medible. Va antes de compartir: primero la acción, luego
          la difusión.
        */}
        <div class="mt-12">
          <InscriptionCTA
            heading="¿A tu hijo le brillaron los ojos leyendo esto?"
            description="En el club se empieza desde los 4 años, sin experiencia previa. La primera clase de prueba es gratis."
          />
        </div>

        <div class="mt-10 border-t border-black/10 pt-6">
          <ShareButtons title={title} description={excerpt} />
        </div>

        <div class="mt-6">
          <WhatsappShareButton title={title} />
        </div>

        {/*
          Firma de cierre: el escudo estampado donde termina la crónica, como
          el sello al pie de una carta. Decorativo (`aria-hidden`), va después
          de compartir para que sea lo último que queda de la columna de texto.
        */}
        <div class="mt-12 flex justify-center">
          <ClubSeal size="md" tone="plain" />
        </div>
      </div>
    </SectionShell>

    <!-- Dónde va esta crónica dentro de la temporada -->
    {(placement.previous || placement.next) && (
      <SectionShell tone="muted" width="default" spacing="compact" label="Seguir leyendo">
        <ChronicleAdjacentNav placement={placement} />

        <p class="mt-8 text-center">
          <a
            href="/noticias"
            class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-deep px-5 py-2.5 text-sm font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            Ver todas las crónicas
            <Icon name="ph:arrow-right-bold" class="size-4 shrink-0" aria-hidden="true" />
          </a>
        </p>
      </SectionShell>
    )}
  </article>

  <ScrollDepth target="article" />
</BaseLayout>
