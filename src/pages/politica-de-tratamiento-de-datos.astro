---
import PageLayout from '@layouts/PageLayout.astro';

const pdfUrl = '/documentos/politica-de-tratamiento-de-datos.pdf';

const primaryActionClass = 'inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-bold text-surface-dark transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface-dark';
const secondaryActionClass = 'inline-flex min-h-[44px] items-center gap-2 rounded-lg border-2 border-surface-dark px-5 py-2.5 text-sm font-bold text-surface-dark transition-colors hover:bg-surface-dark hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface-dark';
---

<PageLayout
  title="Política de Tratamiento de Datos"
  description="Consulta y descarga la Política de Tratamiento de Datos Personales del Club Deportivo Trocha y Ruta."
  breadcrumbs={[{ label: 'Política de Tratamiento de Datos' }]}
>
  <div class="mx-auto max-w-6xl space-y-6">

    <div class="flex flex-wrap justify-end gap-3">
      <a
        href={pdfUrl}
        target="_blank"
        rel="noopener"
        class={secondaryActionClass}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
        Abrir en pestaña nueva
      </a>
      <a
        href={pdfUrl}
        download
        rel="noopener"
        type="application/pdf"
        class={primaryActionClass}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        Descargar PDF
      </a>
    </div>

    <div class="overflow-hidden rounded-xl border border-surface-muted bg-surface-muted shadow-sm">
      <iframe
        src={`${pdfUrl}#view=FitH`}
        title="Política de Tratamiento de Datos — vista previa del documento PDF"
        class="block w-full border-0"
        style="height: clamp(700px, calc(100vh - 12rem), 1400px);"
        loading="lazy"
      ></iframe>
    </div>

  </div>
</PageLayout>
