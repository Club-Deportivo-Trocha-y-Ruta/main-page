---
import PageLayout from '@layouts/PageLayout.astro';
import Card from '@components/common/Card.astro';
import Badge from '@components/common/Badge.astro';
import Button from '@components/common/Button.astro';
import YouTubeEmbed from '@components/common/YouTubeEmbed.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type Testimonial = CollectionEntry<'testimonials'>;

const testimonials = (await getCollection('testimonials'))
  .filter((t: Testimonial) => !t.data.draft)
  .sort((a: Testimonial, b: Testimonial) => a.data.order - b.data.order);

// Etiqueta del programa asociado: se resuelve contra la colección para no
// repetir títulos a mano en cada testimonio.
const programs = await getCollection('programs');
const programTitles = new Map<string, string>(
  programs.map((p: CollectionEntry<'programs'>) => [p.id, p.data.title])
);

/** Iniciales para el avatar cuando no hay foto autorizada de la familia. */
function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('');
}

const cards = testimonials.map((t: Testimonial) => ({
  entry: t,
  initials: initials(t.data.name),
  programLabel: t.data.relatedProgram ? programTitles.get(t.data.relatedProgram) : undefined,
}));
---

<PageLayout
  title="Testimonios"
  description="Lo que dicen las familias y corredores del club"
  breadcrumbs={[{ label: 'Testimonios' }]}
>
  <!-- Video institucional -->
  <div class="mx-auto max-w-3xl mb-12 reveal">
    <YouTubeEmbed
      videoId="rz0QLMHpMVM"
      title="Pedaleando por un Sueño — Club Deportivo Trocha y Ruta"
    />
    <p class="mt-4 text-center text-text-secondary font-sans">
      Conoce nuestra historia y el impacto del club en la comunidad de Yumbo.
    </p>
  </div>

  <h2 class="sr-only">Testimonios de familias y corredores</h2>
  <div class="grid gap-6 md:grid-cols-2">
    {cards.map(({ entry, initials: avatarText, programLabel }) => (
      <Card class="reveal flex h-full flex-col p-5 sm:p-8">
        <blockquote class="flex-1">
          <p class="font-display italic text-lg text-text-primary leading-relaxed">
            &ldquo;{entry.data.quote}&rdquo;
          </p>
        </blockquote>
        <div class="mt-6 flex items-center gap-4 border-t border-gray-100 pt-5">
          <span
            class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-primary font-display text-lg font-bold text-white"
            aria-hidden="true"
          >
            {avatarText}
          </span>
          <div class="min-w-0">
            <p class="font-semibold text-text-primary">{entry.data.name}</p>
            <p class="text-sm text-text-secondary">{entry.data.roleLabel}</p>
            {programLabel && (
              <Badge variant="cyan" class="mt-2">{programLabel}</Badge>
            )}
          </div>
        </div>
      </Card>
    ))}
  </div>

  <!-- CTA -->
  <div class="mt-16 text-center">
    <p class="text-xl text-text-secondary mb-6">¿Tienes una historia que contar?</p>
    <Button variant="outline" href="/contacto">
      Cuéntanos tu experiencia
    </Button>
  </div>
</PageLayout>
