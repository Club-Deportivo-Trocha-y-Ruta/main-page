---
/**
 * Portada.
 *
 * El recorrido de una familia que llega por primera vez: qué es esto y en qué
 * punto va el año (hero) → por qué creerle (cifras comprobables) → qué ofrece
 * (programas) → quién está detrás y, ahí mismo, el paso siguiente (el club con
 * la clase de prueba) → qué está pasando (la temporada: lo que sigue y lo que
 * ya se contó) → qué más hace el club (Trocha Verde) → en quién confía
 * (patrocinadores) → el cierre.
 *
 * La conversión dejó de ser una parada suelta entre dos secciones: vive dentro
 * de `AboutPreview`, justo donde el lector ya se creyó la historia. Y el
 * calendario y las crónicas, que contaban el mismo año dos veces seguidas,
 * ahora son una sola sección a dos columnas (`SeasonOverview`).
 *
 * El ritmo lo dan los tonos del sistema editorial, alternando `plain` y
 * `muted` para que dos secciones seguidas nunca compartan fondo. El hero ya no
 * es un cartel oscuro: es claro, sobre el gradiente `tinted`, y por eso entrega
 * limpio al blanco de las cifras sin necesidad de ola de corte. Hay dos
 * excepciones deliberadas a la alternancia: Trocha Verde va en `tinted` porque
 * cambia de registro a propósito, y el cierre va sobre el teal de marca porque
 * es el final, no una sección más. Si mueves una sección de sitio, revisa que
 * la alternancia siga cuadrando.
 *
 * Ver docs/04-sistema-editorial.md.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ScrollDepth from '@components/common/ScrollDepth.astro';
import { SITE } from '@lib/constants';
import {
  generateOrganizationJsonLd,
  generateWebSiteJsonLd,
  generateNewsMediaOrganizationJsonLd,
} from '@lib/seo';

import Hero from '@components/sections/Hero.astro';
import StatsCounter from '@components/sections/StatsCounter.astro';
import ProgramsGrid from '@components/sections/ProgramsGrid.astro';
import AboutPreview from '@components/sections/AboutPreview.astro';
import SeasonOverview from '@components/sections/SeasonOverview.astro';
import TrochaVerde from '@components/sections/TrochaVerde.astro';
import SponsorsBar from '@components/sections/SponsorsBar.astro';
import InscriptionCTA from '@components/common/InscriptionCTA.astro';

const jsonLd = [
  generateOrganizationJsonLd(),
  generateWebSiteJsonLd(),
  // El editor de las noticias, declarado una vez a nivel de sitio. Las
  // crónicas lo repiten inline para ser autocontenidas.
  { '@context': 'https://schema.org', ...generateNewsMediaOrganizationJsonLd() },
];
---

<BaseLayout title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <!-- 1. El gancho, con el pulso de la temporada (tinted, claro) -->
  <Hero />

  <!-- 2. Por qué creerle: cifras que el lector puede comprobar (plain) -->
  <div class="reveal">
    <StatsCounter />
  </div>

  <!-- 3. Qué ofrece (muted) -->
  <div class="reveal">
    <ProgramsGrid />
  </div>

  <!-- 4. Quién está detrás y el paso siguiente: la clase de prueba va dentro
       de esta sección, no como parada aparte (plain) -->
  <div class="reveal">
    <AboutPreview />
  </div>

  <!-- 5. Qué está pasando: el calendario y las crónicas como una sola historia
       (muted) -->
  <div class="reveal">
    <SeasonOverview />
  </div>

  <!-- 6. El otro lado del club: la iniciativa ambiental. Cambia de registro a
       propósito, con su propio verde. -->
  <div class="reveal">
    <TrochaVerde />
  </div>

  <!-- 7. Quién respalda al club (plain). Aquí iba también un sello de "club
       seguro" que se apoyaba en una política de protección infantil publicada
       en el sitio; el club confirmó que esa política no existe en la práctica,
       así que la sección se retiró junto con la página. -->
  <div class="reveal">
    <SponsorsBar />
  </div>

  <!-- 8. El cierre, sobre el teal de marca -->
  <div class="reveal">
    <InscriptionCTA
      variant="banner"
      heading="Tu hijo puede empezar este mes"
      description="Escríbenos y te decimos a qué grupo entra según su edad. La primera clase es de prueba."
    />
  </div>
  <ScrollDepth target="main" />
</BaseLayout>
