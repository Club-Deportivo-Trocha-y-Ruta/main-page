---
/**
 * Portada.
 *
 * El recorrido de una familia que llega por primera vez: qué es esto (hero) →
 * por qué creerle (cifras comprobables) → qué ofrece (programas) → quién está
 * detrás (el club) → el paso siguiente → qué está pasando (calendario y
 * noticias) → qué más hace el club (Trocha Verde) → en quién confía y quién
 * confía en él (patrocinadores, club seguro) → el cierre.
 *
 * El ritmo lo dan los tonos del sistema editorial, alternando `plain` y
 * `muted` para que dos secciones seguidas nunca compartan fondo. Si mueves una
 * sección de sitio, revisa que la alternancia siga cuadrando.
 *
 * Ver docs/04-sistema-editorial.md.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@lib/constants';
import { generateOrganizationJsonLd, generateWebSiteJsonLd } from '@lib/seo';

import Hero from '@components/sections/Hero.astro';
import StatsCounter from '@components/sections/StatsCounter.astro';
import ProgramsGrid from '@components/sections/ProgramsGrid.astro';
import AboutPreview from '@components/sections/AboutPreview.astro';
import UpcomingEvents from '@components/sections/UpcomingEvents.astro';
import NewsPreview from '@components/sections/NewsPreview.astro';
import TrochaVerde from '@components/sections/TrochaVerde.astro';
import SponsorsBar from '@components/sections/SponsorsBar.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import InscriptionCTA from '@components/common/InscriptionCTA.astro';
import WaveSeparator from '@components/common/WaveSeparator.astro';

const jsonLd = [generateOrganizationJsonLd(), generateWebSiteJsonLd()];
---

<BaseLayout title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <!-- 1. El gancho, con el pulso de la temporada -->
  <Hero />

  <!-- El corte del hero cae sobre blanco: es el fondo de la banda de cifras. -->
  <WaveSeparator from="fill-surface-dark" to="fill-surface" />

  <!-- 2. Por qué creerle: cifras que el lector puede comprobar (plain) -->
  <div class="reveal">
    <StatsCounter />
  </div>

  <!-- 3. Qué ofrece (muted) -->
  <div class="reveal">
    <ProgramsGrid />
  </div>

  <!-- 4. Quién está detrás (plain) -->
  <div class="reveal">
    <AboutPreview />
  </div>

  <!-- 5. Momento de conversión (muted) -->
  <SectionShell tone="muted" width="default" spacing="compact" label="Clase de prueba">
    <div class="reveal">
      <InscriptionCTA
        variant="inline"
        heading="La primera clase es de prueba y no cuesta nada"
        description="Tu hijo entrena una sesión completa con su grupo antes de que decidas. Entrenadores certificados y pista propia."
      />
    </div>
  </SectionShell>

  <!-- 6. Qué está pasando (plain) -->
  <div class="reveal">
    <UpcomingEvents />
  </div>

  <!-- 7. Lo que se contó de cada carrera (muted) -->
  <div class="reveal">
    <NewsPreview />
  </div>

  <!-- 8. El otro lado del club: la iniciativa ambiental. Cambia de registro a
       propósito, con su propio verde. -->
  <div class="reveal">
    <TrochaVerde />
  </div>

  <!-- 9. Quién respalda al club (plain). Aquí iba también un sello de "club
       seguro" que se apoyaba en una política de protección infantil publicada
       en el sitio; el club confirmó que esa política no existe en la práctica,
       así que la sección se retiró junto con la página. -->
  <div class="reveal">
    <SponsorsBar />
  </div>

  <!-- 10. El cierre -->
  <div class="reveal">
    <InscriptionCTA
      variant="banner"
      heading="Tu hijo puede empezar este mes"
      description="Escríbenos y te decimos a qué grupo entra según su edad. La primera clase es de prueba."
    />
  </div>
</BaseLayout>
