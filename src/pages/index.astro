---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import {
  generateOrganizationJsonLd,
  generateWebSiteJsonLd,
  generateFAQPageJsonLd,
} from '@lib/seo';

import Hero from '@components/sections/Hero.astro';
import StatsCounter from '@components/sections/StatsCounter.astro';
import ProgramsGrid from '@components/sections/ProgramsGrid.astro';
import AboutPreview from '@components/sections/AboutPreview.astro';
import TestimonialsSlider from '@components/sections/TestimonialsSlider.astro';
import UpcomingEvents from '@components/sections/UpcomingEvents.astro';
import NewsPreview from '@components/sections/NewsPreview.astro';
import LatestInitiative from '@components/sections/LatestInitiative.astro';
import TrochaVerde from '@components/sections/TrochaVerde.astro';
import SponsorsBar from '@components/sections/SponsorsBar.astro';
import SafeClubBadge from '@components/sections/SafeClubBadge.astro';
import InscriptionCTA from '@components/common/InscriptionCTA.astro';
import WaveSeparator from '@components/common/WaveSeparator.astro';

const featuredFaqCategories = new Set(['general', 'inscripciones']);
const featuredFaqs = (await getCollection('faqs'))
  .filter((faq: CollectionEntry<'faqs'>) => !faq.data.draft)
  .filter((faq: CollectionEntry<'faqs'>) => featuredFaqCategories.has(faq.data.category))
  .sort(
    (a: CollectionEntry<'faqs'>, b: CollectionEntry<'faqs'>) =>
      (a.data.order ?? 99) - (b.data.order ?? 99),
  )
  .slice(0, 8)
  .map((faq: CollectionEntry<'faqs'>) => ({
    question: faq.data.question,
    answer: faq.data.answer,
  }));

const homeTitle = 'Escuela de Ciclomontañismo en Yumbo · Club Trocha y Ruta';
const homeDescription =
  'Escuela de ciclomontañismo y club deportivo para niños desde 4 años en Yumbo, Valle del Cauca. Clases de ciclismo, iniciación deportiva infantil y formación competitiva en MTB con 15 años de trayectoria.';

const jsonLd = [
  generateOrganizationJsonLd(),
  generateWebSiteJsonLd(),
  ...(featuredFaqs.length > 0 ? [generateFAQPageJsonLd(featuredFaqs)] : []),
];
---

<BaseLayout title={homeTitle} description={homeDescription} jsonLd={jsonLd}>
  <!-- 1. Gancho emocional -->
  <Hero />

  <!-- Wave: Hero → Stats -->
  <WaveSeparator from="fill-surface-dark" to="fill-surface-muted" />

  <!-- 2. Credibilidad rápida -->
  <div class="reveal">
    <StatsCounter />
  </div>

  <!-- 3. Qué ofrecemos -->
  <div class="reveal">
    <ProgramsGrid />
  </div>

  <!-- 4. Quién está detrás -->
  <div class="reveal">
    <AboutPreview />
  </div>

  <!-- 5. Prueba social -->
  <div class="reveal">
    <TestimonialsSlider />
  </div>

  <!-- Wave: Testimonials → CTA -->
  <WaveSeparator from="fill-surface-dark" to="fill-white" />

  <!-- 6. CTA intermedio — momento de conversión -->
  <div class="reveal">
    <section class="py-16 px-4">
      <div class="mx-auto max-w-4xl">
        <InscriptionCTA
          variant="inline"
          heading="Primera clase de prueba gratis"
          description="Escuela de Ciclomontañismo Trocha y Ruta · Yumbo, Valle del Cauca. Niños desde 4 años, entrenadores certificados, ambiente seguro y divertido."
        />
      </div>
    </section>
  </div>

  <!-- 7. Actividad y eventos -->
  <div class="reveal">
    <UpcomingEvents />
  </div>

  <!-- 8. Contenido editorial -->
  <div class="reveal">
    <NewsPreview />
  </div>

  <!-- 9. Iniciativa social destacada -->
  <div class="reveal">
    <LatestInitiative />
  </div>

  <!-- 10. Valores ambientales -->
  <div class="reveal">
    <TrochaVerde />
  </div>

  <!-- 10. Trust signals: sponsors + protección infantil -->
  <div class="reveal">
    <SponsorsBar />
  </div>
  <div class="reveal">
    <SafeClubBadge />
  </div>

  <!-- 11. CTA final -->
  <div class="reveal">
    <InscriptionCTA
      variant="banner"
      heading="Tu hijo puede empezar desde los 4 años"
      description="Formamos niños con valores a través del ciclomontañismo. Primera clase de prueba gratis, entrenadores certificados."
    />
  </div>
</BaseLayout>
