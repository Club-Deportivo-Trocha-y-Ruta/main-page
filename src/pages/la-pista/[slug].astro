---
/**
 * Ficha de un obstáculo: `/la-pista/[slug]`.
 *
 * Aquí vive lo que no cabe en el índice — la capa pedagógica del entrenador, la
 * ficha técnica y (Fase 2 del plan) el flipbook scroll-driven. Cada obstáculo
 * tiene URL propia porque es contenido de búsqueda long-tail y porque el índice
 * no puede crecer 700 px por obstáculo (docs/07-plan-la-pista.md §0.4).
 *
 * Como en el índice, en `dev` se generan también las fichas en `draft`.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import InscriptionCTA from '@components/common/InscriptionCTA.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import FactGrid, { type Fact } from '@components/editorial/FactGrid.astro';
import {
  activeObstacles,
  getAdjacentObstacles,
  obstacleTypeLabel,
  obstacleLevelLabel,
  obstacleLevelColors,
  programsUsingTrack,
  type ObstacleInput,
} from '@lib/la-pista';
import { getTrackImage } from '@lib/track-images';
import { formatDate } from '@lib/utils';
import { withUtm } from '@lib/utm';

type Obstacle = CollectionEntry<'obstaculos'>;

export async function getStaticPaths() {
  const all = await getCollection('obstaculos');
  const published = import.meta.env.DEV
    ? all
    : all.filter((o: CollectionEntry<'obstaculos'>) => !o.data.draft);

  const ordered = activeObstacles(
    published.map((entry: CollectionEntry<'obstaculos'>) => ({
      active: entry.data.active,
      order: entry.data.order,
      name: entry.data.name,
      entry,
    })),
  ).map((o) => o.entry);

  return ordered.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, number: index + 1, ordered },
  }));
}

interface Props {
  entry: Obstacle;
  number: number;
  ordered: Obstacle[];
}

const { entry, number, ordered } = Astro.props;
const { data } = entry;

const { Content } = await render(entry);

const image = getTrackImage(data.image);
const levelStyle = obstacleLevelColors[data.level] ?? {
  bg: 'bg-primary/10',
  text: 'text-primary-deep',
};

const programs = await getCollection('programs');
const trackPrograms = programsUsingTrack(
  [data as ObstacleInput],
  programs.map((p) => ({ id: p.id, title: p.data.title })),
);

const { previous, next } = getAdjacentObstacles(ordered, entry.id);

const facts: (Fact | null)[] = [
  { icon: 'ph:shapes-bold', label: 'Tipo', value: obstacleTypeLabel(data.type) },
  { icon: 'ph:gauge-bold', label: 'Nivel', value: obstacleLevelLabel(data.level) },
  data.builtOn
    ? { icon: 'ph:calendar-bold', label: 'Construido', value: formatDate(data.builtOn) }
    : null,
  data.builtBy ? { icon: 'ph:hammer-bold', label: 'Lo construyó', value: data.builtBy } : null,
  trackPrograms.length > 0
    ? {
        icon: 'ph:path-bold',
        label: 'Se trabaja en',
        value: trackPrograms.map((p) => p.title).join(', '),
      }
    : null,
];
---

<BaseLayout title={data.name} description={data.summary} ogImage={image?.src} noindex={data.draft}>
  <SectionShell tone="plain" width="wide" spacing="compact" labelledby="obstaculo-titulo">
    <Breadcrumb items={[{ label: 'La pista', href: '/la-pista' }, { label: data.name }]} />

    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_1.05fr] lg:items-start lg:gap-14">
      {
        image && (
          <Image
            src={image}
            alt={data.imageAlt ?? data.name}
            layout="none"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            widths={[480, 800, 1100]}
            sizes="(min-width: 1024px) 48vw, 100vw"
            class="rounded-card shadow-card aspect-[4/5] w-full object-cover"
          />
        )
      }

      <div>
        <div class="flex flex-wrap items-center gap-3">
          <span
            class="bg-accent-deep grid size-8 place-items-center rounded-full text-sm font-bold text-on-deep"
            aria-label={`Obstáculo ${number} del recorrido`}
          >
            {number}
          </span>
          <span
            class:list={[
              'rounded-pill px-3 py-1 text-xs font-semibold tracking-wider uppercase',
              levelStyle.bg,
              levelStyle.text,
            ]}
          >
            {obstacleLevelLabel(data.level)}
          </span>
        </div>

        <SectionIntro
          as="h1"
          id="obstaculo-titulo"
          class="mt-4"
          title={data.name}
          lead={data.summary}
        />

        {
          data.skills.length > 0 && (
            <div class="mt-8">
              <h2 class="text-primary-deep text-xs font-semibold tracking-[0.18em] uppercase">
                Qué entrena
              </h2>
              <ul class="mt-3 flex flex-wrap gap-2">
                {data.skills.map((skill) => (
                  <li class="rounded-pill bg-primary/10 text-text-primary px-3 py-1 text-sm font-medium">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <FactGrid items={facts} columns={2} class="mt-8" />
      </div>
    </div>
  </SectionShell>

  <!-- La capa pedagógica: qué se aprende y cómo se progresa -->
  <SectionShell tone="muted" width="narrow" label={`Cómo se aprende: ${data.name}`}>
    <div class="prose prose-slate max-w-none">
      <Content />
    </div>

    {
      data.video && (
        <a
          href={withUtm(data.video.url, {
            source: 'la-pista',
            medium: 'ficha',
            campaign: 'obstaculos',
          })}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary-deep mt-8 inline-flex items-center gap-2 font-semibold hover:underline"
        >
          <Icon name="ph:youtube-logo-bold" class="size-5" aria-hidden="true" />
          {data.video.title}
        </a>
      )
    }
  </SectionShell>

  <!-- Seguir el recorrido -->
  <SectionShell tone="plain" width="default" label="Otros obstáculos de la pista">
    {
      (previous || next) && (
        <nav aria-label="Otros obstáculos de la pista" class="grid gap-4 sm:grid-cols-2">
          {previous ? (
            <a
              href={`/la-pista/${previous.id}`}
              aria-label={`Obstáculo anterior: ${previous.data.name}`}
              class="group rounded-card hover:border-primary-deep flex items-center gap-3 border border-hairline p-4 transition-colors"
            >
              <Icon
                name="ph:arrow-left-bold"
                class="text-primary-deep size-5 shrink-0"
                aria-hidden="true"
              />
              <span>
                <span class="text-text-secondary block text-xs tracking-wider uppercase">
                  Anterior
                </span>
                <span class="text-text-primary font-semibold">{previous.data.name}</span>
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}

          {next && (
            <a
              href={`/la-pista/${next.id}`}
              aria-label={`Obstáculo siguiente: ${next.data.name}`}
              class="group rounded-card hover:border-primary-deep flex items-center justify-end gap-3 border border-hairline p-4 text-right transition-colors"
            >
              <span>
                <span class="text-text-secondary block text-xs tracking-wider uppercase">
                  Siguiente
                </span>
                <span class="text-text-primary font-semibold">{next.data.name}</span>
              </span>
              <Icon
                name="ph:arrow-right-bold"
                class="text-primary-deep size-5 shrink-0"
                aria-hidden="true"
              />
            </a>
          )}
        </nav>
      )
    }

    <a
      href="/la-pista"
      class="text-primary-deep mt-8 inline-flex items-center gap-2 font-semibold hover:underline"
    >
      <Icon name="ph:map-trifold-bold" class="size-5" aria-hidden="true" />
      Ver la pista completa
    </a>
  </SectionShell>

  <SectionShell tone="plain" width="default" spacing="compact" label="Inscripciones">
    <InscriptionCTA variant="banner" />
  </SectionShell>
</BaseLayout>
