---
/**
 * 404 — Página no encontrada.
 *
 * La metáfora: una señal de ruta en la montaña, no un callejón sin salida.
 * Quien se pierde en un sendero no necesita que le digan "te perdiste", sino
 * el siguiente punto de control. Por eso la página abre con el perfil de
 * elevación del sistema editorial —la misma pieza que dibuja la ruta de
 * programas— con un ciclista fuera de la traza y un marcador de regreso al
 * camino, y cierra con los cuatro puntos de control reales del sitio, cada
 * uno con un dato que sale del contenido (`@lib/not-found`), nunca escrito a
 * mano aquí.
 *
 * Sigue el sistema editorial (docs/04-sistema-editorial.md).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import FactGrid from '@components/editorial/FactGrid.astro';
import { elevationProfile, elevationPointAt, uniqueSvgId } from '@lib/editorial';
import { buildControlPoints } from '@lib/not-found';
import { CONTACT } from '@lib/constants';

type Event = CollectionEntry<'events'>;
type News = CollectionEntry<'news'>;
type Program = CollectionEntry<'programs'>;

const events = (await getCollection('events')).filter((e: Event) => !e.data.draft);
const news = (await getCollection('news')).filter((n: News) => !n.data.draft);
const programs = (await getCollection('programs'))
  .filter((p: Program) => !p.data.draft && p.data.active)
  .map((p: Program) => ({
    ageMin: p.data.ageMin,
    ageMax: p.data.ageMax,
    schedule: p.data.schedule,
    maxStudents: p.data.maxStudents,
  }));

const controlPoints = buildControlPoints({ events, news, programs });

// Ilustración: el mismo perfil de elevación que dibuja la ruta de programas,
// con un ciclista fuera de la traza (izquierda) y el regreso al camino
// marcado (derecha). Los puntos t son de composición, no de contenido: no
// hay una cifra que respalden, así que se quedan aquí y no en `not-found.ts`.
const profile = elevationProfile();
const uid = uniqueSvgId('notfound');
const LOST_AT = 0.4;
const BACK_AT = 0.78;
const onTrail = elevationPointAt(LOST_AT);
const offRoute = { xPct: onTrail.xPct, yPct: Math.max(onTrail.yPct - 24, 6) };
const backToRoute = elevationPointAt(BACK_AT);
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de lugar. Encuentra el calendario, las noticias, los programas o cómo inscribirte."
>
  <!-- La señal de ruta -->
  <SectionShell
    tone="tinted"
    pattern="topo"
    width="wide"
    spacing="compact"
    labelledby="error-404-titulo"
  >
    <SectionIntro
      as="h1"
      id="error-404-titulo"
      eyebrow="Error 404"
      eyebrowIcon="ph:signpost-bold"
      title="Te saliste del sendero, no de la ruta"
      highlight="no de la ruta"
      lead="La página que buscabas no existe o cambió de lugar. El mapa del club sigue completo: elige un punto de control y retoma la ruta."
      class="max-w-2xl"
    />

    <div class="mt-10 rounded-2xl border border-primary/15 bg-surface/70 p-5 backdrop-blur-sm sm:p-7">
      <!-- Extremos del perfil, mismo vocabulario que ProgramPathway -->
      <div class="flex items-center justify-between gap-4 text-[11px] font-semibold uppercase tracking-[0.16em] text-text-secondary">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="ph:warning-bold" class="size-3.5 shrink-0 text-primary-deep" aria-hidden="true" />
          Fuera de ruta
        </span>
        <span class="inline-flex items-center gap-1.5 text-right">
          De vuelta al camino
          <Icon name="ph:map-pin-bold" class="size-3.5 shrink-0 text-accent-deep" aria-hidden="true" />
        </span>
      </div>

      <figure class="not-prose relative mt-3 h-48 sm:h-56 md:h-64">
        <figcaption class="sr-only">
          Ilustración de un perfil de montaña: un ciclista aparece fuera de la traza marcada del
          sendero, a la izquierda del recorrido. Más adelante, sobre el camino, un marcador señala
          el regreso a la ruta principal: el enlace «Volver al inicio».
        </figcaption>

        <svg
          class="absolute inset-0 h-full w-full"
          viewBox="0 0 1000 260"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <clipPath id={`${uid}-back`}>
              <rect
                x={LOST_AT * 1000}
                y="0"
                width={(BACK_AT - LOST_AT) * 1000}
                height="260"
              />
            </clipPath>
          </defs>

          <!-- El terreno, sin marcar: donde nadie te guía todavía -->
          <path d={profile.area} class="text-primary/10" fill="currentColor" />
          <path
            d={profile.line}
            fill="none"
            class="text-primary-deep/45"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />

          <!-- El tramo que sí lleva de vuelta a la ruta principal -->
          <g clip-path={`url(#${uid}-back)`}>
            <path d={profile.area} class="text-accent/35" fill="currentColor" />
            <path
              d={profile.line}
              fill="none"
              class="text-accent-deep"
              stroke="currentColor"
              stroke-width="4.5"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
            />
          </g>
        </svg>

        <!-- Qué tan lejos de la traza quedó el ciclista -->
        <div
          class="absolute w-0 border-l-2 border-dashed border-primary-deep/40"
          style={`left:${offRoute.xPct}%;top:${offRoute.yPct}%;height:${onTrail.yPct - offRoute.yPct}%`}
          aria-hidden="true"
        ></div>
        <span
          class="absolute size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary-deep/50"
          style={`left:${onTrail.xPct}%;top:${onTrail.yPct}%`}
          aria-hidden="true"
        ></span>

        <!-- El ciclista, fuera de la traza: decorativo, el texto ya está en el figcaption -->
        <span
          class="motion-safe:animate-pulse absolute flex size-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-dashed border-primary-deep/60 bg-surface shadow-sm"
          style={`left:${offRoute.xPct}%;top:${offRoute.yPct}%`}
          aria-hidden="true"
        >
          <Icon name="ph:person-simple-bike-bold" class="size-6 text-primary-deep" aria-hidden="true" />
        </span>

        <!-- El regreso a la ruta: un enlace real, no decorativo -->
        <a
          href="/"
          aria-label="Volver al inicio — retoma la ruta principal"
          class="absolute flex -translate-x-1/2 -translate-y-full flex-col items-center gap-1 pb-1.5"
          style={`left:${backToRoute.xPct}%;top:${backToRoute.yPct}%`}
        >
          <span class="flex size-10 items-center justify-center rounded-full bg-accent text-surface-dark shadow-md ring-2 ring-white transition-transform duration-200 hover:scale-110">
            <Icon name="ph:map-pin-bold" class="size-5" aria-hidden="true" />
          </span>
          <span class="rounded-full bg-surface-dark px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white shadow">
            Inicio
          </span>
        </a>
      </figure>
    </div>
  </SectionShell>

  <!-- Puntos de control: las cuatro entradas reales del sitio -->
  <SectionShell tone="plain" width="wide" labelledby="puntos-control-titulo">
    <SectionIntro
      id="puntos-control-titulo"
      eyebrow="Puntos de control"
      eyebrowIcon="ph:map-trifold-bold"
      title="Cuatro formas de retomar la ruta"
      highlight="retomar la ruta"
      lead="Esto es lo que hay hoy en el sitio, no una lista de enlaces genéricos."
      class="max-w-2xl"
    />

    <ul class="mt-10 grid gap-5 sm:grid-cols-2">
      {controlPoints.map((point) => (
        <li>
          <a
            href={point.href}
            data-analytics-event={point.id === 'inscripciones' ? 'cta_inscripcion_click' : undefined}
            class="group flex h-full flex-col rounded-2xl bg-surface p-6 shadow-sm ring-1 ring-black/5 transition duration-300 hover:-translate-y-1 hover:shadow-lg"
          >
            <span class="flex size-11 items-center justify-center rounded-xl bg-primary/12 text-primary-deep">
              <Icon name={point.icon} class="size-6" aria-hidden="true" />
            </span>

            <h3 class="mt-4 font-display text-lg font-bold text-text-primary">
              {point.label}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-text-secondary">
              {point.description}
            </p>

            <FactGrid columns={1} class="mt-4" items={[point.fact]} />

            <span class="mt-auto flex items-center gap-1 pt-5 text-sm font-semibold text-primary-deep transition-all duration-200 group-hover:gap-2">
              {point.cta}
              <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </SectionShell>

  <!-- Si el enlace venía de otro lado y debería existir -->
  <SectionShell tone="muted" width="default" spacing="compact" label="Reportar un enlace roto">
    <div class="flex flex-col items-center gap-4 rounded-2xl border border-primary/15 bg-surface/70 px-6 py-8 text-center sm:px-10">
      <p class="max-w-md text-text-secondary">
        ¿Llegaste por un enlace de otro sitio y esta página debería existir? Cuéntanos.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <a
          href={`${CONTACT.whatsapp}?text=${encodeURIComponent('Hola, encontré un enlace roto en el sitio del club')}`}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="whatsapp_click"
          class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-6 py-3 font-semibold text-white transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
        >
          <Icon name="ph:whatsapp-logo" class="size-5 shrink-0" aria-hidden="true" />
          Escríbenos por WhatsApp
        </a>
        <a href="/contacto" class="text-sm font-medium text-primary-deep hover:underline">
          o usa el formulario de contacto
        </a>
      </div>
    </div>
  </SectionShell>
</BaseLayout>
