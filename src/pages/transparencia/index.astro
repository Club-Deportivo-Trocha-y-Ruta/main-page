---
/**
 * Transparencia.
 *
 * Una familia no entra aquí a coleccionar PDF: entra a decidir si el club es
 * serio y a dónde va su plata. La página abre con esa promesa (cuentas
 * abiertas, papeles al día) respaldada por cifras reales del JSON, explica
 * qué responde cada categoría de documento antes de listarlo —el corazón de
 * la página— y cierra con la ficha institucional y a quién escribirle si
 * falta algo.
 *
 * El peso de cada PDF se lee del disco aquí mismo, en build (Astro corre en
 * Node): si un archivo no aparece bajo `public/`, el documento se muestra
 * igual, solo sin el dato de peso.
 *
 * Sigue el sistema editorial (docs/04-sistema-editorial.md).
 */
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import StatFigure from '@components/editorial/StatFigure.astro';
import FactGrid from '@components/editorial/FactGrid.astro';
import DocumentLedger from '@components/sections/DocumentLedger.astro';
import { SITE, CONTACT } from '@lib/constants';
import {
  groupByCategory,
  summarizeDocuments,
  formatFileSize,
  type TransparencyDocument,
  type TransparencyDocumentWithSize,
} from '@lib/transparency';
import documentosRaw from '../../data/transparencia-documentos.json';

const documents: TransparencyDocument[] = documentosRaw;

/**
 * Lee el peso real del PDF en `public/`. Si el archivo no está en disco, el
 * documento se muestra igual: la ficha omite el peso en vez de romper el build.
 */
function readSizeLabel(archivo: string): string | null {
  try {
    const bytes = statSync(join(process.cwd(), 'public', archivo)).size;
    return formatFileSize(bytes);
  } catch {
    return null;
  }
}

const documentsWithSize: TransparencyDocumentWithSize[] = documents.map((doc) => ({
  ...doc,
  sizeLabel: readSizeLabel(doc.archivo),
}));

const groups = groupByCategory(documentsWithSize);
const summary = summarizeDocuments(documents);

const contactSubject = encodeURIComponent('Consulta sobre transparencia - Club Trocha y Ruta');
const whatsappMessage = encodeURIComponent(
  'Hola, quiero consultar sobre un documento de transparencia del club'
);
---

<BaseLayout
  title="Transparencia"
  description="Estados financieros, documentos legales, tributarios y actas del Club Deportivo Trocha y Ruta: la información institucional pública del club, organizada por categoría."
>
  <!-- La promesa, respaldada por cifras reales -->
  <SectionShell
    tone="tinted"
    pattern="topo"
    width="wide"
    spacing="compact"
    labelledby="transparencia-titulo"
  >
    <Breadcrumb items={[{ label: 'Transparencia' }]} />

    <div class="mt-6 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <SectionIntro
        as="h1"
        id="transparencia-titulo"
        eyebrow="Transparencia"
        eyebrowIcon="ph:scales-bold"
        title="Las cuentas del club, abiertas para cualquier familia"
        highlight="abiertas para cualquier familia"
        lead="Estados financieros, papeles legales y tributarios, y las actas de la asamblea, siempre con la vigencia más reciente publicada: la misma información que pediría un ente de control, al alcance de cualquier familia del club."
      />

      {summary.total > 0 && (
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-4 lg:grid-cols-2">
          <StatFigure value={summary.total} label="Documentos publicados" icon="ph:files-bold" />
          <StatFigure
            value={summary.categoryCount}
            label="Categorías de información"
            icon="ph:folders-bold"
          />
          {summary.latestYear !== null && (
            <StatFigure
              value={summary.latestYear}
              label="Vigencia más reciente"
              icon="ph:calendar-check-bold"
            />
          )}
          {summary.financialYearsCount !== null && (
            <StatFigure
              value={summary.financialYearsCount}
              unit={summary.financialYearsCount === 1 ? 'año' : 'años'}
              label="de estados financieros publicados"
              icon="ph:chart-bar-bold"
            />
          )}
        </div>
      )}
    </div>
  </SectionShell>

  <!-- El corazón: qué es cada documento, antes de descargarlo -->
  <SectionShell tone="muted" width="wide" labelledby="documentos-titulo">
    <SectionIntro
      id="documentos-titulo"
      eyebrow="Documentos"
      eyebrowIcon="ph:files-bold"
      title="Qué es cada documento, no solo cómo se llama"
      highlight="no solo cómo se llama"
      lead="Agrupados por tipo: cada categoría explica primero qué pregunta responde; después, los archivos que la respaldan."
      class="max-w-3xl"
    />

    {groups.length > 0 ? (
      <DocumentLedger groups={groups} tone="muted" class="mt-10 md:mt-12" />
    ) : (
      <p class="mt-8 text-text-secondary">No hay documentos publicados por el momento.</p>
    )}
  </SectionShell>

  <!-- Cierre: quién es el club y a quién escribirle -->
  <SectionShell tone="plain" width="default" spacing="compact" labelledby="institucion-titulo">
    <h2 id="institucion-titulo" class="font-display text-2xl font-bold text-text-primary sm:text-3xl">
      La ficha del club
    </h2>
    <p class="mt-2 max-w-2xl text-text-secondary">
      Los datos con los que el club queda identificado ante cualquier entidad.
    </p>

    <FactGrid
      class="mt-8"
      columns={2}
      items={[
        { icon: 'ph:identification-card-bold', label: 'Nombre', value: SITE.name },
        { icon: 'ph:calendar-blank-bold', label: 'Fundación', value: `1 de mayo de ${SITE.founded}` },
        { icon: 'ph:map-pin-bold', label: 'Dirección', value: CONTACT.address },
        { icon: 'ph:envelope-bold', label: 'Correo', value: CONTACT.email },
        { icon: 'ph:phone-bold', label: 'Teléfono', value: CONTACT.phone },
      ]}
    />

    <div class="mt-10 rounded-2xl border border-primary/15 bg-primary/5 p-6 text-center sm:p-8">
      <h3 class="font-display text-lg font-bold text-text-primary sm:text-xl">
        ¿Buscas un documento que no está aquí?
      </h3>
      <p class="mx-auto mt-2 max-w-xl text-text-secondary">
        Escríbenos y te lo hacemos llegar.
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`mailto:${CONTACT.email}?subject=${contactSubject}`}
          class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-surface-dark transition-colors duration-200 hover:bg-primary-deep hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <Icon name="ph:envelope-bold" class="size-4" aria-hidden="true" />
          Escribir un correo
        </a>
        <a
          href={`${CONTACT.whatsapp}?text=${whatsappMessage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-deep px-5 py-2.5 text-sm font-semibold text-primary-deep transition-colors duration-200 hover:bg-primary-deep hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <Icon name="ph:whatsapp-logo-bold" class="size-4" aria-hidden="true" />
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </SectionShell>
</BaseLayout>
