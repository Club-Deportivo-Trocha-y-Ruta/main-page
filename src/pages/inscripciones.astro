---
/**
 * Inscripciones.
 *
 * Quien llega aquí trae tres preguntas y hoy la página no respondía ninguna
 * antes de pedir datos: qué pasa después de enviar el formulario, si su hijo
 * o hija tiene la edad y cuánto cuesta. Responde en ese orden — el proceso
 * paso a paso, el programa según la edad, el formulario y el seguro— y cierra
 * con las dudas que quedan sueltas.
 *
 * Sigue el sistema editorial (docs/04-sistema-editorial.md).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import FaqAccordion from '@components/common/FaqAccordion.astro';
import InscriptionForm from '@components/interactive/InscriptionForm';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import StatFigure from '@components/editorial/StatFigure.astro';
import FactGrid from '@components/editorial/FactGrid.astro';
import ProgramPathway from '@components/sections/ProgramPathway.astro';
import EnrollmentSteps from '@components/sections/EnrollmentSteps.astro';
import { buildPathway, toPathwayInput } from '@lib/programs';
import { ENROLLMENT_STEPS, ENROLLMENT_DOCUMENTS, ENROLLMENT_POLICY } from '@lib/enrollment';
import { CONTACT } from '@lib/constants';
import { generateFAQPageJsonLd } from '@lib/seo';

type Program = CollectionEntry<'programs'>;

// Mismo filtro que consume el formulario más abajo: lo que se ve en la ruta
// de edades es exactamente lo que se puede elegir en el paso 1.
const programs = (await getCollection('programs'))
  .filter((p: Program) => !p.data.draft && p.data.active && p.data.enrollmentOpen)
  .sort((a: Program, b: Program) => a.data.order - b.data.order);

const programList = programs.map((p: Program) => ({
  id: p.id,
  title: p.data.title,
  ageRange: p.data.ageRange,
}));

const pathwayInput = programs.map(toPathwayInput);
const pathway = buildPathway(pathwayInput);
const firstStage = pathway.stages[0];

// El número de paso se deriva de la posición en ENROLLMENT_STEPS — igual que
// la numeración que pinta EnrollmentSteps — para que un reordenamiento no
// deje un "paso 3" o "paso 4" hablando de otro paso.
const trialStepNumber = ENROLLMENT_STEPS.findIndex((step) => step.title.includes('prueba')) + 1;
const documentsStepNumber =
  ENROLLMENT_STEPS.findIndex((step) => step.title.includes('documentos')) + 1;

// Las mismas 5 preguntas se pintan más abajo con FaqAccordion: el JSON-LD no
// puede describir contenido que la página no muestra.
const faqs = [
  {
    question: '¿Desde qué edad pueden inscribirse los niños?',
    answer: firstStage
      ? `Desde los ${pathway.domain.from} años, en ${firstStage.title}. Más abajo puedes ver qué programa le corresponde a tu hijo o hija según su edad.`
      : 'Escríbenos por WhatsApp y te contamos qué programa tiene cupo disponible para la edad de tu hijo o hija.',
  },
  {
    question: '¿Necesitan tener bicicleta propia?',
    answer:
      'Sí, cada niño o niña debe tener su propia bicicleta en buen estado. No es necesario que sea profesional: los entrenadores te orientan sobre la talla adecuada.',
  },
  {
    question: '¿Cuánto cuesta la inscripción?',
    answer: `La inscripción incluye el seguro deportivo anual (${ENROLLMENT_POLICY.annualFee} con ${ENROLLMENT_POLICY.insurer}). Las mensualidades varían según el programa: consúltalas por WhatsApp.`,
  },
  {
    question: '¿Dónde se realizan los entrenamientos?',
    answer: `Los entrenamientos se realizan en la Pista de Ciclomontañismo Carlos Castro, ${CONTACT.address}.`,
  },
  {
    question: '¿Pueden hacer una clase de prueba?',
    answer: `Sí: es el paso ${trialStepNumber} del proceso y no tiene costo. La agenda el director deportivo después de contactarte.`,
  },
];

const faqJsonLd = generateFAQPageJsonLd(faqs);
---

<BaseLayout
  title="Inscripciones"
  description="Preinscribe a tu hijo o hija en el Club Trocha y Ruta: el proceso paso a paso, el programa según su edad y el seguro deportivo incluido."
  jsonLd={faqJsonLd}
>
  <!-- Apertura: qué es este formulario y qué no es -->
  <SectionShell
    tone="tinted"
    pattern="topo"
    width="wide"
    spacing="compact"
    labelledby="inscripciones-titulo"
  >
    <Breadcrumb items={[{ label: 'Inscripciones' }]} />

    <div class="mt-6 max-w-3xl">
      <SectionIntro
        as="h1"
        id="inscripciones-titulo"
        eyebrow="Inscripciones"
        eyebrowIcon="ph:user-plus-bold"
        title="El primer paso para que empiece a rodar con nosotros"
        highlight="empiece a rodar"
        lead="Este formulario envía una solicitud de preinscripción, no un cupo confirmado. El director deportivo la revisa, te contacta y agenda una clase de prueba gratuita antes de pedirte cualquier documento."
      />

      <a
        href="#formulario"
        class="text-primary-deep mt-6 inline-flex items-center gap-1.5 text-sm font-semibold underline-offset-4 transition-colors hover:underline"
      >
        Ir directo al formulario
        <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" />
      </a>
    </div>
  </SectionShell>

  <!-- El proceso, paso a paso -->
  <SectionShell tone="plain" width="wide" labelledby="proceso-titulo">
    <SectionIntro
      id="proceso-titulo"
      eyebrow="Cómo funciona"
      eyebrowIcon="ph:list-checks-bold"
      title="De la solicitud al primer entrenamiento"
      highlight="primer entrenamiento"
      lead={`Sin letra pequeña: esto es exactamente lo que sigue, en ${ENROLLMENT_STEPS.length} pasos.`}
      class="max-w-2xl"
    />

    <EnrollmentSteps steps={ENROLLMENT_STEPS} class="mt-12" />

    <div class="border-primary/15 bg-surface-muted mt-10 rounded-2xl border p-5 sm:p-6">
      <p class="text-text-secondary text-[11px] font-semibold tracking-wider uppercase">
        Qué debes presentar en el paso {documentsStepNumber}
      </p>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          ENROLLMENT_DOCUMENTS.map((doc) => (
            <li class="text-text-primary flex items-start gap-2 text-sm leading-snug">
              <Icon
                name={doc.icon}
                class="text-primary-deep mt-0.5 size-4 shrink-0"
                aria-hidden="true"
              />
              <span>{doc.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </SectionShell>

  <!-- Qué programa le corresponde, según la edad -->
  {
    programs.length > 0 && (
      <SectionShell tone="muted" pattern="topo" width="wide" labelledby="edad-titulo">
        <SectionIntro
          id="edad-titulo"
          eyebrow="Según la edad"
          eyebrowIcon="ph:path-bold"
          title="Un programa para cada edad, sin adivinar"
          highlight="sin adivinar"
          lead={`Hay ${programs.length} ${programs.length === 1 ? 'programa' : 'programas'} con cupo abierto. Toca el tramo de edad de tu hijo o hija para ver el programa completo.`}
          class="max-w-2xl"
        />

        <div class="border-primary/15 bg-surface/70 mt-10 rounded-2xl border p-5 backdrop-blur-sm sm:p-7">
          <ProgramPathway programs={pathwayInput} legend />
        </div>
      </SectionShell>
    )
  }

  <!-- El formulario -->
  <SectionShell
    id="formulario"
    tone="plain"
    width="narrow"
    labelledby="formulario-titulo"
    class="scroll-mt-20"
  >
    <SectionIntro
      id="formulario-titulo"
      eyebrow="Formulario"
      eyebrowIcon="ph:clipboard-text-bold"
      title="Completa los datos de tu hijo o hija"
      highlight="tu hijo o hija"
      lead="Programa, corredor y acudiente. Si no terminas de una sentada, tus datos quedan guardados en este dispositivo por 48 horas."
    />

    <InscriptionForm client:visible programs={programList} />
  </SectionShell>

  <!-- El seguro deportivo -->
  <SectionShell tone="muted" width="default" labelledby="seguro-titulo">
    <SectionIntro
      id="seguro-titulo"
      eyebrow="Seguro deportivo"
      eyebrowIcon="ph:shield-check-bold"
      title="La póliza que cubre cada entrenamiento"
      highlight="cada entrenamiento"
      lead="El club paga un seguro de accidentes personales para todos los deportistas activos. Esto es lo que incluye."
      class="max-w-2xl"
    />

    <dl class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <StatFigure
        value={ENROLLMENT_POLICY.annualFee}
        unit="/año"
        label="Valor del seguro"
        note="Se paga aparte, al confirmar la inscripción"
        icon="ph:currency-circle-dollar-bold"
      />
      <StatFigure
        value={ENROLLMENT_POLICY.insurer}
        size="sm"
        label="Aseguradora"
        icon="ph:seal-check-bold"
      />
      <StatFigure
        value={ENROLLMENT_POLICY.validity}
        size="sm"
        label="Vigencia de la póliza"
        icon="ph:calendar-check-bold"
      />
    </dl>

    <FactGrid
      class="mt-10"
      columns={3}
      items={ENROLLMENT_POLICY.coverages.map((coverage) => ({
        icon: coverage.icon,
        label: coverage.label,
        value: coverage.amount,
      }))}
    />
  </SectionShell>

  <!-- Dudas y contacto -->
  <SectionShell tone="plain" width="narrow" labelledby="dudas-titulo">
    <SectionIntro
      id="dudas-titulo"
      eyebrow="Dudas frecuentes"
      eyebrowIcon="ph:question-bold"
      title="Las dudas que más nos preguntan"
      highlight="más nos preguntan"
      lead="Si tu duda no está aquí, escríbenos: respondemos por WhatsApp."
      class="max-w-2xl"
    />

    <div class="mt-8">
      <FaqAccordion items={faqs} />
    </div>

    <div class="mt-12 flex flex-col items-center gap-4 border-t border-black/10 pt-8 text-center">
      <a
        href={`${CONTACT.whatsapp}?text=${encodeURIComponent('Hola, tengo una duda sobre la inscripción')}`}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="whatsapp_click"
        class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-6 py-3 font-semibold text-white transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
      >
        <Icon name="ph:whatsapp-logo" class="size-5 shrink-0" aria-hidden="true" />
        Escríbenos por WhatsApp
      </a>
      <p class="text-text-secondary text-sm">
        o llámanos al <a
          href={CONTACT.phoneLink}
          class="text-primary-deep font-medium hover:underline">{CONTACT.phone}</a
        >
      </p>
    </div>
  </SectionShell>
</BaseLayout>
