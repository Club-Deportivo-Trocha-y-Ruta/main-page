---
/**
 * Quiénes Somos.
 *
 * Sigue el sistema editorial (docs/04-sistema-editorial.md). El orden responde
 * lo que una familia pregunta en este orden: quiénes son (cifras), de dónde
 * vienen (el recorrido), qué los mueve (misión y valores), por qué confiarles
 * un hijo (respaldo) y cómo se ve por dentro (comunidad).
 *
 * Todas las cifras salen de `constants.ts` y de las collections; los textos de
 * la comunidad, de `gallery` y `testimonials`.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import InscriptionCTA from '@components/common/InscriptionCTA.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import StatFigure from '@components/editorial/StatFigure.astro';
import Timeline, { type TimelineItem } from '@components/editorial/Timeline.astro';
import { SITE, CLUB_STATS, CHILD_SAFETY, getYearsActive } from '@lib/constants';
import { generateSportsClubJsonLd } from '@lib/seo';
import { getTreeStats } from '@lib/trocha-verde';

import historiaPista from '@assets/images/refresh/historia-pista.webp';
import historiaEquipoGinebra from '@assets/images/refresh/historia-equipo-ginebra.webp';
import historiaSiembra from '@assets/images/refresh/historia-siembra.webp';
import historiaEquipoPalmira from '@assets/images/refresh/historia-equipo-palmira.webp';
import comunidadCircuito from '@assets/images/refresh/comunidad-circuito.webp';

type Gallery = CollectionEntry<'gallery'>;
type Testimonial = CollectionEntry<'testimonials'>;

const sportsClubJsonLd = generateSportsClubJsonLd();
const yearsActive = getYearsActive();
const treeStats = await getTreeStats();

// Cifras de cabecera. Fuente única: constants.ts + collections, para no
// contradecir lo que dicen las otras páginas.
const figures = [
  {
    value: yearsActive,
    label: 'Años formando ciclistas',
    note: `Desde el 1 de mayo de ${SITE.founded}`,
    icon: 'ph:calendar-heart-bold',
  },
  {
    value: `${CLUB_STATS.ridersTrained}+`,
    label: 'Niños y jóvenes formados',
    icon: 'ph:person-simple-bike-bold',
  },
  {
    value: `${CLUB_STATS.medals}+`,
    label: 'Medallas departamentales y nacionales',
    icon: 'ph:medal-bold',
  },
  {
    value: treeStats.totalTrees,
    label: 'Árboles sembrados en la pista',
    note: `${treeStats.totalRecycled} con llantas recicladas`,
    icon: 'ph:tree-bold',
  },
];

const milestones: TimelineItem[] = [
  {
    label: `${SITE.founded}`,
    title: 'Nace el club',
    body: `El 1 de mayo de ${SITE.founded} un grupo de familias de Yumbo convirtió las salidas de fin de semana en un proyecto formativo. Así arrancó ${SITE.name}.`,
    icon: 'ph:flag-bold',
    image: historiaEquipoGinebra,
    imageAlt:
      'Deportistas del Club Trocha y Ruta reunidos antes de la salida de una competencia',
  },
  {
    label: 'La casa',
    title: 'Pista XCO Carlos Castro',
    body: 'La pista de ciclomontañismo Carlos Castro, en Yumbo, es donde los "teteros" dan sus primeros pedalazos y donde el club entrena semana a semana.',
    icon: 'ph:map-pin-bold',
    image: historiaPista,
    imageAlt: 'Valla de la Pista XCO Carlos Castro de Yumbo en día de competencia',
  },
  {
    label: 'Hoy',
    title: 'Del barrio al calendario nacional',
    body: `${CLUB_STATS.medals}+ medallas después, el club compite cada válida de la Copa Valle y lleva corredores a campeonatos departamentales y nacionales.`,
    icon: 'ph:trophy-bold',
    image: comunidadCircuito,
    imageAlt: 'Corredora del club atacando una subida técnica en un circuito de XCO',
  },
  {
    label: '2026',
    title: 'Trocha Verde',
    body: `La pista también se siembra: ${treeStats.totalTrees} árboles plantados con llantas recicladas como protectores, junto a familias, vecinos y aliados ambientales.`,
    icon: 'ph:leaf-bold',
    image: historiaSiembra,
    imageAlt:
      'Niño del club regando un árbol recién sembrado en la pista durante la Sembratón',
  },
];

// Los valores estaban en una sola frase separada por comas: partidos en piezas
// se pueden leer de un vistazo.
const values = [
  { label: 'Disciplina', icon: 'ph:target-bold' },
  { label: 'Trabajo en equipo', icon: 'ph:users-three-bold' },
  { label: 'Respeto por la naturaleza', icon: 'ph:leaf-bold' },
  { label: 'Perseverancia', icon: 'ph:mountains-bold' },
  { label: 'Honestidad', icon: 'ph:seal-check-bold' },
  { label: 'Compañerismo', icon: 'ph:hand-heart-bold' },
];

// Respaldo: lo que una familia necesita saber antes de dejar a su hijo. Cada
// afirmación tiene una página donde se puede verificar.
const credentials = [
  {
    icon: 'ph:shield-check-bold',
    title: 'Política de protección infantil',
    body: `Protocolo público de protección de niños, niñas y adolescentes. Línea ICBF ${CHILD_SAFETY.icbfLine} para emergencias.`,
    href: CHILD_SAFETY.policyUrl,
    cta: 'Ver la política',
  },
  {
    icon: 'ph:first-aid-kit-bold',
    title: 'Póliza de accidentes personales',
    body: 'Cada deportista cuenta con póliza de accidentes con Aseguradora Solidaria de Colombia, vigente durante entrenamientos, competencias y eventos del club.',
    href: '/programas',
    cta: 'Ver coberturas por programa',
  },
  {
    icon: 'ph:certificate-bold',
    title: 'Entrenadores certificados',
    body: 'En la Escuela de Iniciación cada grupo tiene un entrenador certificado y un monitor de apoyo, con un máximo de 10 niños por instructor.',
    href: '/programas/escuela-de-iniciacion',
    cta: 'Ver el programa',
  },
  {
    icon: 'ph:handshake-bold',
    title: 'Alianza con la Liga Vallecaucana',
    body: 'Trabajamos con la Liga Vallecaucana de Ciclismo y competimos en el calendario oficial del departamento.',
    href: '/calendario',
    cta: 'Ver el calendario',
  },
  {
    icon: 'ph:flag-banner-bold',
    title: 'Representación nacional desde 2018',
    body: 'Corredores del club compiten en campeonatos nacionales de la Federación Colombiana de Ciclismo en sus respectivas categorías.',
    href: '/noticias',
    cta: 'Ver resultados',
  },
  {
    icon: 'ph:scales-bold',
    title: 'Cuentas a la vista',
    body: 'El club publica su información institucional y financiera: a dónde va cada aporte de las familias y de los patrocinadores.',
    href: '/transparencia',
    cta: 'Ver transparencia',
  },
];

// Comunidad: últimos álbumes publicados, no fotos escogidas a mano.
const albums = (await getCollection('gallery'))
  .filter((g: Gallery) => !g.data.draft)
  .sort((a: Gallery, b: Gallery) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const testimonials = (await getCollection('testimonials')).filter(
  (t: Testimonial) => !t.data.draft && t.data.type === 'familia'
);
const voice =
  testimonials.find((t: Testimonial) => t.data.featured) ??
  testimonials.sort((a: Testimonial, b: Testimonial) => a.data.order - b.data.order)[0];
---

<BaseLayout
  title="Quiénes Somos"
  description={`Historia, misión y valores del ${SITE.name}: ${yearsActive} años formando niños y jóvenes a través del ciclomontañismo en Yumbo, Valle del Cauca.`}
  jsonLd={sportsClubJsonLd}
>
  <!-- Quiénes somos, en cifras -->
  <SectionShell tone="tinted" pattern="topo" width="wide" spacing="compact" labelledby="club-titulo">
    <Breadcrumb items={[{ label: 'Quiénes Somos' }]} />

    <div class="mt-6 grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
      <SectionIntro
        as="h1"
        id="club-titulo"
        eyebrow={`${yearsActive} años en Yumbo`}
        eyebrowIcon="ph:map-trifold-bold"
        title="Empezó como una salida de fin de semana entre familias"
        highlight="entre familias"
        lead={`El 1 de mayo de ${SITE.founded}, un grupo de papás de Yumbo decidió que las rodadas del domingo podían ser algo más. ${yearsActive} años después el club entrena en su propia pista, compite en cada válida de la Copa Valle y siembra el terreno por donde rueda.`}
      />

      <Image
        src={historiaEquipoPalmira}
        alt="El equipo completo del Club Trocha y Ruta con sus familias y bicicletas en la carpa del club durante una válida de la Copa Valle"
        layout="none"
        widths={[500, 800, 1100]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-md"
      />
    </div>

    <dl class="mt-12 grid grid-cols-2 gap-6 border-t border-primary/15 pt-8 lg:grid-cols-4">
      {figures.map((figure) => (
        <StatFigure
          value={figure.value}
          label={figure.label}
          note={figure.note}
          icon={figure.icon}
        />
      ))}
    </dl>
  </SectionShell>

  <!-- El recorrido -->
  <SectionShell tone="plain" width="wide" labelledby="recorrido-titulo">
    <SectionIntro
      id="recorrido-titulo"
      eyebrow="El recorrido"
      eyebrowIcon="ph:path-bold"
      title="De unas salidas de domingo a una escuela con pista propia"
      highlight="pista propia"
      lead="Cuatro paradas que explican dónde está hoy el club."
      align="center"
      class="mx-auto max-w-3xl"
    />

    <Timeline items={milestones} class="mt-14" />
  </SectionShell>

  <!-- Lo que nos mueve -->
  <SectionShell tone="dark" pattern="topo" width="wide" labelledby="proposito-titulo">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionIntro
          id="proposito-titulo"
          tone="dark"
          eyebrow="Lo que nos mueve"
          eyebrowIcon="ph:compass-bold"
          title="Formar personas que, además, corren en bicicleta"
          highlight="Formar personas"
        />

        <div class="mt-8 space-y-6">
          <div class="border-l-2 border-accent pl-5">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent-light">Misión</p>
            <p class="mt-2 text-lg leading-relaxed text-white/85">
              Formar niños y jóvenes integrales a través del ciclomontañismo, promoviendo
              valores, disciplina y amor por la naturaleza.
            </p>
          </div>
          <div class="border-l-2 border-white/25 pl-5">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/60">Visión</p>
            <p class="mt-2 leading-relaxed text-white/75">
              Ser el club referente en formación deportiva infantil y juvenil en el Valle del
              Cauca, reconocido por su excelencia deportiva y humana.
            </p>
          </div>
        </div>
      </div>

      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/60">
          Los valores que entrenamos
        </p>
        <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-2">
          {values.map((value) => (
            <li class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 p-4">
              <Icon name={value.icon} class="size-6 shrink-0 text-accent-light" aria-hidden="true" />
              <span class="font-display text-sm font-bold leading-tight text-white">
                {value.label}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </SectionShell>

  <!-- Respaldo -->
  <SectionShell tone="muted" width="wide" labelledby="respaldo-titulo">
    <SectionIntro
      id="respaldo-titulo"
      eyebrow="Respaldo"
      eyebrowIcon="ph:shield-check-bold"
      title="Lo que hay detrás de cada entrenamiento"
      highlight="cada entrenamiento"
      lead="Dejar a un hijo en un club deportivo es un acto de confianza. Esto es lo que la sostiene — y dónde puedes verificarlo."
      align="center"
      class="mx-auto max-w-3xl"
    />

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {credentials.map((item, index) => (
        <li
          class="reveal group relative flex flex-col rounded-2xl bg-surface p-6 shadow-sm ring-1 ring-black/5 transition duration-300 hover:-translate-y-1 hover:shadow-md"
          style={`--stagger:${Math.min(index, 3) * 80}ms`}
        >
          <span class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary-deep">
            <Icon name={item.icon} class="size-6" aria-hidden="true" />
          </span>
          <h3 class="mt-4 font-display text-base font-bold text-text-primary">
            <a href={item.href} class="after:absolute after:inset-0 hover:text-primary-deep">
              {item.title}
            </a>
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-text-secondary">{item.body}</p>
          <span
            class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-deep transition-all duration-200 group-hover:gap-2"
            aria-hidden="true"
          >
            {item.cta}
            <Icon name="ph:arrow-right-bold" class="size-4" />
          </span>
        </li>
      ))}
    </ul>
  </SectionShell>

  <!-- La comunidad -->
  <SectionShell tone="plain" width="wide" labelledby="comunidad-titulo">
    <SectionIntro
      id="comunidad-titulo"
      eyebrow="La comunidad"
      eyebrowIcon="ph:users-three-bold"
      title="Así se ve un fin de semana del club"
      highlight="fin de semana"
      lead="Las fotos son de las últimas salidas y competencias, no de un banco de imágenes."
      align="center"
      class="mx-auto max-w-3xl"
    />

    {albums.length > 0 && (
      <ul class="mt-12 grid gap-5 sm:grid-cols-3">
        {albums.map((album: Gallery, index: number) => (
          <li
            class="reveal group relative overflow-hidden rounded-2xl bg-surface-muted shadow-sm"
            style={`--stagger:${index * 80}ms`}
          >
            <a href={`/galeria/${album.id}`} class="block">
              <img
                src={album.data.cover}
                alt={album.data.coverAlt ?? `Portada del álbum ${album.data.title}`}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/45 to-transparent p-4">
                <span class="block font-display text-sm font-bold leading-snug text-white">
                  {album.data.title}
                </span>
                <span class="mt-0.5 block text-xs text-white/80">
                  {album.data.images.length} fotos
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}

    {voice && (
      <figure class="mx-auto mt-14 max-w-3xl rounded-2xl border-l-4 border-primary bg-primary/5 p-6 sm:p-8">
        <Icon name="ph:quotes-fill" class="size-8 text-primary/40" aria-hidden="true" />
        <blockquote class="mt-3">
          <p class="font-display text-lg font-semibold leading-relaxed text-text-primary sm:text-xl">
            {voice.data.quote}
          </p>
        </blockquote>
        <figcaption class="mt-4 text-sm text-text-secondary">
          <span class="font-semibold text-text-primary">{voice.data.name}</span> ·{' '}
          {voice.data.roleLabel}
        </figcaption>
        <a
          href="/testimonios"
          class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary-deep transition-all duration-200 hover:gap-2"
        >
          Leer más testimonios
          <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" />
        </a>
      </figure>
    )}
  </SectionShell>

  <SectionShell tone="plain" width="default" spacing="compact" label="Inscripciones">
    <InscriptionCTA
      variant="inline"
      heading="¿Quieres ser parte de esta historia?"
      description="La primera clase es de prueba y no tiene costo. Ven un martes o un viernes a la pista y mira cómo entrenamos."
    />
  </SectionShell>
</BaseLayout>
