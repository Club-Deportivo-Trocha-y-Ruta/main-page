---
/**
 * Patrocinadores.
 *
 * Quien entra aquí decide si pone plata, y la pregunta que trae es "¿qué
 * recibo a cambio?". La página responde con hechos verificables, en este
 * orden: la promesa (hero), la evidencia de dónde aparece la marca (fechas,
 * crónicas, siembra), quiénes ya confían hoy —con su antigüedad, no como una
 * grilla de logos anónimos— y por último los niveles como una progresión, no
 * como cuatro cajas iguales.
 *
 * Sigue el sistema editorial (docs/04-sistema-editorial.md).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import SectionShell from '@components/editorial/SectionShell.astro';
import SectionIntro from '@components/editorial/SectionIntro.astro';
import StatFigure from '@components/editorial/StatFigure.astro';
import SponsorshipTiers from '@components/sections/SponsorshipTiers.astro';
import { CONTACT, CLUB_STATS, getYearsActive } from '@lib/constants';
import { getTreeStats } from '@lib/trocha-verde';
import {
  isPublishableSponsor,
  groupByLevel,
  sponsorSince,
  summarizeSponsors,
  summarizeEvidence,
} from '@lib/sponsors';

type Sponsor = CollectionEntry<'sponsors'>;
type Event = CollectionEntry<'events'>;
type News = CollectionEntry<'news'>;

interface EvidenceCard {
  value: number;
  label: string;
  note: string;
  icon: string;
  body: string;
  href: string;
  cta: string;
}

const sponsors = (await getCollection('sponsors'))
  .filter((s: Sponsor) => isPublishableSponsor(s))
  .sort((a: Sponsor, b: Sponsor) => a.data.order - b.data.order);

const groups = groupByLevel(sponsors);
const sponsorsSummary = summarizeSponsors(sponsors);

// Evidencia de exposición: de dónde sale "9 fechas al año, 9 crónicas
// publicadas" en vez de escribirlo a mano — se pudre apenas cambie el
// calendario.
const events = (await getCollection('events')).filter((e: Event) => !e.data.draft);
const news = (await getCollection('news')).filter((n: News) => !n.data.draft);
const treeStats = await getTreeStats();

const evidence = summarizeEvidence({
  events,
  publishedStories: news.length,
  treesPlanted: treeStats.totalTrees,
});

const rawEvidenceCards: (EvidenceCard | null)[] = [
  evidence.seasonDates !== null && evidence.seasonYear !== null
    ? {
        value: evidence.seasonDates,
        label: 'Fechas de competencia',
        note: `Temporada ${evidence.seasonYear}`,
        icon: 'ph:flag-checkered-bold',
        body: 'Cada válida de la Copa Valle y cada campeonato en el que corre el equipo, con público, otros clubes y prensa local en la línea de salida.',
        href: '/calendario',
        cta: 'Ver el calendario',
      }
    : null,
  evidence.publishedStories !== null
    ? {
        value: evidence.publishedStories,
        label: 'Crónicas publicadas',
        note: 'Después de cada fecha',
        icon: 'ph:newspaper-bold',
        body: 'Resultados, fotos y el resumen de cada carrera, publicados en el sitio del club apenas termina la competencia.',
        href: '/noticias',
        cta: 'Leer las crónicas',
      }
    : null,
  evidence.treesPlanted !== null
    ? {
        value: evidence.treesPlanted,
        label: 'Árboles sembrados',
        note: 'Por Trocha Verde',
        icon: 'ph:tree-bold',
        body: 'La siembra ambiental del club en la misma pista donde entrenan los niños: una huella que crece todo el año, no una jornada aislada.',
        href: '/trocha-verde',
        cta: 'Ver Trocha Verde',
      }
    : null,
];

const evidenceCards = rawEvidenceCards.filter((card): card is EvidenceCard => card !== null);

const yearsActive = getYearsActive();

const whatsappPatrocinio = `${CONTACT.whatsapp}?text=${encodeURIComponent('Hola, quiero información sobre patrocinio del Club Deportivo Trocha y Ruta')}`;
const mailtoPatrocinio = `mailto:${CONTACT.email}?subject=${encodeURIComponent('Consulta sobre patrocinio - Club Trocha y Ruta')}`;
---

<BaseLayout
  title="Patrocinadores"
  description="Empresas e instituciones que patrocinan al Club Deportivo Trocha y Ruta: niveles de patrocinio, aliados actuales y dónde aparece tu marca cada temporada."
>
  <!-- La promesa -->
  <SectionShell
    tone="tinted"
    pattern="topo"
    width="wide"
    spacing="compact"
    labelledby="patrocinadores-titulo"
  >
    <Breadcrumb items={[{ label: 'Patrocinadores' }]} />

    <div class="mt-6 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <SectionIntro
        as="h1"
        id="patrocinadores-titulo"
        eyebrow="Patrocinadores"
        eyebrowIcon="ph:handshake-bold"
        title="Tu marca rueda con el equipo toda la temporada"
        highlight="toda la temporada"
        lead="Cada válida, cada crónica publicada y cada árbol sembrado por Trocha Verde llevan también el nombre de quienes acompañan al club. Así se hace visible tu inversión."
      />

      <dl class="grid grid-cols-2 gap-6 sm:grid-cols-4 lg:grid-cols-2">
        <StatFigure value={yearsActive} label="Años de trayectoria" icon="ph:calendar-heart-bold" />
        <StatFigure
          value={`${CLUB_STATS.ridersTrained}+`}
          label="Niños y jóvenes formados"
          icon="ph:person-simple-bike-bold"
        />
        <StatFigure
          value={`${CLUB_STATS.competitions}+`}
          label="Competencias disputadas"
          icon="ph:flag-checkered-bold"
        />
        <StatFigure
          value={`${CLUB_STATS.medals}+`}
          label="Medallas conquistadas"
          icon="ph:medal-bold"
        />
      </dl>
    </div>
  </SectionShell>

  <!-- La evidencia: dónde aparece la marca -->
  {
    evidenceCards.length > 0 && (
      <SectionShell tone="muted" width="wide" labelledby="visibilidad-titulo">
        <SectionIntro
          id="visibilidad-titulo"
          eyebrow="Visibilidad"
          eyebrowIcon="ph:megaphone-bold"
          title="Tres lugares donde tu marca queda a la vista"
          highlight="a la vista"
          lead="No es una promesa abstracta: esto es lo que el club produce temporada tras temporada, con tu marca en cada uno."
          align="center"
          class="mx-auto max-w-3xl"
        />

        <ul class="mt-12 grid gap-5 sm:grid-cols-3" role="list">
          {evidenceCards.map((card, index) => (
            <li
              class="reveal bg-surface flex flex-col rounded-2xl p-6 shadow-sm ring-1 ring-black/5 transition duration-300 hover:-translate-y-1 hover:shadow-md"
              style={`--stagger:${index * 80}ms`}
            >
              <StatFigure value={card.value} label={card.label} note={card.note} icon={card.icon} />
              <p class="text-text-secondary mt-3 flex-1 text-sm leading-relaxed">{card.body}</p>
              <a
                href={card.href}
                class="text-primary-deep mt-4 inline-flex items-center gap-1 text-sm font-semibold transition-all duration-200 hover:gap-2"
              >
                {card.cta}
                <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </SectionShell>
    )
  }

  <!-- Quiénes ya confían, con su antigüedad -->
  {
    groups.length > 0 && (
      <SectionShell tone="plain" width="wide" labelledby="aliados-actuales-titulo">
        <SectionIntro
          id="aliados-actuales-titulo"
          eyebrow={`${sponsorsSummary.total} ${sponsorsSummary.total === 1 ? 'marca acompaña' : 'marcas acompañan'} al club`}
          eyebrowIcon="ph:storefront-bold"
          title="Quiénes ya confían en nosotros"
          highlight="ya confían"
          lead={
            sponsorsSummary.oldestYear
              ? `El aliado más antiguo nos acompaña desde ${sponsorsSummary.oldestYear}.`
              : undefined
          }
          align="center"
          class="mx-auto max-w-3xl"
        />

        <div class="mt-12 space-y-10">
          {groups.map((group) => (
            <div>
              <h3 class="font-display text-text-secondary mb-5 flex items-center gap-3 text-sm font-bold tracking-wide uppercase">
                <Icon
                  name={group.level.icon}
                  class:list={['size-4 shrink-0', group.level.text]}
                  aria-hidden="true"
                />
                {group.level.labelPlural}
                <span class="h-px flex-1 bg-black/10" aria-hidden="true" />
              </h3>

              {group.level.id === 'principal' ? (
                <ul class="grid gap-6" role="list">
                  {group.sponsors.map((sponsor) => {
                    const tenure = sponsorSince(sponsor.data.startDate);
                    return (
                      <li class="border-primary-deep/20 from-primary-deep/5 via-surface to-surface flex flex-col gap-6 rounded-2xl border bg-gradient-to-br p-6 shadow-sm sm:flex-row sm:items-center sm:p-8">
                        <div class="bg-surface relative h-28 w-full shrink-0 overflow-hidden rounded-xl sm:h-32 sm:w-56">
                          <img
                            src={sponsor.data.logo}
                            alt={`Logo de ${sponsor.data.name}`}
                            loading="lazy"
                            decoding="async"
                            class="absolute inset-0 h-full w-full object-contain p-4"
                          />
                        </div>
                        <div class="min-w-0">
                          <h4 class="font-display text-text-primary text-2xl font-bold">
                            {sponsor.data.name}
                          </h4>
                          {sponsor.data.description && (
                            <p class="text-text-secondary mt-2">{sponsor.data.description}</p>
                          )}
                          <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                            {tenure && (
                              <span class="text-text-secondary inline-flex items-center gap-1.5">
                                <Icon
                                  name="ph:calendar-check-bold"
                                  class="text-primary-deep size-4 shrink-0"
                                  aria-hidden="true"
                                />
                                {tenure.label}
                              </span>
                            )}
                            {sponsor.data.url && (
                              <a
                                href={sponsor.data.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-analytics-event="sponsor_click"
                                data-analytics-sponsor-id={sponsor.id}
                                class="text-primary-deep inline-flex items-center gap-1 font-semibold hover:underline"
                              >
                                Visitar sitio web
                                <Icon
                                  name="ph:arrow-square-out-bold"
                                  class="size-3.5 shrink-0"
                                  aria-hidden="true"
                                />
                              </a>
                            )}
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
                  {group.sponsors.map((sponsor) => {
                    const tenure = sponsorSince(sponsor.data.startDate);
                    return (
                      <li class="bg-surface flex flex-col rounded-2xl p-5 shadow-sm ring-1 ring-black/5">
                        <div class="bg-surface-muted relative h-20 w-full overflow-hidden rounded-lg">
                          <img
                            src={sponsor.data.logo}
                            alt={`Logo de ${sponsor.data.name}`}
                            loading="lazy"
                            decoding="async"
                            class="absolute inset-0 h-full w-full object-contain p-3"
                          />
                        </div>
                        <h4 class="font-display text-text-primary mt-4 text-base font-bold">
                          {sponsor.data.name}
                        </h4>
                        {tenure && (
                          <p class="text-text-secondary mt-1 text-xs font-medium">{tenure.label}</p>
                        )}
                        {sponsor.data.description && (
                          <p class="text-text-secondary mt-2 line-clamp-3 flex-1 text-sm leading-snug">
                            {sponsor.data.description}
                          </p>
                        )}
                        {sponsor.data.url && (
                          <a
                            href={sponsor.data.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            data-analytics-event="sponsor_click"
                            data-analytics-sponsor-id={sponsor.id}
                            class="text-primary-deep mt-3 inline-flex items-center gap-1 text-sm font-semibold hover:underline"
                          >
                            Visitar sitio
                            <Icon
                              name="ph:arrow-square-out-bold"
                              class="size-3 shrink-0"
                              aria-hidden="true"
                            />
                          </a>
                        )}
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          ))}
        </div>
      </SectionShell>
    )
  }

  <!-- Los niveles, como una progresión -->
  <SectionShell
    id="niveles-patrocinio"
    tone="muted"
    pattern="topo"
    width="wide"
    labelledby="niveles-titulo"
    class="scroll-mt-20"
  >
    <SectionIntro
      id="niveles-titulo"
      eyebrow="Niveles de patrocinio"
      eyebrowIcon="ph:stairs-bold"
      title="Un escalón para cada tipo de marca"
      highlight="cada tipo de marca"
      lead="De proveedor a patrocinador principal, cada nivel suma presencia sobre el anterior. Así aparece tu marca en cada uno."
      align="center"
      class="mx-auto max-w-3xl"
    />

    <SponsorshipTiers class="mt-12" />
  </SectionShell>

  <!-- El paso siguiente -->
  <SectionShell tone="dark" width="default" spacing="compact" labelledby="cta-patrocinio-titulo">
    <div class="text-center">
      <h2 id="cta-patrocinio-titulo" class="font-display text-2xl font-bold text-white sm:text-3xl">
        ¿Listo para que tu marca ruede con nosotros?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-white/80">
        Escríbenos y te enviamos el portafolio de patrocinio completo, con tarifas y disponibilidad
        por nivel.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={whatsappPatrocinio}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="whatsapp_click"
          class="bg-accent text-surface-dark hover:bg-accent-dark focus-visible:outline-accent inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 font-semibold transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <Icon name="ph:whatsapp-logo-bold" class="size-5" aria-hidden="true" />
          Escríbenos por WhatsApp
        </a>
        <a
          href={mailtoPatrocinio}
          class="hover:text-surface-dark inline-flex items-center justify-center gap-2 rounded-lg border-2 border-white px-6 py-3 font-semibold text-white transition-colors duration-200 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <Icon name="ph:envelope-bold" class="size-5" aria-hidden="true" />
          Enviar correo
        </a>
      </div>
    </div>
  </SectionShell>
</BaseLayout>
