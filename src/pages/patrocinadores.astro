---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Card from '@components/common/Card.astro';
import Button from '@components/common/Button.astro';

const sponsors: CollectionEntry<'sponsors'>[] = (await getCollection('sponsors'))
  .filter((s: CollectionEntry<'sponsors'>) => !s.data.draft && s.data.active)
  .sort((a: CollectionEntry<'sponsors'>, b: CollectionEntry<'sponsors'>) => a.data.order - b.data.order);

const levelOrder = ['principal', 'oficial', 'aliado', 'proveedor'] as const;
const levelLabels: Record<string, string> = {
  principal: 'Patrocinador Principal',
  oficial: 'Patrocinadores Oficiales',
  aliado: 'Aliados',
  proveedor: 'Proveedores',
};

const grouped = new Map<string, typeof sponsors>();
for (const s of sponsors) {
  const group = grouped.get(s.data.level) || [];
  group.push(s);
  grouped.set(s.data.level, group);
}
---

<PageLayout
  title="Patrocinadores"
  description="Empresas y organizaciones que apoyan el deporte juvenil"
  breadcrumbs={[{ label: 'Patrocinadores' }]}
>
  <div class="space-y-16">
    {levelOrder.map((level) => {
      const items = grouped.get(level);
      if (!items || items.length === 0) return null;
      const isPrincipal = level === 'principal';

      return (
        <section>
          <h2 class="text-2xl md:text-3xl font-display font-bold text-text-primary mb-6">
            {levelLabels[level]}
          </h2>

          {isPrincipal ? (
            <div class="space-y-6">
              {items.map((sponsor) => (
                <Card class="p-5 sm:p-6 md:p-8">
                  <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
                    <div class="w-24 h-24 sm:w-32 sm:h-32 md:w-40 md:h-40 bg-surface-muted rounded-xl flex items-center justify-center shrink-0">
                      <img
                        src={sponsor.data.logo}
                        alt={`Logo de ${sponsor.data.name}`}
                        class="max-w-full max-h-full object-contain p-4"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="text-center md:text-left">
                      <h3 class="text-xl font-display font-bold text-text-primary">
                        {sponsor.data.name}
                      </h3>
                      {sponsor.data.description && (
                        <p class="mt-2 text-text-secondary">{sponsor.data.description}</p>
                      )}
                      {sponsor.data.url && (
                        <a
                          href={sponsor.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mt-3 inline-flex items-center gap-1 text-primary font-semibold hover:underline"
                        >
                          Visitar sitio web &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </Card>
              ))}
            </div>
          ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
              {items.map((sponsor) => (
                <Card class="p-5">
                  <div class="flex flex-col items-center text-center">
                    <div class="w-20 h-20 bg-surface-muted rounded-lg flex items-center justify-center mb-4">
                      <img
                        src={sponsor.data.logo}
                        alt={`Logo de ${sponsor.data.name}`}
                        class="max-w-full max-h-full object-contain p-2"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <h3 class="font-display font-bold text-text-primary">{sponsor.data.name}</h3>
                    {sponsor.data.description && (
                      <p class="mt-1 text-sm text-text-secondary line-clamp-3">{sponsor.data.description}</p>
                    )}
                    {sponsor.data.url && (
                      <a
                        href={sponsor.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-2 text-sm text-primary font-semibold hover:underline"
                      >
                        Visitar sitio &rarr;
                      </a>
                    )}
                  </div>
                </Card>
              ))}
            </div>
          )}
        </section>
      );
    })}

    <!-- Seccion CTA -->
    <section class="rounded-2xl bg-surface-muted p-6 sm:p-8 md:p-12 text-center">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-text-primary">
        Quieres ser patrocinador?
      </h2>
      <p class="mt-3 text-text-secondary max-w-2xl mx-auto">
        Apoya el desarrollo deportivo de ninos y jovenes del Valle del Cauca. Tu marca se asocia con valores de disciplina, esfuerzo y vida saludable.
      </p>
      <ul class="mt-6 text-left max-w-md mx-auto space-y-2 text-sm text-text-secondary px-2 sm:px-0">
        <li class="flex items-start gap-2">
          <span class="text-primary mt-0.5 shrink-0">&#10003;</span>
          <span><strong>Principal:</strong> Logo en uniforme, eventos y web destacado</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary mt-0.5 shrink-0">&#10003;</span>
          <span><strong>Oficial:</strong> Presencia en eventos y menciones en redes</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary mt-0.5 shrink-0">&#10003;</span>
          <span><strong>Aliado:</strong> Logo en web y material promocional</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary mt-0.5 shrink-0">&#10003;</span>
          <span><strong>Proveedor:</strong> Reconocimiento como proveedor oficial</span>
        </li>
      </ul>
      <div class="mt-8">
        <Button variant="outline" href="/contacto?asunto=patrocinio">
          Contactanos
        </Button>
      </div>
    </section>
  </div>
</PageLayout>
