---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Card from '@components/common/Card.astro';
import SectionTitle from '@components/common/SectionTitle.astro';
import SponsorshipTiers from '@components/sections/SponsorshipTiers.astro';
import { CONTACT } from '@lib/constants';

const sponsors: CollectionEntry<'sponsors'>[] = (await getCollection('sponsors'))
  .filter((s: CollectionEntry<'sponsors'>) => !s.data.draft && s.data.active && !s.data.logo.includes('placeholder'))
  .sort((a: CollectionEntry<'sponsors'>, b: CollectionEntry<'sponsors'>) => a.data.order - b.data.order);

const levelOrder = ['principal', 'oficial', 'aliado', 'proveedor'] as const;
const levelLabels: Record<string, string> = {
  principal: 'Patrocinador Principal',
  oficial: 'Patrocinadores Oficiales',
  aliado: 'Aliados',
  proveedor: 'Proveedores',
};

const grouped = new Map<string, typeof sponsors>();
for (const s of sponsors) {
  const group = grouped.get(s.data.level) || [];
  group.push(s);
  grouped.set(s.data.level, group);
}

const hasSponsorContent = sponsors.length > 0;

const whatsappPatrocinio = `${CONTACT.whatsapp}?text=${encodeURIComponent('Hola, quiero información sobre patrocinio del Club Deportivo Trocha y Ruta')}`;
const mailtoPatrocinio = `mailto:${CONTACT.email}?subject=${encodeURIComponent('Consulta sobre patrocinio - Club Trocha y Ruta')}`;
---

<PageLayout
  title="Patrocinadores"
  description="Conoce las empresas que impulsan el deporte juvenil con nosotros y descubre cómo asociar tu marca con Trocha y Ruta"
  breadcrumbs={[{ label: 'Patrocinadores' }]}
>
  <!-- Hero de impacto -->
  <section class="rounded-2xl bg-gradient-to-br from-primary to-primary-dark text-white px-6 py-12 sm:px-10 sm:py-16 text-center mb-12 -mt-2">
    <p class="text-sm font-semibold uppercase tracking-widest text-white/80 mb-3">
      Club Deportivo Trocha y Ruta
    </p>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold leading-tight">
      Impulsa el deporte juvenil<br class="hidden sm:block" />
      en el Valle del Cauca
    </h2>
    <p class="mt-4 text-base sm:text-lg text-white/90 max-w-2xl mx-auto">
      Asocia tu marca con valores de disciplina, esfuerzo y vida saludable.
      Más de 16 años formando campeones en Yumbo.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={whatsappPatrocinio}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent text-white font-semibold px-6 py-3 hover:bg-accent-dark transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <!-- WhatsApp icon -->
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Escríbenos por WhatsApp
      </a>
      <a
        href="#niveles-patrocinio"
        class="inline-flex items-center justify-center rounded-lg border-2 border-white text-white font-semibold px-6 py-3 hover:bg-white hover:text-primary transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Ver niveles de patrocinio
      </a>
    </div>
  </section>

  <!-- Stats de impacto -->
  <section class="mb-16" aria-label="Impacto del club">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {[
        { value: '16+', label: 'Años de trayectoria' },
        { value: '80+', label: 'Niños entrenados' },
        { value: '50+', label: 'Competencias disputadas' },
        { value: '100+', label: 'Medallas conquistadas' },
      ].map(({ value, label }) => (
        <div class="rounded-xl border border-surface-muted bg-white p-5 sm:p-6 text-center shadow-sm">
          <p class="text-3xl sm:text-4xl font-display font-bold text-primary">{value}</p>
          <p class="mt-1 text-sm text-text-secondary leading-snug">{label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Sponsors actuales -->
  {hasSponsorContent && (
    <section class="mb-16">
      <SectionTitle
        title="Quienes ya confian en nosotros"
        subtitle="Empresas y organizaciones que hacen posible el desarrollo deportivo de nuestros ciclistas"
      />

      <div class="space-y-12">
        {levelOrder.map((level) => {
          const items = grouped.get(level);
          if (!items || items.length === 0) return null;
          const isPrincipal = level === 'principal';

          return (
            <div>
              <h3 class="text-lg font-display font-semibold text-text-secondary uppercase tracking-wide mb-5 flex items-center gap-3">
                <span class="h-px flex-1 bg-surface-muted"></span>
                <span>{levelLabels[level]}</span>
                <span class="h-px flex-1 bg-surface-muted"></span>
              </h3>

              {isPrincipal ? (
                <div class="space-y-6">
                  {items.map((sponsor) => (
                    <Card class="p-5 sm:p-6 md:p-8">
                      <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
                        <div class="w-24 h-24 sm:w-32 sm:h-32 md:w-40 md:h-40 bg-surface-muted rounded-xl flex items-center justify-center shrink-0">
                          <img
                            src={sponsor.data.logo}
                            alt={`Logo de ${sponsor.data.name}`}
                            class="max-w-full max-h-full object-contain p-4"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                        <div class="text-center md:text-left">
                          <h4 class="text-xl font-display font-bold text-text-primary">
                            {sponsor.data.name}
                          </h4>
                          {sponsor.data.description && (
                            <p class="mt-2 text-text-secondary">{sponsor.data.description}</p>
                          )}
                          {sponsor.data.url && (
                            <a
                              href={sponsor.data.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="mt-3 inline-flex items-center gap-1 text-primary font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded"
                            >
                              Visitar sitio web &rarr;
                            </a>
                          )}
                        </div>
                      </div>
                    </Card>
                  ))}
                </div>
              ) : (
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                  {items.map((sponsor) => (
                    <Card class="p-5">
                      <div class="flex flex-col items-center text-center">
                        <div class="w-20 h-20 bg-surface-muted rounded-lg flex items-center justify-center mb-4">
                          <img
                            src={sponsor.data.logo}
                            alt={`Logo de ${sponsor.data.name}`}
                            class="max-w-full max-h-full object-contain p-2"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                        <h4 class="font-display font-bold text-text-primary">{sponsor.data.name}</h4>
                        {sponsor.data.description && (
                          <p class="mt-1 text-sm text-text-secondary line-clamp-3">{sponsor.data.description}</p>
                        )}
                        {sponsor.data.url && (
                          <a
                            href={sponsor.data.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-2 text-sm text-primary font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded"
                          >
                            Visitar sitio &rarr;
                          </a>
                        )}
                      </div>
                    </Card>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- Niveles de patrocinio -->
  <section id="niveles-patrocinio" class="mb-16 scroll-mt-20">
    <SectionTitle
      title="Niveles de Patrocinio"
      subtitle="Elige el nivel que mejor se adapte a tu marca y empieza a hacer parte de nuestra comunidad"
    />
    <SponsorshipTiers />
  </section>

  <!-- CTA final -->
  <section class="rounded-2xl bg-surface-dark text-white px-6 py-12 sm:px-10 sm:py-16 text-center">
    <h2 class="text-2xl sm:text-3xl font-display font-bold">
      ¿Listo para ser parte de Trocha y Ruta?
    </h2>
    <p class="mt-4 text-white/80 max-w-xl mx-auto">
      Contáctanos hoy y te enviamos nuestro portafolio de patrocinio con todos los detalles.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={whatsappPatrocinio}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent text-white font-semibold px-6 py-3 hover:bg-accent-dark transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <!-- WhatsApp icon -->
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Escríbenos por WhatsApp
      </a>
      <a
        href={mailtoPatrocinio}
        class="inline-flex items-center justify-center rounded-lg border-2 border-white text-white font-semibold px-6 py-3 hover:bg-white hover:text-surface-dark transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Enviar correo
      </a>
    </div>
  </section>
</PageLayout>
