---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '@layouts/PageLayout.astro';
import Card from '@components/common/Card.astro';
import Button from '@components/common/Button.astro';
import SectionTitle from '@components/common/SectionTitle.astro';
import { Icon } from 'astro-icon/components';
import { CONTACT } from '@lib/constants';
import { generateBreadcrumbJsonLd, generateSocialInitiativeJsonLd } from '@lib/seo';
import { formatDate } from '@lib/utils';
import carretillaAntes from '@assets/images/trocha-verde/carretilla-reciclada.jpg';
import carretillaDespues from '@assets/images/trocha-verde/carretilla-despues.jpg';

type Tree = CollectionEntry<'trees'>;

const trees = (await getCollection('trees'))
  .filter((t: Tree) => !t.data.draft)
  .sort((a: Tree, b: Tree) => a.data.order - b.data.order);

// Pre-renderizar body markdown de cada árbol
const renderedTrees = await Promise.all(
  trees.map(async (tree: Tree) => {
    const { Content } = await render(tree);
    return { tree, Content };
  })
);

const totalTrees = trees.length;
const totalRecycled = trees.filter((t: Tree) =>
  t.data.protector === 'llanta-bicicleta' || t.data.protector === 'llanta-moto'
).length;
const uniqueSpecies = new Set(trees.map((t: Tree) => t.data.scientificName)).size;
const treesGoal = 50;
const progressPercent = Math.min(Math.round((totalTrees / treesGoal) * 100), 100);

// Agrupar árboles por fecha de siembra (jornadas)
type RenderedTree = { tree: Tree; Content: any };
const treesByDate = new Map<string, RenderedTree[]>();
renderedTrees.forEach(({ tree, Content }) => {
  const dateKey = tree.data.plantedDate.toISOString().split('T')[0];
  if (!treesByDate.has(dateKey)) {
    treesByDate.set(dateKey, []);
  }
  treesByDate.get(dateKey)!.push({ tree, Content });
});

// Ordenar jornadas cronológicamente (excluyendo temporalmente las fotos del Día de la Tierra para no saturar la galería)
const sortedDates = [...treesByDate.keys()]
  .sort()
  .filter(date => date !== '2026-04-22');
const journeyLabels: Record<number, string> = {
  0: 'Primera siembra',
  1: 'Segunda siembra',
  2: 'Tercera siembra',
  3: 'Cuarta siembra',
  4: 'Quinta siembra',
  5: 'Sexta siembra',
};

// Labels de categoría
const categoryLabels: Record<string, string> = {
  frutal: 'Frutal',
  ornamental: 'Ornamental',
  nativo: 'Nativo',
  maderable: 'Maderable',
};
const categoryColors: Record<string, { bg: string; text: string }> = {
  frutal: { bg: 'bg-amber-100', text: 'text-amber-700' },
  ornamental: { bg: 'bg-purple-100', text: 'text-purple-900' },
  nativo: { bg: 'bg-emerald-100', text: 'text-emerald-700' },
  maderable: { bg: 'bg-orange-100', text: 'text-orange-700' },
};

// Status labels
const statusLabels: Record<string, string> = {
  sembrado: 'Sembrado',
  creciendo: 'Creciendo',
  floreciendo: 'Floreciendo',
};

const breadcrumbs = [
  { label: 'Trocha Verde' },
];

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: 'Inicio', url: '/' },
  { name: 'Trocha Verde', url: '/trocha-verde' },
]);

const initiativeJsonLd = generateSocialInitiativeJsonLd({
  title: 'Trocha Verde — Programa Ambiental',
  date: new Date('2026-03-15'),
  description: `Programa de reforestación del Club Trocha y Ruta: ${totalTrees} árboles nativos sembrados con llantas de bicicleta recicladas en la Pista Carlos Castro, Yumbo, Valle del Cauca.`,
  location: 'Pista de Ciclomontañismo Carlos Castro, Yumbo, Valle del Cauca',
  image: '/images/trocha-verde/dia-tierra-2026/afiche.jpg',
  url: '/trocha-verde',
  type: 'ambiental',
});

const jsonLd = [breadcrumbJsonLd, initiativeJsonLd];

const processSteps = [
  {
    number: '01',
    title: 'Recolectamos',
    description: 'Recogemos llantas de bicicleta usadas y otros materiales que ya no se utilizan.',
    icon: 'ph:recycle-bold',
  },
  {
    number: '02',
    title: 'Pintamos',
    description: 'Los niños del club pintan las llantas con colores brillantes, dándoles nueva vida.',
    icon: 'ph:palette-bold',
  },
  {
    number: '03',
    title: 'Sembramos',
    description: 'Plantamos árboles nativos dentro de las llantas, que sirven como protectores naturales.',
    icon: 'ph:plant-bold',
  },
  {
    number: '04',
    title: 'Cuidamos',
    description: 'Cada árbol recibe un letrero artesanal pintado a mano y seguimiento constante de los niños.',
    icon: 'ph:hand-heart-bold',
  },
];
---

<PageLayout
  title="Trocha Verde"
  description={`Programa de reforestación del Club Trocha y Ruta: ${totalTrees} árboles nativos sembrados con llantas de bicicleta recicladas en Yumbo, Valle del Cauca`}
  ogImage="/images/trocha-verde/dia-tierra-2026/afiche.jpg"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <!-- Hero compacto -->
  <div class="relative -mt-8 mb-12 rounded-2xl bg-gradient-to-br from-emerald-800 via-emerald-700 to-emerald-500 px-6 py-12 text-white overflow-hidden sm:px-10 sm:py-16">
    <div class="absolute inset-0 opacity-10">
      <svg class="h-full w-full" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="50" cy="50" r="40" fill="currentColor" />
        <circle cx="350" cy="100" r="60" fill="currentColor" />
        <circle cx="150" cy="350" r="50" fill="currentColor" />
        <circle cx="300" cy="300" r="35" fill="currentColor" />
      </svg>
    </div>
    <div class="relative z-10 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-200">
        Programa Ambiental
      </p>
      <p class="mt-2 font-display text-3xl font-bold sm:text-4xl md:text-5xl">
        Donde cada pedalada deja raíces
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-emerald-100">
        En Trocha y Ruta no solo formamos ciclistas — cuidamos el terreno donde pedalean.
        Llantas recicladas se convierten en protectores de árboles nativos, pintadas por las manos de nuestros niños.
      </p>

      <!-- Contadores -->
      <div class="mt-8 flex flex-wrap justify-center gap-8">
        <div class="text-center">
          <p class="font-display text-4xl font-bold">{totalTrees}</p>
          <p class="mt-1 text-sm text-emerald-200">Árboles sembrados</p>
        </div>
        <div class="text-center">
          <p class="font-display text-4xl font-bold">{totalRecycled}</p>
          <p class="mt-1 text-sm text-emerald-200">Llantas recicladas</p>
        </div>
        <div class="text-center">
          <p class="font-display text-4xl font-bold">{uniqueSpecies}</p>
          <p class="mt-1 text-sm text-emerald-200">Especies distintas</p>
        </div>
      </div>

      <!-- Barra de progreso hacia meta -->
      <div class="mx-auto mt-8 max-w-md">
        <div class="flex items-center justify-between text-sm text-emerald-200">
          <span>Meta 2026</span>
          <span class="font-semibold text-white">{totalTrees} / {treesGoal} árboles</span>
        </div>
        <div class="mt-2 h-3 w-full overflow-hidden rounded-full bg-emerald-900/50" role="progressbar" aria-valuenow={totalTrees} aria-valuemin={0} aria-valuemax={treesGoal} aria-label={`Progreso: ${totalTrees} de ${treesGoal} árboles sembrados`} aria-valuetext={`${totalTrees} árboles de ${treesGoal}`}>
          <div
            class="h-full rounded-full bg-gradient-to-r from-emerald-300 to-accent transition-all duration-500"
            style={`width: ${progressPercent}%`}
          />
        </div>
        <p class="mt-1 text-xs text-emerald-300">{progressPercent}% completado</p>
      </div>
    </div>
  </div>

  <!-- Misión -->
  <section class="mb-16 text-center">
    <div class="mx-auto max-w-3xl">
      <p class="text-lg leading-relaxed text-text-secondary sm:text-xl">
        Nuestros corredores entrenan en senderos naturales. <strong class="text-text-primary">Cuidar esos senderos es cuidar nuestro deporte.</strong>
        Pero más allá del ciclismo, queremos que cada niño del club crezca con una conciencia ambiental fuerte.
        Cada objeto reciclado cuenta una historia de transformación.
      </p>
    </div>
  </section>

  <!-- Timeline de Siembras -->
  <section class="mb-16">
    <SectionTitle
      title="Nuestros Árboles"
      subtitle="Cada árbol fue plantado por las manos de nuestros niños y protegido con materiales reciclados"
    />

    <div class="space-y-12">
      {sortedDates.map((dateKey, index) => {
        const journeyEntries = treesByDate.get(dateKey)!;
        const date = journeyEntries[0].tree.data.plantedDate;
        const label = journeyLabels[index] || `Siembra #${index + 1}`;

        return (
          <div class="relative">
            {/* Encabezado de jornada */}
            <div class="mb-6 flex items-center gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white" aria-hidden="true">
                <Icon name="ph:tree-bold" class="h-6 w-6" />
              </div>
              <div>
                <h3 class="font-display text-xl font-bold text-text-primary">
                  {label}
                </h3>
                <p class="text-sm text-text-secondary">
                  {formatDate(date)} — {journeyEntries.length} {journeyEntries.length === 1 ? 'árbol' : 'árboles'}
                </p>
              </div>
            </div>

            {/* Grid de árboles de esta jornada */}
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {journeyEntries.map(({ tree, Content }: RenderedTree) => {
                const catColors = categoryColors[tree.data.category] || categoryColors.nativo;
                return (
                  <Card class="overflow-hidden border border-emerald-100">
                    <div class="aspect-[4/3] overflow-hidden bg-surface-muted">
                      <img
                        src={tree.data.image}
                        alt={tree.data.imageAlt}
                        class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                        loading="lazy"
                        width="400"
                        height="300"
                      />
                    </div>
                    <div class="p-5">
                      <div class="mb-2 flex flex-wrap items-center gap-2">
                        <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">
                          {statusLabels[tree.data.status] || tree.data.status}
                        </span>
                        <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${catColors.bg} ${catColors.text}`}>
                          {categoryLabels[tree.data.category] || tree.data.category}
                        </span>
                        {tree.data.protectorColor && (
                          <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-900">
                            Llanta {tree.data.protectorColor}
                          </span>
                        )}
                      </div>
                      <h4 class="font-display text-lg font-bold text-text-primary">
                        {tree.data.species}
                      </h4>
                      {tree.data.scientificName && (
                        <p class="text-sm italic text-text-secondary">{tree.data.scientificName}</p>
                      )}
                      {tree.data.notes && (
                        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
                          {tree.data.notes}
                        </p>
                      )}
                      <details class="mt-3 group">
                        <summary class="cursor-pointer rounded text-xs font-medium text-emerald-600 hover:text-emerald-700 focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 focus-visible:underline">
                          Conoce su historia
                        </summary>
                        <div class="mt-2 text-sm leading-relaxed text-text-secondary prose prose-sm max-w-none">
                          <Content />
                        </div>
                      </details>
                    </div>
                  </Card>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- El Proceso -->
  <section class="mb-16">
    <SectionTitle
      title="El Proceso"
      subtitle="Así transformamos residuos en vida"
    />

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {processSteps.map((step) => (
        <div class="relative rounded-xl border border-emerald-100 bg-white p-6 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-700" role="img" aria-label={`Paso ${step.number}: ${step.title}`}>
            <Icon name={step.icon} class="h-7 w-7" aria-hidden="true" />
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-500">
            Paso {step.number}
          </span>
          <h3 class="mt-1 font-display text-lg font-bold text-text-primary">
            {step.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Antes y Después -->
  <section class="mb-16">
    <SectionTitle
      title="Transformación en acción"
      subtitle="Una carretilla reciclada que pasó de estar abandonada a ser herramienta clave de nuestras siembras"
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <!-- Antes -->
      <figure class="overflow-hidden rounded-xl border border-emerald-100 bg-white">
        <div class="aspect-[3/4] overflow-hidden">
          <Image
            src={carretillaAntes}
            alt="Carretilla reciclada antes de ser utilizada en las siembras de Trocha Verde"
            class="h-full w-full object-cover"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </div>
        <figcaption class="p-4 text-center">
          <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800">
            Antes
          </span>
          <p class="mt-2 text-sm text-text-secondary">
            Carretilla recuperada y lista para darle un nuevo propósito
          </p>
        </figcaption>
      </figure>

      <!-- Después -->
      <figure class="overflow-hidden rounded-xl border border-emerald-100 bg-white">
        <div class="aspect-[3/4] overflow-hidden">
          <Image
            src={carretillaDespues}
            alt="Carretilla en uso transportando tierra para la siembra de árboles nativos"
            class="h-full w-full object-cover"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </div>
        <figcaption class="p-4 text-center">
          <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-sm font-semibold text-emerald-800">
            Después
          </span>
          <p class="mt-2 text-sm text-text-secondary">
            En plena jornada de siembra, transportando tierra para nuestros árboles
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- CTA -->
  <section class="rounded-2xl bg-gradient-to-r from-emerald-50 to-emerald-100 px-6 py-12 text-center sm:px-10">
    <h2 class="font-display text-2xl font-bold text-text-primary sm:text-3xl">
      ¿Quieres sembrar con nosotros?
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-text-secondary">
      Únete a nuestras jornadas de siembra. Familias, empresas y amigos del medio ambiente son bienvenidos.
      Juntos hacemos de Yumbo un lugar más verde.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <Button href={CONTACT.whatsapp} variant="accent" size="lg">
        Escríbenos por WhatsApp
      </Button>
      <Button href="/contacto" variant="outline">
        Contáctanos
      </Button>
    </div>
  </section>
</PageLayout>
